// abs of a non-null operand declared decimal?: it is nullable exactly when its operand is
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "abs",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
