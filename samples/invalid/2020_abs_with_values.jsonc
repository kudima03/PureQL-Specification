// abs with a values array: it takes one operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "abs",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
