// min over all rows in a grouped query, unfiltered and over a non-null selector, declared nullable: a group exists only
// if a row does, so it is non-null
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "smallest",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal", "nullable": true },
        "over": "all",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
