// removeDiacritics of an aggregate as a groupBy key, a row expression
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "removeDiacritics",
        "type": { "name": "string" },
        "operand": {
          "operator": "min",
          "type": { "name": "string" },
          "selector": { "source": "users", "field": "country", "type": { "name": "string" } }
        }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
