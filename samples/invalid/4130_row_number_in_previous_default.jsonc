// rowNumber in the default of previous: the default is a row expression, so window functions do not nest
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "previous",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "integer" }, "value": 0 },
        "default": {
          "operator": "rowNumber",
          "type": { "name": "integer" },
          "over": {
            "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
            "orderBy": [
              { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
              { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
            ]
          }
        },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    }
  ]
}
