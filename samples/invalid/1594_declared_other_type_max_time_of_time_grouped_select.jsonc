// max declared time over a time selector declares another type than time in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "string" },
        "selector": { "type": { "name": "time" }, "value": "08:30:00" }
      }
    }
  ]
}
