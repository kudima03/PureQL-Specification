// Aggregate as the operand of an in inside join.on
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "operator": "count", "type": { "name": "integer" }, "over": "all" },
        "list": { "param": "sizes", "type": { "name": "integerList" } }
      }
    }
  ]
}
