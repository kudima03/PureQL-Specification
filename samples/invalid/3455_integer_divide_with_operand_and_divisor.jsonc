// integerDivide with operand and divisor
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "integer" }, "value": 7 },
        "divisor": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
