// A range over a date in seconds: a date has no time of day
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "order_date", "type": { "name": "date" } } }
          ],
          "range": { "preceding": { "seconds": 3600 } }
        }
      }
    }
  ]
}
