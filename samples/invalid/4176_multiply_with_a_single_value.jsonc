// multiply with a single value
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "value",
      "expression": {
        "operator": "multiply",
        "type": { "name": "decimal" },
        "values": [{ "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }]
      }
    }
  ]
}
