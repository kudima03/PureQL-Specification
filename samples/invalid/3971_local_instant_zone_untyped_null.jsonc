// asDatetime with an untyped null as its zone
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "zone": { "value": null }
      }
    }
  ]
}
