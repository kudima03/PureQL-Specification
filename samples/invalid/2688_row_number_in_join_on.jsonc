// rowNumber in the on of a join
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "rowNumber",
          "type": { "name": "integer" },
          "over": {
            "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
            "orderBy": [
              { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
              { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
            ]
          }
        },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ],
  "select": [
    { "alias": "c", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
