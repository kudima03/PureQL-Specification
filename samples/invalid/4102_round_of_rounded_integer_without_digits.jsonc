// round without digits of an integer rounded to tens: it is an integer already, and round without digits
// takes a decimal
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": {
          "operator": "round",
          "type": { "name": "integer" },
          "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          "digits": { "type": { "name": "integer" }, "value": -1 }
        }
      }
    }
  ]
}
