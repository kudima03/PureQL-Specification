// round with a nullable digits declared decimal: it is lifted over digits as over operand, so the result is
// decimal?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "param": "digits", "type": { "name": "integer", "nullable": true } }
      }
    }
  ]
}
