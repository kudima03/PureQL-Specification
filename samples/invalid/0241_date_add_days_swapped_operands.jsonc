// dateAddDays with the days as operand and the date as days
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "operand": { "type": { "name": "integer" }, "value": 1 },
        "days": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
