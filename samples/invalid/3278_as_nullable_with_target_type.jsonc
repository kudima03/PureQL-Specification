// asNullable with a target type: the declared type is the result
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNullable",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } },
        "to": { "name": "uuid", "nullable": true }
      }
    }
  ]
}
