// A subquery with having but no groupBy
{
  "subqueries": [
    {
      "name": "recent",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "id",
            "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
          }
        ],
        "having": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ],
  "from": { "subquery": "recent" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "recent", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
