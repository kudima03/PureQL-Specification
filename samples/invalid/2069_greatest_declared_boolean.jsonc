// greatest of decimals declared boolean: it yields one of its operands, not a comparison
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greatest",
        "type": { "name": "boolean" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
          { "type": { "name": "integer" }, "value": 0 }
        ]
      }
    }
  ]
}
