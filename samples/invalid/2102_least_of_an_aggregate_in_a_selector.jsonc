// least of an aggregate inside an aggregate's selector: aggregates cannot nest
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "least",
          "type": { "name": "decimal" },
          "values": [
            {
              "operator": "max",
              "type": { "name": "decimal" },
              "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
            },
            { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } }
          ]
        }
      }
    }
  ]
}
