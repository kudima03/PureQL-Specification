// countDistinct with an approximate flag: every result of the language is exact
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "approximate": true
      }
    }
  ]
}
