// countDistinct with a predicate that is not a boolean
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "predicate": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
