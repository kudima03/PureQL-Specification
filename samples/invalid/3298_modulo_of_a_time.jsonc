// modulo of a time
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "decimal" },
        "left": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "right": { "type": { "name": "integer" }, "value": 60 }
      }
    }
  ]
}
