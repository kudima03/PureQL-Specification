// nullIfEqual of a time and a datetime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "time", "nullable": true },
        "left": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    }
  ]
}
