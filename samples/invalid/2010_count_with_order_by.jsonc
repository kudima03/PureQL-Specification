// count with orderBy: the number of rows does not depend on their order
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "orderBy": [
          { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    }
  ]
}
