// dateAddMonths with right instead of months
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "type": { "name": "integer" }, "value": 3 }
      }
    }
  ]
}
