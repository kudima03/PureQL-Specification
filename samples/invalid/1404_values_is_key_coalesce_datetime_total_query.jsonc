// coalesce declared datetime has values as a group key reference, which only a grouped select, having and orderBy have,
// in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "datetime" },
        "values": [
          { "key": "k", "type": { "name": "datetime", "nullable": true } },
          { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" }
        ]
      }
    }
  ]
}
