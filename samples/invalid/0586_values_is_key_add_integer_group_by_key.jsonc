// add declared integer has values as a group key reference, which only a grouped select, having and orderBy have, in a
// groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [
          { "key": "k", "type": { "name": "integer" } },
          { "type": { "name": "integer" }, "value": -3 }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
