// timeAddSeconds declared time? has left as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "time", "nullable": true },
        "left": { "source": "orders", "field": "f", "type": { "name": "time" } },
        "right": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
