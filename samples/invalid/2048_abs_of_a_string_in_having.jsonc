// abs of a string parameter in having
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "product_id",
      "expression": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "abs",
      "type": { "name": "decimal" },
      "operand": { "param": "list_price", "type": { "name": "string" } }
    },
    "right": { "type": { "name": "decimal" }, "value": "0.5" }
  },
  "select": [ { "alias": "product_id", "expression": { "key": "product_id", "type": { "name": "uuid" } } } ]
}
