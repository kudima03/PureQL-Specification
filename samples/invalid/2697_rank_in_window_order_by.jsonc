// rank as a sort key of a window
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "rowNumber",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            {
              "expression": {
                "operator": "rank",
                "type": { "name": "integer" },
                "over": {
                  "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
                  "orderBy": [
                    {
                      "expression": {
                        "source": "orders",
                        "field": "ordered_at",
                        "type": { "name": "datetime" }
                      }
                    },
                    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
                  ]
                }
              }
            },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    }
  ]
}
