// repeat of a field in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "users" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "repeat",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "count": { "operator": "count", "type": { "name": "integer" } }
      }
    }
  ]
}
