// dateDiffMonths with a nullable operand, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "type": { "name": "date", "nullable": true }, "value": null }
      }
    }
  ]
}
