// ceiling of an integer sum: an integer is a whole number already
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "ceiling",
        "type": { "name": "integer" },
        "operand": {
          "operator": "add",
          "type": { "name": "integer" },
          "values": [
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            { "source": "order_items", "field": "returned_quantity", "type": { "name": "integer" } }
          ]
        }
      }
    }
  ]
}
