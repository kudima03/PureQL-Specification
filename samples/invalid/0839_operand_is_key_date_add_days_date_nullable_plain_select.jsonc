// dateAddDays declared date? has its operand as a group key reference, which only a grouped select, having
// and orderBy have, in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date", "nullable": true },
        "operand": { "key": "k", "type": { "name": "date", "nullable": true } },
        "days": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
