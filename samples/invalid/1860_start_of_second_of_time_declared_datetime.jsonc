// startOfSecond of a time, declared datetime: the result has the type of the operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "startOfSecond",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
      }
    }
  ]
}
