// An empty timeList literal: a list literal has at least one value; a set that may be empty is a list
// parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "time" }, "value": "08:30:00" },
        "list": { "type": { "name": "timeList" }, "value": [] }
      }
    }
  ]
}
