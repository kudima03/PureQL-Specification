// in with a bare array as its list: a list literal carries its type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "list": [ "paid", "new" ]
      }
    }
  ]
}
