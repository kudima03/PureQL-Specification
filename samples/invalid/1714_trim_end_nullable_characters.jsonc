// trimEnd with nullable characters: characters is never null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimEnd",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "characters": {
          "source": "users",
          "field": "nickname",
          "type": { "name": "string", "nullable": true }
        }
      }
    }
  ]
}
