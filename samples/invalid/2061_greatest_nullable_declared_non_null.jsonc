// greatest with a nullable operand declared date: it is lifted, null when any operand is null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greatest",
        "type": { "name": "date" },
        "values": [
          { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } }
        ]
      }
    }
  ]
}
