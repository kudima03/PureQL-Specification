// nullIf of a field in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIf",
        "type": { "name": "integer", "nullable": true },
        "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "right": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
