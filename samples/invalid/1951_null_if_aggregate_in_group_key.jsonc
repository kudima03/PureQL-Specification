// nullIf of an aggregate as a groupBy key, a row expression
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": {
        "operator": "nullIf",
        "type": { "name": "integer", "nullable": true },
        "left": { "operator": "count", "type": { "name": "integer" } },
        "right": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
