// startOfDay with its zone as a bare string: a zone is an expression and declares its type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "startOfDay",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": "Europe/Moscow"
      }
    }
  ]
}
