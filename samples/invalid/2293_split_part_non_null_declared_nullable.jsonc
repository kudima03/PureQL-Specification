// splitPart of a non-null operand declared string?: a part that does not exist is the empty string, not null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "splitPart",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "delimiter": { "type": { "name": "string" }, "value": " " },
        "index": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
