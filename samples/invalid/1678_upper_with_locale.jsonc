// upper with a locale: the case conversion has none, and no other property is allowed
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "upper",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } },
        "locale": "tr"
      }
    }
  ]
}
