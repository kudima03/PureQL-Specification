// greaterThan of a date and a datetime: a date is converted with asDatetime: both operands of a comparison are
// one family, as in equal, though every type is ordered
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
