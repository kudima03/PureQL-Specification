// greatest with a subquery column among its values: a column of a subquery is a list, accepted only by in;
// its largest value is max in that subquery
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greatest",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
          { "subquery": "limits", "field": "amount", "type": { "name": "decimal" } }
        ]
      }
    }
  ]
}
