// position of an integer pattern
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "position",
        "type": { "name": "integer" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
