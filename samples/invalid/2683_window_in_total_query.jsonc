// A window on an aggregate of a total query, which has one row and no over
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": { "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ] }
      }
    }
  ]
}
