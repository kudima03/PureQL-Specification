// timeFromParts with a nullable hour declared non-null: it is lifted over every part
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeFromParts",
        "type": { "name": "time" },
        "hour": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } },
        "minute": { "type": { "name": "integer" }, "value": 0 },
        "second": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
