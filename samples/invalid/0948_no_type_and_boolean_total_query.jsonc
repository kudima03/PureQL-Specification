// and declared boolean has no declared type in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "and",
        "conditions": [
          { "type": { "name": "boolean" }, "value": true },
          { "type": { "name": "boolean" }, "value": false }
        ]
      }
    }
  ]
}
