// least with a nullable operand declared date
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "least",
        "type": { "name": "date" },
        "values": [
          { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } }
        ]
      }
    }
  ]
}
