// dateDiffMonths with a zone as an aggregate selector in a total query: a date is a calendar day already and
// has no zone; the zone belongs to asDate or to datetimeAddMonths / datetimeDiffMonths
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "integer", "nullable": true },
        "selector": {
          "operator": "dateDiffMonths",
          "type": { "name": "integer" },
          "left": { "param": "today", "type": { "name": "date" } },
          "right": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
        }
      }
    }
  ]
}
