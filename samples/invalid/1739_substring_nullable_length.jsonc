// substring with a nullable length declared string: it is lifted over length as over operand, so the result
// is string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "substring",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "start": { "type": { "name": "integer" }, "value": 2 },
        "length": {
          "source": "users",
          "field": "referral_count",
          "type": { "name": "integer", "nullable": true }
        }
      }
    }
  ]
}
