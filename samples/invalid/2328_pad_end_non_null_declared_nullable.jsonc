// padEnd of a non-null operand declared string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "padEnd",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "length": { "type": { "name": "integer" }, "value": 10 },
        "fill": { "type": { "name": "string" }, "value": " " }
      }
    }
  ]
}
