// a grouped query as the main query: with pagination but no orderBy
{
  "from": { "entity": "orders" },
  "groupBy": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "select": [ { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid" } } } ],
  "pagination": { "skip": 0, "take": 1 }
}
