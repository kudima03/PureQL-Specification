// in over a list parameter declared nullable (lists have no nullable form)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
    "list": { "param": "statuses", "type": { "name": "stringList", "nullable": true } }
  }
}
