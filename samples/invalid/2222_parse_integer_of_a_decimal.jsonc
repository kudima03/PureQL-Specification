// parseInteger of a decimal: a decimal becomes an integer with round, floor, ceiling or truncate
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "parseInteger",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
