// parseBoolean of an integer: a number becomes a condition with a comparison
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "parseBoolean",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
