// dateAddDays with months instead of days: the amount is named by the unit the operator adds
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "months": { "type": { "name": "integer" }, "value": 3 }
      }
    }
  ]
}
