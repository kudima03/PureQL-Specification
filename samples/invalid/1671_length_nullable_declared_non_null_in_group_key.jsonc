// length of a nullable operand declared non-null in a groupBy key
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "length",
        "type": { "name": "integer" },
        "operand": { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
