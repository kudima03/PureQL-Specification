// remainder is not an operator: it is modulo, for integers and decimals
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "remainder",
        "type": { "name": "decimal" },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
