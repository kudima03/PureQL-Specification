// coalesce declared uuid has values as a group key reference, which only a grouped select, having and orderBy have, in a
// plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "uuid" },
        "values": [
          { "key": "k", "type": { "name": "uuid", "nullable": true } },
          { "type": { "name": "uuid" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" }
        ]
      }
    }
  ]
}
