// min declared datetime? over a datetime selector with a predicate declares the opposite nullability of datetime? in a
// plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "min",
        "type": { "name": "datetime" },
        "selector": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" },
        "predicate": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
