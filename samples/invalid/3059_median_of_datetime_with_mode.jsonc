// median of a datetime with a mode
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "median",
        "type": { "name": "datetime" },
        "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "mode": "halfEven"
      }
    }
  ]
}
