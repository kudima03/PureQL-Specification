// in declared boolean has operand as a group key reference, which only a grouped select, having and orderBy have, in a
// plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "key": "k", "type": { "name": "boolean" } },
        "list": { "type": { "name": "booleanList" }, "value": [ true, false ] }
      }
    }
  ]
}
