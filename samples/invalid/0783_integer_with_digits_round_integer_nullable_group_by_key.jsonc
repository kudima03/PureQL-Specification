// round declared integer? declares integer although digits is given in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "round",
        "type": { "name": "integer", "nullable": true },
        "operand": { "type": { "name": "decimal", "nullable": true }, "value": null },
        "digits": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
