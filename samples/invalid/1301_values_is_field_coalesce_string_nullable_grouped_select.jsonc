// coalesce declared string? has values as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "string", "nullable": true },
        "values": [
          { "source": "orders", "field": "f", "type": { "name": "string", "nullable": true } },
          { "type": { "name": "string", "nullable": true }, "value": null }
        ]
      }
    }
  ]
}
