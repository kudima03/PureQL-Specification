// concat declared string has no declared type in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "concat",
        "values": [
          { "type": { "name": "string" }, "value": "a" },
          { "type": { "name": "string" }, "value": "b" }
        ]
      }
    }
  ]
}
