// floor of an integer rounded to hundreds: it is an integer already
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer" },
        "operand": {
          "operator": "round",
          "type": { "name": "integer" },
          "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          "digits": { "type": { "name": "integer" }, "value": -2 }
        }
      }
    }
  ]
}
