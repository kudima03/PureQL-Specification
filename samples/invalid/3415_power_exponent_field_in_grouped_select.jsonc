// power whose exponent is a field in a grouped select, which reads only group keys and aggregates
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "country",
      "expression": { "source": "users", "field": "country", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "power",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "operator": "count", "type": { "name": "integer" } },
        "exponent": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } }
      }
    }
  ]
}
