// timeFromParts without a second: a whole minute is second 0, written out
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeFromParts",
        "type": { "name": "time" },
        "hour": { "type": { "name": "integer" }, "value": 18 },
        "minute": { "type": { "name": "integer" }, "value": 30 }
      }
    }
  ]
}
