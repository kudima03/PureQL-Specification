// equal of a string and a uuid: the string goes through asUuid or tryAsUuid
{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "kind": "inner",
      "entity": "products",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } },
        "right": { "source": "products", "field": "sku", "type": { "name": "string" } }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
  ]
}
