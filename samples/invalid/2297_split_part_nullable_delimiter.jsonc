// splitPart with a nullable delimiter declared string: it is lifted over delimiter as over operand, so the
// result is string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "splitPart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "delimiter": { "type": { "name": "string", "nullable": true }, "value": null },
        "index": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
