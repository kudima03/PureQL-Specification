// asInteger with a radix: the text is a decimal integer, as a literal is
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asInteger",
        "type": { "name": "integer" },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } },
        "radix": { "type": { "name": "integer" }, "value": 16 }
      }
    }
  ]
}
