// removeDiacritics with an ascii flag: letters that are not a base with a mark are kept
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "removeDiacritics",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "ascii": true
      }
    }
  ]
}
