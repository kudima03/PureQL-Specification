// round declared integer declares another type than integer in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "round",
        "type": { "name": "string" },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
