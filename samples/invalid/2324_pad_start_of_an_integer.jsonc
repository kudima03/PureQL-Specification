// padStart of an integer: a number is written as text with asString first
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "padStart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } },
        "length": { "type": { "name": "integer" }, "value": 10 },
        "fill": { "type": { "name": "string" }, "value": " " }
      }
    }
  ]
}
