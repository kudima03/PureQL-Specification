// lessThanOrEqual declared boolean has no left in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "lessThanOrEqual",
        "type": { "name": "boolean" },
        "right": { "type": { "name": "time" }, "value": "17:45:30.5" }
      }
    }
  ]
}
