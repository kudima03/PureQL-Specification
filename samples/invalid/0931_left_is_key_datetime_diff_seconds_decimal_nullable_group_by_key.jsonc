// datetimeDiffSeconds declared decimal? has left as a group key reference, which only a grouped select, having and
// orderBy have, in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "datetimeDiffSeconds",
        "type": { "name": "decimal", "nullable": true },
        "left": { "key": "k", "type": { "name": "datetime", "nullable": true } },
        "right": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
