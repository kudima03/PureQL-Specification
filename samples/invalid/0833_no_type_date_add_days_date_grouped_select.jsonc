// dateAddDays declared date has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddDays",
        "left": { "type": { "name": "date" }, "value": "2024-01-31" },
        "right": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
