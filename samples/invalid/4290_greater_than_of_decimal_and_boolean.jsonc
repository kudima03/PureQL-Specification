// greaterThan of a decimal and a boolean: both operands of a comparison are one family, as in equal, though
// every type is ordered
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
    "right": { "type": { "name": "boolean" }, "value": true }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
