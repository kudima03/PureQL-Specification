// tryAsBoolean as where: it is boolean?, and a condition is a non-null boolean
{
  "from": { "entity": "users" },
  "where": {
    "operator": "tryAsBoolean",
    "type": { "name": "boolean", "nullable": true },
    "operand": { "source": "users", "field": "status", "type": { "name": "string" } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
