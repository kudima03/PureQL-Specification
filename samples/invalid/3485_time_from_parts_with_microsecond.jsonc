// timeFromParts with a microsecond: the fraction is part of second
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeFromParts",
        "type": { "name": "time" },
        "hour": { "type": { "name": "integer" }, "value": 18 },
        "minute": { "type": { "name": "integer" }, "value": 30 },
        "second": { "type": { "name": "integer" }, "value": 0 },
        "microsecond": { "type": { "name": "integer" }, "value": 250000 }
      }
    }
  ]
}
