// median of a datetime with a tie-break: a value halfway between two is always the later one
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "median",
        "type": { "name": "datetime" },
        "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "tieBreak": "earlier"
      }
    }
  ]
}
