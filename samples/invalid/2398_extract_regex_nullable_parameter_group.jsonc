// extractRegex with a nullable parameter as group
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "extractRegex",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "@(.+)$" },
        "group": { "param": "group", "type": { "name": "integer", "nullable": true } }
      }
    }
  ]
}
