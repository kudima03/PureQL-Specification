// if declared datetime declares the opposite nullability of datetime in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "if",
        "type": { "name": "datetime", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" },
        "else": { "type": { "name": "datetime" }, "value": "2024-03-01T17:45:30.5Z" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
