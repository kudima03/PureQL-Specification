// if declared datetime? has then as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "datetime", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "source": "orders", "field": "f", "type": { "name": "datetime", "nullable": true } },
        "else": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" }
      }
    }
  ]
}
