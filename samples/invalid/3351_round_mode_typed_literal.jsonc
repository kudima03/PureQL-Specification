// round whose mode is a string literal: a mode is a name, like the form of normalize
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": 2 },
        "mode": { "type": { "name": "string" }, "value": "halfEven" }
      }
    }
  ]
}
