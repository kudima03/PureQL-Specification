// removeDiacritics of a non-null operand declared string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "removeDiacritics",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } }
      }
    }
  ]
}
