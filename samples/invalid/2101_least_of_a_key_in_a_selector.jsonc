// least of a group key inside an aggregate's selector, a row expression
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "least",
          "type": { "name": "decimal" },
          "values": [
            { "key": "total", "type": { "name": "decimal" } },
            { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } }
          ]
        }
      }
    }
  ]
}
