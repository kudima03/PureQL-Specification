// round declared integer? declares integer although digits is given in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer", "nullable": true },
        "operand": { "type": { "name": "decimal", "nullable": true }, "value": null },
        "digits": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
