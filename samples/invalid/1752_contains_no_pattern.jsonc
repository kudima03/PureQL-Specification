// contains without its pattern
{
  "from": { "entity": "users" },
  "where": {
    "operator": "contains",
    "type": { "name": "boolean" },
    "operand": { "source": "users", "field": "name", "type": { "name": "string" } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
