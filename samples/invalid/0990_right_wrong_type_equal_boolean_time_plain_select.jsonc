// equal declared boolean has right of a type that does not fit in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "date" }, "value": "2024-01-31" }
      }
    }
  ]
}
