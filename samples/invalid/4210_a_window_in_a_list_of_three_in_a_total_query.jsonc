// a window in a list of three in a total query
{
  "from": { "entity": "order_items" },
  "aggregate": [
    {
      "alias": "value",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [
          { "operator": "count", "type": { "name": "integer" } },
          {
            "operator": "sum",
            "type": { "name": "integer" },
            "selector": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            "over": {
              "orderBy": [
                { "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
              ],
              "frame": { "preceding": "all" }
            }
          },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
