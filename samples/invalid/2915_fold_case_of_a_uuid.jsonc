// foldCase of a uuid: a uuid has one spelling, in lower case
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "foldCase",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
