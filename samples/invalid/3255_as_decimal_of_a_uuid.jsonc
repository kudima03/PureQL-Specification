// asDecimal of a uuid
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDecimal",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
