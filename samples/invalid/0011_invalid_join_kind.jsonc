// join kind cross
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "joins": [{ "kind": "cross", "entity": "users", "on": { "type": { "name": "boolean" }, "value": true } }]
}
