// coalesce declared uuid? has values as a group key reference, which only a grouped select, having and orderBy have, in
// a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "uuid", "nullable": true },
        "values": [
          { "key": "k", "type": { "name": "uuid", "nullable": true } },
          { "type": { "name": "uuid", "nullable": true }, "value": null }
        ]
      }
    }
  ]
}
