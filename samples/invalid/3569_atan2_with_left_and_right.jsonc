// atan2 with left and right: its operands are y and x, in that order
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "atan2",
        "type": { "name": "decimal" },
        "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
