// timeAddSeconds declared time declares another type than time in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "string" },
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
