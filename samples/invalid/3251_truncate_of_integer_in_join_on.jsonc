// truncate of an integer in join.on
{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "kind": "inner",
      "entity": "products",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } },
            "right": { "source": "products", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "greaterThan",
            "type": { "name": "boolean" },
            "left": {
              "operator": "truncate",
              "type": { "name": "integer" },
              "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
            },
            "right": { "type": { "name": "integer" }, "value": 0 }
          }
        ]
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
  ]
}
