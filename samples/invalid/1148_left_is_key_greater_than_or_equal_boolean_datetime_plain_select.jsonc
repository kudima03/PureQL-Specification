// greaterThanOrEqual declared boolean has left as a group key reference, which only a grouped select, having and orderBy
// have, in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "datetime" } },
        "right": { "type": { "name": "datetime" }, "value": "2024-03-01T17:45:30.5Z" }
      }
    }
  ]
}
