// a combined query written as { operation, queries }: the operation is the name of the property that holds
// the inputs
{
  "operation": "unionAll",
  "queries": [
    {
      "from": { "entity": "orders" },
      "select": [
        {
          "alias": "id",
          "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
        }
      ]
    },
    {
      "from": { "entity": "users" },
      "select": [
        { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
      ]
    }
  ]
}
