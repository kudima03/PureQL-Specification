// extractRegex with an ignoreCase flag
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "extractRegex",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[a-z]+" },
        "ignoreCase": true
      }
    }
  ]
}
