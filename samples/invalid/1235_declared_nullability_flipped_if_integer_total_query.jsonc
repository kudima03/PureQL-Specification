// if declared integer declares the opposite nullability of integer in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "integer", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "integer" }, "value": 7 },
        "else": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ]
}
