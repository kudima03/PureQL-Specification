// sqrt of a field in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "sqrt",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
