// timeDiffSeconds declared decimal declares the opposite nullability of decimal in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeDiffSeconds",
        "type": { "name": "decimal", "nullable": true },
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "time" }, "value": "17:45:30.5" }
      }
    }
  ]
}
