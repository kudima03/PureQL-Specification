// A page with "skip": 0 and a take parameter: no rows skipped is the absence of skip
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "orderBy": [ { "column": "id" } ],
  "pagination": { "skip": 0, "take": { "param": "size", "type": { "name": "integer" } } }
}
