// asDate of a field in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date", "nullable": true },
        "operand": {
          "source": "orders",
          "field": "ordered_at",
          "type": { "name": "datetime", "nullable": true }
        }
      }
    }
  ]
}
