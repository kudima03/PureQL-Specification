// subtract declared integer has no declared type in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "subtract",
        "values": [
          { "type": { "name": "integer" }, "value": 7 },
          { "type": { "name": "integer" }, "value": -3 }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
