// lessThanOrEqual over a list parameter: a list is a value only for in
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "lessThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "param": "ids", "type": { "name": "uuidList" } },
    "right": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
  }
}
