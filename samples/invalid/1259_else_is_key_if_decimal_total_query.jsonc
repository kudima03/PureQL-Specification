// if declared decimal has else as a group key reference, which only a grouped select, having and orderBy have, in a
// total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "decimal" },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "decimal" }, "value": "2.5" },
        "else": { "key": "k", "type": { "name": "decimal" } }
      }
    }
  ]
}
