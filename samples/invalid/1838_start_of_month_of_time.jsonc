// startOfMonth of a time: a time has no calendar period
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "startOfMonth",
        "type": { "name": "time" },
        "operand": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
      }
    }
  ]
}
