// nullIfEqual of a field in a grouped select, which reads only group keys and aggregates
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "string", "nullable": true },
        "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "right": { "type": { "name": "string" }, "value": "unknown" }
      }
    }
  ]
}
