// countDistinct with a predicate declared integer?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer", "nullable": true },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    }
  ]
}
