// nullIfEqual of a uuid and a string holding a uuid: a uuid literal declares the uuid type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "uuid", "nullable": true },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "type": { "name": "string" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" }
      }
    }
  ]
}
