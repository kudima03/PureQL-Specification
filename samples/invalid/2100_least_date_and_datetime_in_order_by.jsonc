// least of a datetime and a date in orderBy
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "least",
        "type": { "name": "datetime" },
        "values": [
          { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        ]
      }
    },
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
