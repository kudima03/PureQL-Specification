// concatWith with orderBy: its operands are joined in the order they are written
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "concatWith",
        "type": { "name": "string" },
        "values": [
          { "source": "users", "field": "first_name", "type": { "name": "string" } },
          { "source": "users", "field": "last_name", "type": { "name": "string" } }
        ],
        "separator": { "type": { "name": "string" }, "value": " " },
        "orderBy": [
          { "expression": { "source": "users", "field": "last_name", "type": { "name": "string" } } }
        ]
      }
    }
  ]
}
