// from with a combined query in place of a subquery name
{
  "from": {
    "subquery": {
      "unionAll": [
        {
          "from": { "entity": "orders" },
          "select": [
            {
              "alias": "id",
              "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
            }
          ]
        },
        {
          "from": { "entity": "users" },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      ]
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "ids", "field": "id", "type": { "name": "uuid" } } }
  ]
}
