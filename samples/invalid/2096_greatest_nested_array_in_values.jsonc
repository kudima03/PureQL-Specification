// greatest with an array among its values: nested comparisons are nested greatest
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greatest",
        "type": { "name": "decimal" },
        "values": [
          [
            { "source": "orders", "field": "total", "type": { "name": "decimal" } },
            { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } }
          ],
          { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
          { "type": { "name": "integer" }, "value": 0 }
        ]
      }
    }
  ]
}
