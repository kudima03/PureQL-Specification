// substring of an integer: no implicit conversion to string
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "substring",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "age", "type": { "name": "integer" } },
        "start": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
