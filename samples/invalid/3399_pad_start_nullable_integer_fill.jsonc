// padStart with a nullable integer fill
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "padStart",
        "type": { "name": "string", "nullable": true },
        "operand": { "type": { "name": "string" }, "value": "abc" },
        "length": { "type": { "name": "integer" }, "value": 7 },
        "fill": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
