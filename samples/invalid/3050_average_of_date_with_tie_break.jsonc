// average of a date with a tie-break: a value halfway between two is always the later one
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "date" },
        "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "tieBreak": "earlier"
      }
    }
  ]
}
