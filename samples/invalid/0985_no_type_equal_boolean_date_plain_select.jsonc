// equal declared boolean has no declared type in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "equal",
        "left": { "type": { "name": "date" }, "value": "2024-01-31" },
        "right": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ]
}
