// dateAddMonths of asDate in a zone, with the zone repeated on dateAddMonths: a date is a calendar day already
// and has no zone; the zone belongs to asDate or to datetimeAddMonths / datetimeDiffMonths
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "operand": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
        },
        "months": { "type": { "name": "integer" }, "value": 1 },
        "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
      }
    }
  ]
}
