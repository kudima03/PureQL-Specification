// regressionSlope as a group key
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
