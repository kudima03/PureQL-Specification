// A sort key of first that names a column: an aggregate sorts the rows it sees by row expressions
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } },
    {
      "alias": "first_total",
      "expression": {
        "operator": "first",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "orderBy": [
          { "column": "user_id" },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    }
  ]
}
