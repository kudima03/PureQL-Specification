// matchesRegex with a backreference: a pattern cannot refer to what a group captured
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "(a)\\1" }
      }
    }
  ]
}
