// if declared string declares the opposite nullability of string in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "string", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "string" }, "value": "a" },
        "else": { "type": { "name": "string" }, "value": "b" }
      }
    }
  ]
}
