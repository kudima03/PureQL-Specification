// if declared decimal has else as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "decimal" },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "decimal" }, "value": "2.5" },
        "else": { "source": "orders", "field": "f", "type": { "name": "decimal" } }
      }
    }
  ]
}
