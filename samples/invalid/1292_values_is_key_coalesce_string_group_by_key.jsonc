// coalesce declared string has values as a group key reference, which only a grouped select, having and orderBy have, in
// a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "string" },
        "values": [
          { "key": "k", "type": { "name": "string", "nullable": true } },
          { "type": { "name": "string" }, "value": "a" }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
