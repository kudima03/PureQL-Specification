// nullIf of a string and an integer: nothing converts to string implicitly
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIf",
        "type": { "name": "string", "nullable": true },
        "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "right": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
