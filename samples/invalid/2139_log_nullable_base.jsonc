// log with a nullable base declared decimal: it is lifted over base as over operand, so the result is
// decimal?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "log",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "base": { "param": "base", "type": { "name": "decimal", "nullable": true } }
      }
    }
  ]
}
