// in declared boolean declares the opposite nullability of boolean in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean", "nullable": true },
        "operand": { "type": { "name": "time" }, "value": "08:30:00" },
        "list": { "type": { "name": "timeList" }, "value": [ "08:30:00", "17:45:30.5" ] }
      }
    }
  ]
}
