// asTime of a boolean
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asTime",
        "type": { "name": "time" },
        "operand": { "source": "users", "field": "is_active", "type": { "name": "boolean" } }
      }
    }
  ]
}
