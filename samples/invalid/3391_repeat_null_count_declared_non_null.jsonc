// repeat with a null count declared string: it is lifted over count, so a null count gives null and the
// result is string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "repeat",
        "type": { "name": "string" },
        "operand": { "type": { "name": "string" }, "value": "abc" },
        "count": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
