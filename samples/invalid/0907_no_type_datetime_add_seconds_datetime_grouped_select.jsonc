// datetimeAddSeconds declared datetime has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddSeconds",
        "left": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
