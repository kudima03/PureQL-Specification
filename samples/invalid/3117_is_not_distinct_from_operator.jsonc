// isNotDistinctFrom is not an operator: equal already treats two nulls as equal
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "isNotDistinctFrom",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
        "right": { "param": "from", "type": { "name": "date", "nullable": true } }
      }
    }
  ]
}
