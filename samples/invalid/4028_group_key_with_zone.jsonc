// A group key with a zone: the local day is asDate of the datetime with the zone
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "day",
      "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
      "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
