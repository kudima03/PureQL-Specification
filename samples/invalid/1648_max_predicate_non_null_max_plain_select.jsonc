// max with a predicate declared non-null in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "integer" },
        "selector": { "type": { "name": "integer" }, "value": 7 },
        "predicate": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
