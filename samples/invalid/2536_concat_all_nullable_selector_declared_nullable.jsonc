// concatAll of a nullable selector declared string?: null values are skipped, and only nulls give the empty
// string
{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "kind": "inner",
      "entity": "products",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } },
        "right": { "source": "products", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "groupBy": [
    {
      "alias": "order_id",
      "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "concatAll",
        "type": { "name": "string", "nullable": true },
        "selector": {
          "source": "products",
          "field": "description",
          "type": { "name": "string", "nullable": true }
        },
        "separator": { "type": { "name": "string" }, "value": ", " },
        "orderBy": [
          { "expression": { "source": "products", "field": "sku", "type": { "name": "string" } } }
        ]
      }
    }
  ]
}
