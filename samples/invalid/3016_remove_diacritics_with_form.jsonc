// removeDiacritics with a form: its result is always composed; another form is given by normalize
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "removeDiacritics",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "form": "NFD"
      }
    }
  ]
}
