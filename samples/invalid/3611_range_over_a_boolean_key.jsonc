// A range over a boolean sort key
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } } }
          ],
          "range": { "preceding": { "days": 29 } }
        }
      }
    }
  ]
}
