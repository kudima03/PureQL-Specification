// countDistinct over a window in a grouped query
{
  "from": { "entity": "orders" },
  "groupBy": [
    { "alias": "k", "expression": { "source": "orders", "field": "status", "type": { "name": "string" } } }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "over": { "partitionBy": [ { "source": "orders", "field": "status", "type": { "name": "string" } } ] }
      }
    }
  ]
}
