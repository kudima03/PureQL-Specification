// upper of a group key reference in where, which has no group keys
{
  "from": { "entity": "users" },
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": {
      "operator": "upper",
      "type": { "name": "string" },
      "operand": { "key": "last_name", "type": { "name": "string" } }
    },
    "right": { "type": { "name": "string" }, "value": "abc" }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
