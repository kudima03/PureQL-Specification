// lessThanOrEqual declared boolean has left as a group key reference, which only a grouped select, having and orderBy
// have, in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "lessThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "datetime" } },
        "right": { "type": { "name": "datetime" }, "value": "2024-03-01T17:45:30.5Z" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
