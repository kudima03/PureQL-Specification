// median of a nullable selector declared date: every value may be null
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "median",
        "type": { "name": "date" },
        "selector": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        }
      }
    }
  ]
}
