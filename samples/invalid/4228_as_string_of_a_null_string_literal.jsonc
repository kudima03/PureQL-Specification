// asString of a typed null string: it takes every type but string, since asString of a string changes nothing
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": { "type": { "name": "string", "nullable": true }, "value": null }
      }
    }
  ]
}
