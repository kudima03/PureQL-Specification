// reverse of a list: a list has no order to reverse and is accepted only by in
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "reverse",
        "type": { "name": "string" },
        "operand": { "type": { "name": "stringList" }, "value": [ "a", "b" ] }
      }
    }
  ]
}
