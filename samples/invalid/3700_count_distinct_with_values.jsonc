// countDistinct with a values array
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "values": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ]
      }
    }
  ]
}
