// timeAddSeconds declared time has a nullable left but declares a non-null result in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "time" },
        "left": { "type": { "name": "time", "nullable": true }, "value": null },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
