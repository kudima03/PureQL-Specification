// if with list parameters as branches
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "string" },
        "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "then": { "param": "a", "type": { "name": "stringList" } },
        "else": { "param": "b", "type": { "name": "stringList" } }
      }
    }
  ]
}
