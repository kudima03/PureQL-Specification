// trimStart of a nullable operand, declared non-null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimStart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } },
        "characters": { "type": { "name": "string" }, "value": "0" }
      }
    }
  ]
}
