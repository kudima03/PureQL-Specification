// greaterThanOrEqual of a boolean and the string true: both operands of a comparison are one family, as in
// equal, though every type is ordered
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
    "right": { "type": { "name": "string" }, "value": "true" }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
