// rank in the predicate of an aggregate over a window: the predicate is a row expression
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "lessThan",
          "type": { "name": "boolean" },
          "left": {
            "operator": "rank",
            "type": { "name": "integer" },
            "over": {
              "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
              "orderBy": [
                {
                  "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
                },
                { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
              ]
            }
          },
          "right": { "type": { "name": "integer" }, "value": 3 }
        },
        "over": { "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ] }
      }
    }
  ]
}
