// toDatetime of a time: a time has no day; it is added to the midnight of a date with datetimeAddSeconds
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toDatetime",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
      }
    }
  ]
}
