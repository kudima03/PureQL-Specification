// in over an empty list literal in an aggregate's predicate
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "n",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "in",
          "type": { "name": "boolean" },
          "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "list": { "type": { "name": "stringList" }, "value": [] }
        }
      }
    }
  ]
}
