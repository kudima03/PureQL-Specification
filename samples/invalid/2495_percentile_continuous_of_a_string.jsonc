// percentileContinuous of a string: strings cannot be interpolated; percentileDiscrete yields one of the
// values
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "percentileContinuous",
        "type": { "name": "string" },
        "selector": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.9" }
      }
    }
  ]
}
