// asString of concat, which declares a string: it takes every type but string, since asString of a string
// changes nothing
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": {
          "operator": "concat",
          "type": { "name": "string" },
          "values": [
            { "source": "orders", "field": "status", "type": { "name": "string" } },
            { "type": { "name": "string" }, "value": "!" }
          ]
        }
      }
    }
  ]
}
