// in with an inline combined query as its list: a list is a column of a named subquery
{
  "from": { "entity": "users" },
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
    "list": {
      "unionAll": [
        {
          "from": { "entity": "orders" },
          "select": [
            {
              "alias": "id",
              "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
            }
          ]
        },
        {
          "from": { "entity": "users" },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      ]
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
