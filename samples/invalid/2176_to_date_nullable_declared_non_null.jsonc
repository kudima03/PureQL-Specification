// toDate of a nullable operand declared date
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toDate",
        "type": { "name": "date" },
        "operand": {
          "source": "users",
          "field": "last_login_at",
          "type": { "name": "datetime", "nullable": true }
        }
      }
    }
  ]
}
