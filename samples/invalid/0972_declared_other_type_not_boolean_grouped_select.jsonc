// not declared boolean declares another type than boolean in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "not",
        "type": { "name": "string" },
        "condition": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
