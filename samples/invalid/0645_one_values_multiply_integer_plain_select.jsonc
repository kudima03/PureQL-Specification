// multiply declared integer has a single item in values in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "multiply",
        "type": { "name": "integer" },
        "values": [ { "type": { "name": "integer" }, "value": 7 } ]
      }
    }
  ]
}
