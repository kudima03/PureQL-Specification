// equal with a collation: strings are compared code point by code point
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "right": { "source": "users", "field": "last_name", "type": { "name": "string" } },
        "collation": "nocase"
      }
    }
  ]
}
