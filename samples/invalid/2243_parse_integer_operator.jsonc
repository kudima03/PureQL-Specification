// parseInteger is not an operator: a string is read as an integer with asInteger
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "parseInteger",
        "type": { "name": "integer" },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } }
      }
    }
  ]
}
