// dateAddDays declared date has no left in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "right": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
