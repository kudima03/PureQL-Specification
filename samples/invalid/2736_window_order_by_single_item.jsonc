// The orderBy of a window as one item instead of a list
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "rowNumber",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": {
            "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
          }
        }
      }
    }
  ]
}
