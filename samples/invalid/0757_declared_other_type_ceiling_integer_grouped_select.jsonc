// ceiling declared integer declares another type than integer in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "ceiling",
        "type": { "name": "string" },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
