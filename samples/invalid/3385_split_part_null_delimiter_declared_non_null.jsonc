// splitPart with a null delimiter declared string: it is lifted over delimiter, so a null delimiter gives
// null and the result is string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "splitPart",
        "type": { "name": "string" },
        "operand": { "type": { "name": "string" }, "value": "a-b" },
        "delimiter": { "type": { "name": "string", "nullable": true }, "value": null },
        "index": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
