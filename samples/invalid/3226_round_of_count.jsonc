// round of count: without digits round cannot change an integer
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "operator": "count", "type": { "name": "integer" } }
      }
    }
  ]
}
