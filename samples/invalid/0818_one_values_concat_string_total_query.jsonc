// concat declared string has a single item in values in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "concat",
        "type": { "name": "string" },
        "values": [ { "type": { "name": "string" }, "value": "a" } ]
      }
    }
  ]
}
