// truncate of a coalesce of integers
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "truncate",
        "type": { "name": "integer" },
        "operand": {
          "operator": "coalesce",
          "type": { "name": "integer" },
          "values": [
            { "param": "units", "type": { "name": "integer", "nullable": true } },
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          ]
        }
      }
    }
  ]
}
