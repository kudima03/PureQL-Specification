// max declared decimal over a decimal selector declares the opposite nullability of decimal in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
