// replace without an operand
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "replace",
        "type": { "name": "string" },
        "pattern": { "type": { "name": "string" }, "value": " " },
        "replacement": { "type": { "name": "string" }, "value": "_" }
      }
    }
  ]
}
