// dateFromParts with a nullable day declared non-null: it is lifted over every part
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateFromParts",
        "type": { "name": "date" },
        "year": { "type": { "name": "integer" }, "value": 2024 },
        "month": { "type": { "name": "integer" }, "value": 1 },
        "day": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
