// greaterThanOrEqual of a datetime and a date parameter: both operands of a comparison are one family, as in
// equal, though every type is ordered
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
    "right": { "param": "since", "type": { "name": "date" } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
