// log of an aggregate in join.on, a row context without aggregates
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "lessThan",
            "type": { "name": "boolean" },
            "left": {
              "operator": "log",
              "type": { "name": "decimal" },
              "operand": {
                "operator": "sum",
                "type": { "name": "decimal" },
                "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
              },
              "base": { "type": { "name": "integer" }, "value": 2 }
            },
            "right": { "type": { "name": "integer" }, "value": 10 }
          }
        ]
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
