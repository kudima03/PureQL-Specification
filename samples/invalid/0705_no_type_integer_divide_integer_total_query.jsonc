// integerDivide declared integer has no declared type in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "integerDivide",
        "left": { "type": { "name": "integer" }, "value": 7 },
        "right": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ]
}
