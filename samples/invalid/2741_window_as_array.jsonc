// over written as a list of windows
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": [
          { "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ] }
        ]
      }
    }
  ]
}
