// a grouped query as a subquery: with an empty joins
{
  "subqueries": [
    {
      "name": "s",
      "query": {
        "from": { "entity": "orders" },
        "groupBy": [
          { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ],
        "select": [ { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid" } } } ],
        "joins": []
      }
    }
  ],
  "from": { "subquery": "s" },
  "select": [ { "alias": "x", "expression": { "source": "s", "field": "id", "type": { "name": "uuid" } } } ]
}
