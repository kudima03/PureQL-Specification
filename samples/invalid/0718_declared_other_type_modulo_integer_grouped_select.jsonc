// modulo declared integer declares another type than integer in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "string" },
        "left": { "type": { "name": "integer" }, "value": 7 },
        "right": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ]
}
