// dateDiffDays declared integer declares another type than integer in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffDays",
        "type": { "name": "string" },
        "left": { "type": { "name": "date" }, "value": "2024-01-31" },
        "right": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ]
}
