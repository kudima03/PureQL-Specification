// padEnd with a values array
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "padEnd",
        "type": { "name": "string" },
        "values": [
          { "source": "users", "field": "first_name", "type": { "name": "string" } },
          { "type": { "name": "integer" }, "value": 10 },
          { "type": { "name": "string" }, "value": " " }
        ]
      }
    }
  ]
}
