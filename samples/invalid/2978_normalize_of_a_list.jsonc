// normalize of a list: a list is accepted only by in
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string" },
        "operand": { "type": { "name": "stringList" }, "value": [ "a", "b" ] },
        "form": "NFC"
      }
    }
  ]
}
