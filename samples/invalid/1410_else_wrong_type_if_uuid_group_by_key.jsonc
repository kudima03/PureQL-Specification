// if declared uuid has else of a type that does not fit in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "if",
        "type": { "name": "uuid" },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "uuid" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" },
        "else": { "type": { "name": "string" }, "value": "a" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
