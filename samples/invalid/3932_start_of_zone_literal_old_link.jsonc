// startOfHour in an older name of a zone: Asia/Katmandu is Asia/Kathmandu
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "startOfHour",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "type": { "name": "string" }, "value": "Asia/Katmandu" }
      }
    }
  ]
}
