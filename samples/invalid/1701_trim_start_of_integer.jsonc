// trimStart of an integer: no implicit conversion to string
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimStart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "age", "type": { "name": "integer" } },
        "removables": [
          { "type": { "name": "string" }, "value": "0" },
          { "type": { "name": "string" }, "value": "0 " }
        ]
      }
    }
  ]
}
