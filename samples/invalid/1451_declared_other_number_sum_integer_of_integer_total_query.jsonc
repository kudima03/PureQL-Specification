// sum declared integer over a integer selector declares the other number type than integer in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
