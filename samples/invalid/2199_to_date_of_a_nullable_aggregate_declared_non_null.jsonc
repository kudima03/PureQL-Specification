// toDate of a max in a total query declared date: max is nullable there, and toDate is lifted
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "toDate",
        "type": { "name": "date" },
        "operand": {
          "operator": "max",
          "type": { "name": "datetime", "nullable": true },
          "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      }
    }
  ]
}
