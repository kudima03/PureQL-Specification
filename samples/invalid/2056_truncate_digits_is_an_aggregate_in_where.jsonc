// truncate with an aggregate as digits in where, a row context without aggregates
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "truncate",
      "type": { "name": "decimal" },
      "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
      "digits": { "operator": "count", "type": { "name": "integer" } }
    },
    "right": { "type": { "name": "integer" }, "value": 100 }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
