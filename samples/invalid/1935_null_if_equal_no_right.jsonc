// nullIfEqual without right: there is no default value to compare with
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "decimal", "nullable": true },
        "left": { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } }
      }
    }
  ]
}
