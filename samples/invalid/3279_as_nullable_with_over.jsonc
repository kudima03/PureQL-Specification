// asNullable with over: it is not an aggregate
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNullable",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } },
        "over": {
          "partitionBy": [ { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } } ]
        }
      }
    }
  ]
}
