// A recursive entry as an input of a set operation
{
  "unionAll": [
    {
      "name": "referrals",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "first_name",
              "expression": { "source": "users", "field": "first_name", "type": { "name": "string" } }
            },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "referrals",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "referrals", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "first_name",
              "expression": { "source": "users", "field": "first_name", "type": { "name": "string" } }
            },
            {
              "alias": "depth",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  { "source": "referrals", "field": "depth", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            }
          ]
        },
        "maxDepth": 50
      }
    },
    {
      "from": { "entity": "users" },
      "where": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "right": { "param": "user_id", "type": { "name": "uuid" } }
      },
      "select": [
        { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
        {
          "alias": "first_name",
          "expression": { "source": "users", "field": "first_name", "type": { "name": "string" } }
        },
        { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } }
      ]
    }
  ]
}
