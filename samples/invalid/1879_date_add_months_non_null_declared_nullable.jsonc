// dateAddMonths of non-null operands, declared nullable: a lifted operator is nullable exactly when an
// operand is
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date", "nullable": true },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "months": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
