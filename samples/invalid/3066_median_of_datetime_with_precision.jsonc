// median of a datetime with a precision: a time and a datetime are rounded to microseconds
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "median",
        "type": { "name": "datetime" },
        "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "precision": "second"
      }
    }
  ]
}
