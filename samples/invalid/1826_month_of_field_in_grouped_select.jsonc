// month of a field in a grouped select, which reads only group keys and aggregates
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "country",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "month",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
