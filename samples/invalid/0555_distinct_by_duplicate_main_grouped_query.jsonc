// a grouped query as the main query: with distinctBy listing an alias twice
{
  "from": { "entity": "orders" },
  "groupBy": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "select": [ { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid" } } } ],
  "distinctBy": [ "id", "id" ]
}
