// tryAsInteger of a group key in where, which is evaluated per row before grouping
{
  "from": { "entity": "users" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "tryAsInteger",
      "type": { "name": "integer", "nullable": true },
      "operand": { "key": "tier", "type": { "name": "string" } }
    },
    "right": { "type": { "name": "integer" }, "value": 0 }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
