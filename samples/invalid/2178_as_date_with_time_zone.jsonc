// asDate with a time zone: a datetime is read in UTC, as it is written
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "timeZone": "Europe/Berlin"
      }
    }
  ]
}
