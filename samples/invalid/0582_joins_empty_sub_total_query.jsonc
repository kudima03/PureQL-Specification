// a total query as a subquery: with an empty joins
{
  "subqueries": [
    {
      "name": "s",
      "query": {
        "from": { "entity": "orders" },
        "aggregate": [
          { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } }
        ],
        "joins": []
      }
    }
  ],
  "from": { "subquery": "s" },
  "select": [ { "alias": "x", "expression": { "source": "s", "field": "n", "type": { "name": "integer" } } } ]
}
