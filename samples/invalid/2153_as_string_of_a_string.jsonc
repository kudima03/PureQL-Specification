// asString of a string: it takes only the types it changes
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "orders", "field": "status", "type": { "name": "string" } }
      }
    }
  ]
}
