// previous in the select of a grouped recursive next: its select is group context, without windows
{
  "subqueries": [
    {
      "name": "reach",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } },
            {
              "alias": "label",
              "expression": { "source": "users", "field": "name", "type": { "name": "string" } }
            }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "reach",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "users", "field": "referrer_id", "type": { "name": "uuid", "nullable": true } },
                "right": { "source": "reach", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "where": {
            "operator": "lessThan",
            "type": { "name": "boolean" },
            "left": { "source": "reach", "field": "depth", "type": { "name": "integer" } },
            "right": { "param": "levels", "type": { "name": "integer" } }
          },
          "groupBy": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "name",
              "expression": {
                "operator": "upper",
                "type": { "name": "string" },
                "operand": { "source": "users", "field": "name", "type": { "name": "string" } }
              }
            }
          ],
          "having": {
            "operator": "or",
            "type": { "name": "boolean" },
            "conditions": [
              {
                "operator": "greaterThan",
                "type": { "name": "boolean" },
                "left": { "operator": "count", "type": { "name": "integer" } },
                "right": { "type": { "name": "integer" }, "value": 0 }
              },
              {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "key": "name", "type": { "name": "string" } },
                "right": { "type": { "name": "string" }, "value": "ROOT" }
              }
            ]
          },
          "select": [
            { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid" } } },
            {
              "alias": "depth",
              "expression": {
                "operator": "previous",
                "type": { "name": "integer", "nullable": true },
                "operand": { "source": "reach", "field": "depth", "type": { "name": "integer" } },
                "over": {
                  "orderBy": [ { "expression": { "source": "reach", "field": "depth", "type": { "name": "integer" } } } ]
                }
              }
            },
            {
              "alias": "label",
              "expression": {
                "operator": "concat",
                "type": { "name": "string" },
                "values": [
                  { "key": "name", "type": { "name": "string" } },
                  { "type": { "name": "string" }, "value": " of " },
                  {
                    "operator": "asString",
                    "type": { "name": "string" },
                    "operand": { "operator": "count", "type": { "name": "integer" }, "over": "all" }
                  }
                ]
              }
            }
          ]
        },
        "maxDepth": 50
      }
    }
  ],
  "from": { "subquery": "reach" },
  "select": [
    { "alias": "id", "expression": { "source": "reach", "field": "id", "type": { "name": "uuid" } } },
    { "alias": "depth", "expression": { "source": "reach", "field": "depth", "type": { "name": "integer" } } },
    { "alias": "label", "expression": { "source": "reach", "field": "label", "type": { "name": "string" } } }
  ]
}
