// A zone written as { offset }
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "offset": "+03:00" }
      }
    }
  ]
}
