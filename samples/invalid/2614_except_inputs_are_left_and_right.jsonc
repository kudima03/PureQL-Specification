// except with left and right: its inputs are an array, the first minus the others
{
  "except": {
    "left": {
      "from": { "entity": "users" },
      "select": [
        { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
      ]
    },
    "right": {
      "from": { "entity": "orders" },
      "select": [
        {
          "alias": "id",
          "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
        }
      ]
    }
  }
}
