// asDate with year, month and day: it converts one operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "year": { "type": { "name": "integer" }, "value": 2024 },
        "month": { "type": { "name": "integer" }, "value": 4 },
        "day": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
