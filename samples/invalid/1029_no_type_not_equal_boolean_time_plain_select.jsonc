// notEqual declared boolean has no declared type in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "notEqual",
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "time" }, "value": "17:45:30.5" }
      }
    }
  ]
}
