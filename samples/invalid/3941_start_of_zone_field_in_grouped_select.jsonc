// startOfDay of a key in a grouped select with a field as its zone
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "k",
      "expression": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "startOfDay",
        "type": { "name": "datetime" },
        "operand": { "key": "k", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    }
  ]
}
