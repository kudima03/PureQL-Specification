// trimEnd without a declared type
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimEnd",
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "removables": [
          { "type": { "name": "string" }, "value": "0" },
          { "type": { "name": "string" }, "value": "0 " }
        ]
      }
    }
  ]
}
