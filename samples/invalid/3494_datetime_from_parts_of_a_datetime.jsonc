// datetimeFromParts whose date is a datetime: its day is asDate
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
      }
    }
  ]
}
