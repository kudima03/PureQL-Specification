// lessThan declared boolean declares the opposite nullability of boolean in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "lessThan",
        "type": { "name": "boolean", "nullable": true },
        "left": { "type": { "name": "date" }, "value": "2024-01-31" },
        "right": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ]
}
