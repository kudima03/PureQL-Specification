// floor declared integer declares the opposite nullability of integer in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer", "nullable": true },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
