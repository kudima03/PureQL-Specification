// nullIfEqual of an integer and a string: the operands are of one family, as for equal
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "integer", "nullable": true },
        "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "right": { "type": { "name": "string" }, "value": "0" }
      }
    }
  ]
}
