// trimStart declared integer: it yields string
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimStart",
        "type": { "name": "integer" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } }
      }
    }
  ]
}
