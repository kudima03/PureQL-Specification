// asNullable of a field in a grouped select, which reads only group keys and aggregates
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "k",
      "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNullable",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
      }
    }
  ]
}
