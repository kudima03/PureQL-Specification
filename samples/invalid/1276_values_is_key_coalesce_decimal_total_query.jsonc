// coalesce declared decimal has values as a group key reference, which only a grouped select, having and orderBy have,
// in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "decimal" },
        "values": [
          { "key": "k", "type": { "name": "decimal", "nullable": true } },
          { "type": { "name": "decimal" }, "value": "2.5" }
        ]
      }
    }
  ]
}
