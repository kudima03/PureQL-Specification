// coalesce declared date? has a single item in values in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "date", "nullable": true },
        "values": [ { "type": { "name": "date", "nullable": true }, "value": null } ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
