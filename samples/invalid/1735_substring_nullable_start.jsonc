// substring with a nullable start declared string: it is lifted over start as over operand, so the result is
// string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "substring",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "start": {
          "source": "users",
          "field": "referral_count",
          "type": { "name": "integer", "nullable": true }
        }
      }
    }
  ]
}
