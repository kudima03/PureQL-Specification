// divide by a nullIf declared decimal: nullIf is nullable and divide is lifted, so the quotient is decimal?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          {
            "operator": "nullIf",
            "type": { "name": "decimal", "nullable": true },
            "left": { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
            "right": { "type": { "name": "integer" }, "value": 0 }
          }
        ]
      }
    }
  ]
}
