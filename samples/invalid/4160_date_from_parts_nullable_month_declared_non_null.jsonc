// dateFromParts with a nullable month declared non-null: it is lifted over every part
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateFromParts",
        "type": { "name": "date" },
        "year": { "type": { "name": "integer" }, "value": 2024 },
        "month": { "param": "month", "type": { "name": "integer", "nullable": true } },
        "day": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
