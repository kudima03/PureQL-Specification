// sinh is not an operator: the hyperbolic functions are compositions of exp
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sinh",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
