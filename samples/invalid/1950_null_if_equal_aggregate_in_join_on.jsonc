// nullIfEqual of an aggregate in join.on, a row context without aggregates
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "nullIfEqual",
          "type": { "name": "uuid", "nullable": true },
          "left": {
            "operator": "min",
            "type": { "name": "uuid" },
            "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
          },
          "right": { "param": "nobody", "type": { "name": "uuid" } }
        },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
