// parseUuid of a non-null string declared uuid?: text that does not parse fails the query, it does not give
// null; that is tryParseUuid
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "parseUuid",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } }
      }
    }
  ]
}
