// toDatetime of a non-null operand declared datetime?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toDatetime",
        "type": { "name": "datetime", "nullable": true },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
