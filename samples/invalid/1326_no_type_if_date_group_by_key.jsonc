// if declared date has no declared type in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "if",
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "date" }, "value": "2024-01-31" },
        "else": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
