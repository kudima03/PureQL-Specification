// datetimeDiffMonths in a zone declared decimal: it counts whole months
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffMonths",
        "type": { "name": "decimal" },
        "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
        "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
      }
    }
  ]
}
