// average declared datetime? over a datetime selector takes the average of a string in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "datetime", "nullable": true },
        "selector": { "type": { "name": "string" }, "value": "a" }
      }
    }
  ]
}
