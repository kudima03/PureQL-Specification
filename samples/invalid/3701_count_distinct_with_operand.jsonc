// countDistinct with an operand: an aggregate reads a selector
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ]
}
