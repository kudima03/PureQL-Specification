// asNullable of a uuid declared string?
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNullable",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
      }
    }
  ]
}
