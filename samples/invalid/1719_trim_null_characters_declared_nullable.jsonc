// trim with null characters, declared nullable: characters is never null, so it cannot make the result
// nullable
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trim",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "characters": { "type": { "name": "string", "nullable": true }, "value": null }
      }
    }
  ]
}
