// dateAddMonths with a zone parameter: a date is a calendar day already and has no zone; the zone belongs to
// asDate or to datetimeAddMonths / datetimeDiffMonths
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "months": { "type": { "name": "integer" }, "value": 1 },
        "zone": { "param": "zone", "type": { "name": "string" } }
      }
    }
  ]
}
