// previous over a window without orderBy
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "previous",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": { "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ] }
      }
    }
  ]
}
