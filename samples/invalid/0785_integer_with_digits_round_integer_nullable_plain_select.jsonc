// round declared integer? declares integer although digits is given in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer", "nullable": true },
        "operand": { "type": { "name": "decimal", "nullable": true }, "value": null },
        "digits": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
