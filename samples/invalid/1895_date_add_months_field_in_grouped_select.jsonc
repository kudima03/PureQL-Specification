// dateAddMonths to a field in a grouped select, which reads only group keys and aggregates
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "country",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
