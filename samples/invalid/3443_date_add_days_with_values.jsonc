// dateAddDays with a values array
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "values": [
          { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          { "type": { "name": "integer" }, "value": 3 }
        ]
      }
    }
  ]
}
