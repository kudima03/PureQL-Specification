// asDatetime of a string with timeZone: the text spells an instant in UTC, and a zone is written as zone, for a date
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime" },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } },
        "timeZone": "Europe/Berlin"
      }
    }
  ]
}
