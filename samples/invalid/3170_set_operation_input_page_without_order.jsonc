// An input of a set operation paged without orderBy
{
  "unionAll": [
    {
      "from": { "entity": "orders" },
      "select": [
        { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
        {
          "alias": "total",
          "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      ],
      "pagination": { "take": 5 }
    },
    {
      "from": { "entity": "orders" },
      "select": [
        { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
        {
          "alias": "total",
          "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      ],
      "orderBy": [
        {
          "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "direction": "desc"
        },
        { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
      ],
      "pagination": { "skip": 5, "take": 5 }
    }
  ]
}
