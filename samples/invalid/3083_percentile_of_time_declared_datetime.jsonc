// percentileContinuous of a time declared datetime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "percentileContinuous",
        "type": { "name": "datetime" },
        "selector": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.5" }
      }
    }
  ]
}
