// A subquery with an empty pagination: its orderBy then serves nothing
{
  "subqueries": [
    {
      "name": "latest",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
          {
            "alias": "total",
            "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        ],
        "orderBy": [
          {
            "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "direction": "desc"
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ],
        "pagination": {}
      }
    }
  ],
  "from": { "subquery": "latest" },
  "select": [
    { "alias": "id", "expression": { "source": "latest", "field": "id", "type": { "name": "uuid" } } }
  ]
}
