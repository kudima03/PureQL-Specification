// coalesce declared boolean? has values as a group key reference, which only a grouped select, having and orderBy have,
// in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "boolean", "nullable": true },
        "values": [
          { "key": "k", "type": { "name": "boolean", "nullable": true } },
          { "type": { "name": "boolean", "nullable": true }, "value": null }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
