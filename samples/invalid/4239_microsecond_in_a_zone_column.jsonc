// microsecond with the user's zone column: an offset from UTC is a whole number of seconds, so it is the same
// in every zone
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "microsecond",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    }
  ]
}
