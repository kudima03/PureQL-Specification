// matchesRegex of a field in a grouped select, which reads only group keys and aggregates
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "country",
      "expression": { "source": "users", "field": "country", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "country", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "^[A-Z]{2}$" }
      }
    }
  ]
}
