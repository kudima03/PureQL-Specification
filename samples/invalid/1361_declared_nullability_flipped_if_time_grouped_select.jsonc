// if declared time declares the opposite nullability of time in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "time", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "time" }, "value": "08:30:00" },
        "else": { "type": { "name": "time" }, "value": "17:45:30.5" }
      }
    }
  ]
}
