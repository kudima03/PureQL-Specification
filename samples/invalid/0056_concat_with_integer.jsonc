// concat(string, integer) — no implicit conversion to string
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "concat",
        "type": { "name": "string" },
        "values": [
          { "source": "orders", "field": "name", "type": { "name": "string" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
