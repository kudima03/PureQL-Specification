// datetimeDiffMonths of a field in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffMonths",
        "type": { "name": "integer" },
        "left": { "type": { "name": "datetime" }, "value": "2024-02-15T11:59:59Z" },
        "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    }
  ]
}
