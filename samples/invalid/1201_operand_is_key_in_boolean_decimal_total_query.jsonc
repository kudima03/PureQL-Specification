// in declared boolean has operand as a group key reference, which only a grouped select, having and orderBy have, in a
// total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "key": "k", "type": { "name": "decimal" } },
        "list": { "type": { "name": "decimalList" }, "value": [ "2.5", "0.1" ] }
      }
    }
  ]
}
