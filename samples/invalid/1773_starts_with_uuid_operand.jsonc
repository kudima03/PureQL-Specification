// startsWith over a uuid operand: a uuid is not a string
{
  "from": { "entity": "users" },
  "where": {
    "operator": "startsWith",
    "type": { "name": "boolean" },
    "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
    "pattern": { "type": { "name": "string" }, "value": "abc" }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
