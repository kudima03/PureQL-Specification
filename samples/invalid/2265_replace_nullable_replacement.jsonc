// replace with a nullable replacement
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "replace",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": " " },
        "replacement": { "type": { "name": "string", "nullable": true }, "value": null }
      }
    }
  ]
}
