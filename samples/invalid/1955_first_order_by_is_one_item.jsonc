// first with a single sort key as orderBy instead of an array of them
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "first",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "orderBy": {
          "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      }
    }
  ]
}
