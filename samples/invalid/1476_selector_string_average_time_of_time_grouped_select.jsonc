// average declared time over a time selector takes the average of a string in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "time" },
        "selector": { "type": { "name": "string" }, "value": "a" }
      }
    }
  ]
}
