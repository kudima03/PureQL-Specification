// countDistinct in a total query declared integer?: over no rows it is 0
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer", "nullable": true },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ]
}
