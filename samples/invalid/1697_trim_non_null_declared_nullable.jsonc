// trim of a non-null operand, declared nullable: a lifted operator is nullable exactly when an operand is
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trim",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "characters": { "type": { "name": "string" }, "value": "0" }
      }
    }
  ]
}
