// repeat with a nullable count declared string in where
{
  "from": { "entity": "users" },
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": {
      "operator": "repeat",
      "type": { "name": "string" },
      "operand": { "type": { "name": "string" }, "value": "*" },
      "count": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } }
    },
    "right": { "type": { "name": "string" }, "value": "**" }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
