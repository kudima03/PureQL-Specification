// $schema without a version
{
  "$schema": "https://github.com/kudima03/PureQL-Specification/PureQL-Specification.json",
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "total",
      "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
    }
  ]
}
