// dateAddMonths of a nullable date with a zone: a date is a calendar day already and has no zone; the zone
// belongs to asDate or to datetimeAddMonths / datetimeDiffMonths
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date", "nullable": true },
        "operand": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        },
        "months": { "type": { "name": "integer" }, "value": 1 },
        "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
      }
    }
  ]
}
