// nullIfEqual of a boolean and the integer 0: false is a boolean literal, and nothing converts between the
// two
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "boolean", "nullable": true },
        "left": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "right": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
