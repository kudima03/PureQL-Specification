// coalesce declared date declares the opposite nullability of date in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "date", "nullable": true },
        "values": [
          { "type": { "name": "date", "nullable": true }, "value": null },
          { "type": { "name": "date" }, "value": "2024-01-31" }
        ]
      }
    }
  ]
}
