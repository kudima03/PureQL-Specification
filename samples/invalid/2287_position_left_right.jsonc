// position with left and right: its operands are operand and pattern, as for contains
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "position",
        "type": { "name": "integer" },
        "left": { "source": "users", "field": "name", "type": { "name": "string" } },
        "right": { "type": { "name": "string" }, "value": " " }
      }
    }
  ]
}
