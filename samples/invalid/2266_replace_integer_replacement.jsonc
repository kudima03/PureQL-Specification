// replace with an integer replacement: nothing converts to string implicitly
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "replace",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": " " },
        "replacement": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
