// trim with a side: trimStart and trimEnd are separate operators, and no other property is allowed
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trim",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "side": "start"
      }
    }
  ]
}
