// if declared string declares the opposite nullability of string in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "string", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "string" }, "value": "a" },
        "else": { "type": { "name": "string" }, "value": "b" }
      }
    }
  ]
}
