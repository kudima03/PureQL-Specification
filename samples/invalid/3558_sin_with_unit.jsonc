// sin with a unit
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sin",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "unit": "degrees"
      }
    }
  ]
}
