// coalesce declared date has two non-null operands, the second never reached in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "date" },
        "values": [
          { "type": { "name": "date" }, "value": "2024-01-31" },
          { "type": { "name": "date" }, "value": "2024-03-01" }
        ]
      }
    }
  ]
}
