// concat declared string has values as a group key reference, which only a grouped select, having and orderBy have, in a
// total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "concat",
        "type": { "name": "string" },
        "values": [
          { "key": "k", "type": { "name": "string" } },
          { "type": { "name": "string" }, "value": "b" }
        ]
      }
    }
  ]
}
