// modulo of an integer and a decimal declared integer
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "integer" },
        "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
