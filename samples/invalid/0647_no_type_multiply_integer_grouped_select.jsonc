// multiply declared integer has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "multiply",
        "values": [
          { "type": { "name": "integer" }, "value": 7 },
          { "type": { "name": "integer" }, "value": -3 }
        ]
      }
    }
  ]
}
