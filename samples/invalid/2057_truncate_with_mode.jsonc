// truncate with a mode property: rounding in another direction is floor, ceiling or round
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "truncate",
        "type": { "name": "integer" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "mode": "floor"
      }
    }
  ]
}
