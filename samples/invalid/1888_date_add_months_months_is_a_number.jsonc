// dateAddMonths with a bare JSON number of months: an operand is an expression
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "months": 1
      }
    }
  ]
}
