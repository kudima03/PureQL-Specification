// datetimeAddSeconds declared datetime has its operand as a group key reference, which only a grouped select,
// having and orderBy have, in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime" },
        "operand": { "key": "k", "type": { "name": "datetime" } },
        "seconds": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
