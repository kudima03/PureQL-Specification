// A non-null field made nullable by a flag on the reference: a reference declares the field's own type
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "source": "order_items",
        "field": "order_id",
        "type": { "name": "uuid" },
        "nullable": true
      }
    }
  ]
}
