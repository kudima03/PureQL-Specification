// or declared boolean has no declared type in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "or",
        "conditions": [
          { "type": { "name": "boolean" }, "value": true },
          { "type": { "name": "boolean" }, "value": false }
        ]
      }
    }
  ]
}
