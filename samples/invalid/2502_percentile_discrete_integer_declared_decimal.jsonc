// percentileDiscrete of an integer selector declared decimal: it yields one of the values, so it keeps their
// type
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "product_id",
      "expression": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "percentileDiscrete",
        "type": { "name": "decimal" },
        "selector": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.5" }
      }
    }
  ]
}
