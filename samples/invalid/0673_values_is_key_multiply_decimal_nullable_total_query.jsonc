// multiply declared decimal? has values as a group key reference, which only a grouped select, having and orderBy have,
// in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "multiply",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          { "key": "k", "type": { "name": "decimal", "nullable": true } },
          { "type": { "name": "integer" }, "value": 7 }
        ]
      }
    }
  ]
}
