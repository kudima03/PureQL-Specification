// unionAll with "distinct": true: removing duplicates is the operation union
{
  "unionAll": [
    {
      "from": { "entity": "orders" },
      "select": [
        {
          "alias": "id",
          "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
        }
      ]
    },
    {
      "from": { "entity": "users" },
      "select": [
        { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
      ]
    }
  ],
  "distinct": true
}
