// dateList literal with a repeated date: a list literal is a set
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "list": { "type": { "name": "dateList" }, "value": [ "2024-01-31", "2024-02-01", "2024-01-31" ] }
  }
}
