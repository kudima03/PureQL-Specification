// splitPart of a nullable operand declared string
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "splitPart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "mobile", "type": { "name": "string", "nullable": true } },
        "delimiter": { "type": { "name": "string" }, "value": " " },
        "index": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
