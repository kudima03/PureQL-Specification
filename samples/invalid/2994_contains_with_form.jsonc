// contains with a form
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "contains",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } },
        "pattern": { "param": "needle", "type": { "name": "string" } },
        "form": "NFC"
      }
    }
  ]
}
