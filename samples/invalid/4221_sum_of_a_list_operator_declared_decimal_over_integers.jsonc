// sum of a list operator declared decimal over integers
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "order_id",
      "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "value",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "add",
          "type": { "name": "integer" },
          "values": [
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            { "source": "order_items", "field": "returned_quantity", "type": { "name": "integer" } },
            { "type": { "name": "integer" }, "value": 1 }
          ]
        }
      }
    }
  ]
}
