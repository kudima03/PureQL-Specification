// matchesRegex with a counted quantifier on \B: a non-boundary is an assertion, not an atom, so nothing repeats it
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "foo\\B{2}" }
      }
    }
  ]
}
