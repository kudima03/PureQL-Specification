// A range of months over a datetime key with a zone: the distance of a range counts months in UTC
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } }
          ],
          "range": {
            "preceding": { "months": 1, "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" } }
          }
        }
      }
    }
  ]
}
