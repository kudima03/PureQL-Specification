// datetimeDiffSeconds declared decimal has a nullable left but declares a non-null result in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffSeconds",
        "type": { "name": "decimal" },
        "left": { "type": { "name": "datetime", "nullable": true }, "value": null },
        "right": { "type": { "name": "datetime" }, "value": "2024-03-01T17:45:30.5Z" }
      }
    }
  ]
}
