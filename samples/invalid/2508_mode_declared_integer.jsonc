// mode of a string selector declared integer: it is the most frequent value, not how often it occurs
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "mode",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "status", "type": { "name": "string" } }
      }
    }
  ]
}
