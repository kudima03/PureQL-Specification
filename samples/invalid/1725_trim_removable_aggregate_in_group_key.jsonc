// trim with an aggregate as a removable in a groupBy key: a row expression has no aggregates
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "trim",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "removables": [
          {
            "operator": "max",
            "type": { "name": "string" },
            "selector": { "source": "users", "field": "name", "type": { "name": "string" } }
          }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
