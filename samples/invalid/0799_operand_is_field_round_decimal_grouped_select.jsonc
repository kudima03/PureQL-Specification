// round declared decimal has operand as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "f", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ]
}
