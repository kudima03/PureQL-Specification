// An aggregate as a sort key of a window: the parts of a window are row expressions
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "previous",
        "type": { "name": "date" },
        "operand": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "default": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            {
              "expression": {
                "operator": "sum",
                "type": { "name": "decimal" },
                "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
              }
            },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    }
  ]
}
