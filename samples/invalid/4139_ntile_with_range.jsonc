// ntile with a range: a ranking function takes an order and neither a frame nor a range
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "ntile",
        "type": { "name": "integer" },
        "buckets": { "type": { "name": "integer" }, "value": 4 },
        "over": {
          "orderBy": [ { "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } } } ],
          "range": { "preceding": 10 }
        }
      }
    }
  ]
}
