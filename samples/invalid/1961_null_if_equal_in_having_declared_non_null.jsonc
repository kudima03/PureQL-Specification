// nullIfEqual of an aggregate in having declared decimal
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "divide",
      "type": { "name": "decimal", "nullable": true },
      "values": [
        {
          "operator": "sum",
          "type": { "name": "decimal" },
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        },
        {
          "operator": "nullIfEqual",
          "type": { "name": "decimal" },
          "left": {
            "operator": "sum",
            "type": { "name": "decimal" },
            "selector": { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } }
          },
          "right": { "type": { "name": "integer" }, "value": 0 }
        }
      ]
    },
    "right": { "type": { "name": "decimal" }, "value": "0.5" }
  },
  "select": [ { "alias": "status", "expression": { "key": "status", "type": { "name": "string" } } } ]
}
