// if declared decimal declares decimal with integer branches only in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "if",
        "type": { "name": "decimal" },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "integer" }, "value": 7 },
        "else": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
