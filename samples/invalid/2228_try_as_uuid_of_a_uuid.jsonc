// tryAsUuid of a uuid
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "tryAsUuid",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
