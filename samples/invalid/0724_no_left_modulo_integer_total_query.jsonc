// modulo declared integer has no left in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "integer" },
        "right": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ]
}
