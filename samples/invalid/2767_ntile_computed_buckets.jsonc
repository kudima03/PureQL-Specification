// ntile whose buckets is computed: it is one number for the whole query
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "ntile",
        "type": { "name": "integer" },
        "buckets": {
          "operator": "add",
          "type": { "name": "integer" },
          "values": [
            { "type": { "name": "integer" }, "value": 2 },
            { "type": { "name": "integer" }, "value": 2 }
          ]
        },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    }
  ]
}
