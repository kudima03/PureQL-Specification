// in declared boolean has no declared type in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "operand": { "type": { "name": "time" }, "value": "08:30:00" },
        "list": { "type": { "name": "timeList" }, "value": [ "08:30:00", "17:45:30.5" ] }
      }
    }
  ]
}
