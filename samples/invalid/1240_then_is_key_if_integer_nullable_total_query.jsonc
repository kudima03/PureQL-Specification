// if declared integer? has then as a group key reference, which only a grouped select, having and orderBy have, in a
// total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "integer", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "key": "k", "type": { "name": "integer", "nullable": true } },
        "else": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
