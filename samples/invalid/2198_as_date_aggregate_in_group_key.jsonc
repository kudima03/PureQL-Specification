// asDate of an aggregate as a groupBy key, a row expression
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "day",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": {
          "operator": "max",
          "type": { "name": "datetime" },
          "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
