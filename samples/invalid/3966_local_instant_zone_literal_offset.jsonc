// datetimeFromParts with an offset as its zone: +03:00 is not a name; three hours ahead of UTC is Etc/GMT-3
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "zone": { "type": { "name": "string" }, "value": "+03:00" }
      }
    }
  ]
}
