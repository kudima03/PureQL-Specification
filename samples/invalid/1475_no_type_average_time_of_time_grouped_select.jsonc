// average declared time over a time selector has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": { "operator": "average", "selector": { "type": { "name": "time" }, "value": "08:30:00" } }
    }
  ]
}
