// all declared boolean with a predicate declares boolean? although it is never null in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "all",
        "type": { "name": "boolean", "nullable": true },
        "predicate": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
