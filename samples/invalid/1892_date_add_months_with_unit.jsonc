// dateAddMonths with a unit: the unit is in the operator name, and no other property is allowed
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "type": { "name": "integer" }, "value": 1 },
        "unit": "year"
      }
    }
  ]
}
