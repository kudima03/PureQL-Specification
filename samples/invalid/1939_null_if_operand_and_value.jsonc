// nullIf written as { operand, value }: its operands are left and right, and value only ever means a
// literal's value
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIf",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
        "value": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
