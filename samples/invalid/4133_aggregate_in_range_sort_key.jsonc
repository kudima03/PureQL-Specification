// An aggregate as the sort key of a range: the key is a row expression
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "orderBy": [ { "expression": { "operator": "count", "type": { "name": "integer" } } } ],
          "range": { "preceding": 1 }
        }
      }
    }
  ]
}
