// least of a uuid and a string
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "least",
        "type": { "name": "uuid" },
        "values": [
          { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
          { "type": { "name": "string" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" }
        ]
      }
    }
  ]
}
