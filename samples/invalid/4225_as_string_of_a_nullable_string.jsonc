// asString of a nullable string field: it takes every type but string, since asString of a string changes
// nothing
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } }
      }
    }
  ]
}
