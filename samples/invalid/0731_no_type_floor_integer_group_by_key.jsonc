// floor declared integer has no declared type in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": { "operator": "floor", "operand": { "type": { "name": "decimal" }, "value": "2.5" } }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
