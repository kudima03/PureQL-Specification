// datetimeAddMonths to a date: its operand is a datetime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddMonths",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "months": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
