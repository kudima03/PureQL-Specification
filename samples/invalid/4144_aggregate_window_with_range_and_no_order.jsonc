// An aggregate's window with a range and no orderBy: a range measures along the one sort key
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "range": { "preceding": 1 }
        }
      }
    }
  ]
}
