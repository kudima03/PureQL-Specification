// if declared decimal? declares decimal with integer branches only in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "decimal", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "integer", "nullable": true }, "value": null },
        "else": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
