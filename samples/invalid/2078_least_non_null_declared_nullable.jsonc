// least of non-null operands declared string?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "least",
        "type": { "name": "string", "nullable": true },
        "values": [
          { "source": "orders", "field": "status", "type": { "name": "string" } },
          { "type": { "name": "string" }, "value": "pending" }
        ]
      }
    }
  ]
}
