// A partition key written as a select alias: it is an expression
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": { "partitionBy": [ "user_id" ] }
      }
    }
  ]
}
