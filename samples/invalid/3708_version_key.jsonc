// A version key on the query: the release is named by $schema
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "total",
      "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
    }
  ],
  "version": "0.1.0-preview.2.0.1"
}
