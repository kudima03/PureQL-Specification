// unionAll with pagination: a combined query is paged by a query that reads it as a subquery
{
  "unionAll": [
    {
      "from": { "entity": "orders" },
      "select": [
        {
          "alias": "id",
          "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
        }
      ]
    },
    {
      "from": { "entity": "users" },
      "select": [
        { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
      ]
    }
  ],
  "pagination": { "skip": 0, "take": 10 }
}
