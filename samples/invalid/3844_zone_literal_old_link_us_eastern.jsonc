// An older name of a zone: US/Eastern is America/New_York
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "type": { "name": "string" }, "value": "US/Eastern" }
      }
    }
  ]
}
