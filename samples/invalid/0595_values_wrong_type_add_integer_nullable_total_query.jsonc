// add declared integer? has values of a type that does not fit in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "integer", "nullable": true },
        "values": [
          { "type": { "name": "string" }, "value": "a" },
          { "type": { "name": "integer", "nullable": true }, "value": null }
        ]
      }
    }
  ]
}
