// extractRegex of an aggregate as a groupBy key, a row expression
{
  "from": { "entity": "users" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "extractRegex",
        "type": { "name": "string", "nullable": true },
        "operand": {
          "operator": "min",
          "type": { "name": "string" },
          "selector": { "source": "users", "field": "email", "type": { "name": "string" } }
        },
        "pattern": { "type": { "name": "string" }, "value": "@(.+)$" },
        "group": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
