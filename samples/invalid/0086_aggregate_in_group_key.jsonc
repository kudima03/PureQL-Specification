// Aggregate as a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "key_0",
      "expression": { "operator": "count", "type": { "name": "integer" }, "over": "all" }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "key_0", "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ]
}
