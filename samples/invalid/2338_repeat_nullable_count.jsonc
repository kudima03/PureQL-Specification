// repeat with a nullable count declared string: it is lifted over count as over operand, so the result is
// string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "repeat",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "count": { "param": "times", "type": { "name": "integer", "nullable": true } }
      }
    }
  ]
}
