// greaterThanOrEqual declared boolean has left as a field, which this context has no rows to read from, in a grouped
// select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "f", "type": { "name": "boolean" } },
        "right": { "type": { "name": "boolean" }, "value": false }
      }
    }
  ]
}
