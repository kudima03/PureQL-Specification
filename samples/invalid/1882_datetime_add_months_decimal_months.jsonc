// datetimeAddMonths with a decimal number of months: months are whole, and decimal does not narrow to integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddMonths",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "months": { "type": { "name": "decimal" }, "value": "1.5" }
      }
    }
  ]
}
