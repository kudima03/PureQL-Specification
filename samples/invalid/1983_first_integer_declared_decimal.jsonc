// first of an integer selector declared decimal: it keeps the type of its selector exactly
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "order_id",
      "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "first",
        "type": { "name": "decimal" },
        "selector": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "orderBy": [
          { "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    }
  ]
}
