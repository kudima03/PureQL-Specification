// timeAddSeconds declared time? has its operand as a group key reference, which only a grouped select, having
// and orderBy have, in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "time", "nullable": true },
        "operand": { "key": "k", "type": { "name": "time" } },
        "seconds": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
