// datetimeFromParts with its zone as a bare string: a zone is an expression and declares its type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "zone": "Europe/Berlin"
      }
    }
  ]
}
