// tryParseInteger with a default: the value for text that does not parse is given with coalesce
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "tryParseInteger",
        "type": { "name": "integer", "nullable": true },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } },
        "default": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
