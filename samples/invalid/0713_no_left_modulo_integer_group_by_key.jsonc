// modulo declared integer has no left in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "modulo",
        "type": { "name": "integer" },
        "right": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
