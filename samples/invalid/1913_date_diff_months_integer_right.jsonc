// dateDiffMonths with an integer on the right: it takes two dates; a number of months is added with
// dateAddMonths
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
