// tryAsDecimal of an integer: it reads strings only, since widening an integer cannot fail
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "tryAsDecimal",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ]
}
