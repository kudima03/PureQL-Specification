// datetimeDiffMonths in a nullable zone declared integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
        "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "param": "zone", "type": { "name": "string", "nullable": true } }
      }
    }
  ]
}
