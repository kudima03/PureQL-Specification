// equal declared boolean has right of a type that does not fit in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "type": { "name": "decimal" }, "value": "2.5" },
        "right": { "type": { "name": "string" }, "value": "a" }
      }
    }
  ]
}
