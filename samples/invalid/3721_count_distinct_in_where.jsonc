// countDistinct in where: an aggregate is not a row expression
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "countDistinct",
      "type": { "name": "integer" },
      "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    },
    "right": { "type": { "name": "integer" }, "value": 1 }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
