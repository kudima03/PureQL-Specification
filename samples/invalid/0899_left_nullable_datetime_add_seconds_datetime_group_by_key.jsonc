// datetimeAddSeconds declared datetime has a nullable left but declares a non-null result in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime" },
        "left": { "type": { "name": "datetime", "nullable": true }, "value": null },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
