// countDistinct declared decimal: a number of values is an integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ]
}
