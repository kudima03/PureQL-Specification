// toString of a nullable operand declared string: it is lifted, so null stays null and is not the text "null"
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toString",
        "type": { "name": "string" },
        "operand": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        }
      }
    }
  ]
}
