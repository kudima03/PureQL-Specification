// normalize with a removeDiacritics flag: accents are removed by their own operator
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "form": "NFC",
        "removeDiacritics": true
      }
    }
  ]
}
