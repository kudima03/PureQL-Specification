// add declared integer has a single item in values in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [ { "type": { "name": "integer" }, "value": 7 } ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
