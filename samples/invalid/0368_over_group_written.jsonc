// over: "group" written out: it is the default in a grouped query, so only "all" is written
{
  "from": { "entity": "orders" },
  "groupBy": [{ "alias": "user_id", "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
  "select": [
    { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } },
    {
      "alias": "m",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "over": "group",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
