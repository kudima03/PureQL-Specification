// datetimeDiffMonths of two dates in a zone: dates have no zone, and their months are counted by
// dateDiffMonths
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
      }
    }
  ]
}
