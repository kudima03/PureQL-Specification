// round declared decimal? has operand as a group key reference, which only a grouped select, having and orderBy have, in
// a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "key": "k", "type": { "name": "decimal", "nullable": true } },
        "digits": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
