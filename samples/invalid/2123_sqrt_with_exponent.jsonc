// sqrt with an exponent: another root is power with a fractional exponent
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sqrt",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "exponent": { "type": { "name": "integer" }, "value": 3 }
      }
    }
  ]
}
