// rowNumber in where: a window function is computed after where, so its result is filtered by a query that
// reads this one as a subquery
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "rowNumber",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": {
      "operator": "rowNumber",
      "type": { "name": "integer" },
      "over": {
        "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
        "orderBy": [
          { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    },
    "right": { "type": { "name": "integer" }, "value": 1 }
  }
}
