// A list literal with items instead of value
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "list": { "type": { "name": "stringList" }, "items": [ "paid", "new" ] }
      }
    }
  ]
}
