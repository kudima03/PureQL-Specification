// asDatetime of a nullable operand declared datetime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime" },
        "operand": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        }
      }
    }
  ]
}
