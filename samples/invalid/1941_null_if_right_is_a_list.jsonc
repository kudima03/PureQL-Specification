// nullIf with a list as right: lists are accepted only by in
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "nullIf",
        "type": { "name": "string", "nullable": true },
        "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "right": { "type": { "name": "stringList" }, "value": [ "unknown", "n/a" ] }
      }
    }
  ]
}
