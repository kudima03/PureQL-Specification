// sum declared integer over a integer selector declares another type than integer in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "string" },
        "selector": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
