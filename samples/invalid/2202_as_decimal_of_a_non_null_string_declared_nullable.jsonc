// asDecimal of a non-null string declared decimal?: text that is not a decimal literal fails the query, it
// does not give null; that is tryAsDecimal
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDecimal",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } }
      }
    }
  ]
}
