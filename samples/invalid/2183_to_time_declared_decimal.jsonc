// toTime declared decimal: the seconds since midnight are timeDiffSeconds of the time and 00:00:00
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toTime",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    }
  ]
}
