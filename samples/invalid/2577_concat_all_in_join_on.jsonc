// concatAll in join.on, a row context without aggregates
{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "kind": "inner",
      "entity": "products",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "concatAll",
          "type": { "name": "string" },
          "selector": { "source": "products", "field": "sku", "type": { "name": "string" } },
          "separator": { "type": { "name": "string" }, "value": "," },
          "orderBy": [
            { "expression": { "source": "products", "field": "sku", "type": { "name": "string" } } }
          ]
        },
        "right": { "source": "products", "field": "sku", "type": { "name": "string" } }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
  ]
}
