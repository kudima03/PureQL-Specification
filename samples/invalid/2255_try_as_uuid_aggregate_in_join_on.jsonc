// tryAsUuid of an aggregate in join.on, a row context without aggregates
{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "kind": "inner",
      "entity": "products",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } },
        "right": {
          "operator": "tryAsUuid",
          "type": { "name": "uuid", "nullable": true },
          "operand": {
            "operator": "min",
            "type": { "name": "string" },
            "selector": { "source": "products", "field": "sku", "type": { "name": "string" } }
          }
        }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
  ]
}
