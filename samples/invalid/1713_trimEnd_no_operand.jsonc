// trimEnd with characters but without its operand
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimEnd",
        "type": { "name": "string" },
        "characters": { "type": { "name": "string" }, "value": "0" }
      }
    }
  ]
}
