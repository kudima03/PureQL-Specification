// average with a rounding mode
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "order_id",
      "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "value",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "mode": "halfEven"
      }
    }
  ]
}
