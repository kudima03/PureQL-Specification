// least of a field in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "least",
        "type": { "name": "integer" },
        "values": [
          { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "integer" }, "value": 100 }
        ]
      }
    }
  ]
}
