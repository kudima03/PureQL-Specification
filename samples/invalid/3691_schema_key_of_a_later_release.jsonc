// $schema naming a release that does not exist yet
{
  "$schema": "https://github.com/kudima03/PureQL-Specification/releases/download/9.9.9/PureQL-Specification.json",
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "total",
      "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
    }
  ]
}
