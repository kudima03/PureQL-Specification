// max declared boolean? over a boolean selector with a predicate declares the opposite nullability of boolean? in a
// grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "boolean" },
        "selector": { "type": { "name": "boolean" }, "value": true },
        "predicate": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
