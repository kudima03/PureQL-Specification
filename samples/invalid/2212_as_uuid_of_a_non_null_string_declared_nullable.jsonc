// asUuid of a non-null string declared uuid?: text that is not a uuid literal fails the query, it does not
// give null; that is tryAsUuid
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asUuid",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } }
      }
    }
  ]
}
