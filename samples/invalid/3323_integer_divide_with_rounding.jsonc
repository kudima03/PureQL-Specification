// integerDivide with a rounding rule: the quotient is truncated toward zero
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "type": { "name": "integer" }, "value": 2 },
        "rounding": "floor"
      }
    }
  ]
}
