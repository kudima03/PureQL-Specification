// add declared integer? has values of a type that does not fit in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "integer", "nullable": true },
        "values": [
          { "type": { "name": "string" }, "value": "a" },
          { "type": { "name": "integer", "nullable": true }, "value": null }
        ]
      }
    }
  ]
}
