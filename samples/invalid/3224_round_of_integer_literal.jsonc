// round of an integer literal: without digits round cannot change an integer
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
