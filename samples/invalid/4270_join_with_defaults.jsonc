// A left join with defaults for the fields of a missing row: a missing value is null, read with coalesce
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "left",
      "entity": "coupons",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "coupons", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "orders", "field": "coupon_id", "type": { "name": "uuid", "nullable": true } }
      },
      "defaults": [ { "alias": "code", "expression": { "type": { "name": "string" }, "value": "" } } ]
    }
  ],
  "select": [
    {
      "alias": "code",
      "expression": { "source": "coupons", "field": "code", "type": { "name": "string", "nullable": true } }
    }
  ]
}
