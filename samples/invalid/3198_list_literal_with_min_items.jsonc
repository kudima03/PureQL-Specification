// A list literal with a minItems of its own
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "list": { "type": { "name": "stringList" }, "value": [ "paid", "new" ], "minItems": 0 }
      }
    }
  ]
}
