// asNonNull is not an operator: nothing narrows a nullable value; a default is coalesce
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNonNull",
        "type": { "name": "date" },
        "operand": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        }
      }
    }
  ]
}
