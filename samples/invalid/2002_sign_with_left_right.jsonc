// sign with left and right: it takes one operand, the difference to classify
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sign",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "right": { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } }
      }
    }
  ]
}
