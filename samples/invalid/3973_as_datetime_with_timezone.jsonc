// asDatetime with timezone: the property is zone
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "timezone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
      }
    }
  ]
}
