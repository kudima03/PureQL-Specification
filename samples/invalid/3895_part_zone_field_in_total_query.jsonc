// year of an aggregate in a total query with a field as its zone
{
  "from": { "entity": "users" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "year",
        "type": { "name": "integer", "nullable": true },
        "operand": {
          "operator": "min",
          "type": { "name": "datetime", "nullable": true },
          "selector": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
        },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    }
  ]
}
