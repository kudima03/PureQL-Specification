// if declared datetime has else as a group key reference, which only a grouped select, having and orderBy have, in a
// plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "datetime" },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" },
        "else": { "key": "k", "type": { "name": "datetime" } }
      }
    }
  ]
}
