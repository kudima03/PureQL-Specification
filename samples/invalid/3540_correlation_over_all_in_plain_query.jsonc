// correlation with over "all" in a plain query, where over is only ever a window
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "correlation",
        "type": { "name": "decimal", "nullable": true },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "over": "all"
      }
    }
  ]
}
