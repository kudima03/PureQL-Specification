// abs of a date: it takes a number, and a difference of dates is one
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "abs",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
