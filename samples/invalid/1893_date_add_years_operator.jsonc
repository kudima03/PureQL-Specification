// dateAddYears is not an operator: a year is 12 months
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddYears",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
