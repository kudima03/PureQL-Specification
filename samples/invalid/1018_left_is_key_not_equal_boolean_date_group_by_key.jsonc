// notEqual declared boolean has left as a group key reference, which only a grouped select, having and orderBy have, in
// a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "notEqual",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "date" } },
        "right": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
