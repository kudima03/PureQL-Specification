// toTime of a date, which has no time of day
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toTime",
        "type": { "name": "time" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
