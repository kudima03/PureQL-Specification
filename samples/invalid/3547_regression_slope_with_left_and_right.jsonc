// regressionSlope with left and right: a line is not symmetric, and its operands are y and x
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "right": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
      }
    }
  ]
}
