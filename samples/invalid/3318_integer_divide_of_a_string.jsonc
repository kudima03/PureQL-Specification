// integerDivide of a string
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "left": { "type": { "name": "string" }, "value": "7.5" },
        "right": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
