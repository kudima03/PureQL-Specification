// asString of a string as a group key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "orders", "field": "status", "type": { "name": "string" } }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
