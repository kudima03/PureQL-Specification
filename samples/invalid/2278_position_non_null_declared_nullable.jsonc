// position in a non-null operand declared integer?: a pattern that does not occur gives 0, not null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "position",
        "type": { "name": "integer", "nullable": true },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": " " }
      }
    }
  ]
}
