// truncate of an integer with digits declared decimal
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "truncate",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    }
  ]
}
