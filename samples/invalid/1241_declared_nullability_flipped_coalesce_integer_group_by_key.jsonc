// coalesce declared integer declares the opposite nullability of integer in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "integer", "nullable": true },
        "values": [
          { "type": { "name": "integer", "nullable": true }, "value": null },
          { "type": { "name": "integer" }, "value": 7 }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
