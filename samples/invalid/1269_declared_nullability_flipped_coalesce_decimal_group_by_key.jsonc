// coalesce declared decimal declares the opposite nullability of decimal in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          { "type": { "name": "decimal", "nullable": true }, "value": null },
          { "type": { "name": "decimal" }, "value": "2.5" }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
