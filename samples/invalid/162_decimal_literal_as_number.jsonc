// decimal literal written as a JSON number: a decimal is a string, so every client reads it exactly
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
    "right": { "type": { "name": "decimal" }, "value": 19.99 }
  }
}
