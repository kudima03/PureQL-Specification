// integerList literal with a repeated value: a list literal is a set
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "source": "orders", "field": "n", "type": { "name": "integer" } },
    "list": { "type": { "name": "integerList" }, "value": [ 3, 5, 3 ] }
  }
}
