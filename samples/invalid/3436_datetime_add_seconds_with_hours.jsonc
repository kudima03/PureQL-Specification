// datetimeAddSeconds with hours instead of seconds: the amount is named by the unit the operator adds
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "hours": { "type": { "name": "integer" }, "value": 3 }
      }
    }
  ]
}
