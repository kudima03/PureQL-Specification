// greatest with the number 0 among its values: an operand is an expression, here a literal with its type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greatest",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
          0
        ]
      }
    }
  ]
}
