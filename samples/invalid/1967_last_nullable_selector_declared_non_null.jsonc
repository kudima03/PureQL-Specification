// last of a nullable selector declared date: the value of the last row is returned even when it is null
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "last",
        "type": { "name": "date" },
        "selector": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        },
        "orderBy": [
          { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    }
  ]
}
