// timeAddSeconds declared time declares the opposite nullability of time in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "time", "nullable": true },
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
