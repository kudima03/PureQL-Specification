// in over an empty list literal as a partition key
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "n",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            {
              "operator": "in",
              "type": { "name": "boolean" },
              "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
              "list": { "type": { "name": "stringList" }, "value": [] }
            }
          ]
        }
      }
    }
  ]
}
