// concatWith with a nullable separator: the separator is never null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "concatWith",
        "type": { "name": "string" },
        "values": [
          { "source": "users", "field": "first_name", "type": { "name": "string" } },
          { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } },
          { "source": "users", "field": "last_name", "type": { "name": "string" } }
        ],
        "separator": {
          "source": "users",
          "field": "nickname",
          "type": { "name": "string", "nullable": true }
        }
      }
    }
  ]
}
