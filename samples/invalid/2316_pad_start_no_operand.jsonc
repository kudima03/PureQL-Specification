// padStart without an operand
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "padStart",
        "type": { "name": "string" },
        "length": { "type": { "name": "integer" }, "value": 10 },
        "fill": { "type": { "name": "string" }, "value": " " }
      }
    }
  ]
}
