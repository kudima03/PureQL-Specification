// asDatetime in where with an aggregate as its zone
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
    "right": {
      "operator": "asDatetime",
      "type": { "name": "datetime" },
      "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
      "zone": {
        "operator": "min",
        "type": { "name": "string" },
        "selector": { "source": "orders", "field": "status", "type": { "name": "string" } }
      }
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
