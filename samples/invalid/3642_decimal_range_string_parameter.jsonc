// A range over a decimal key by a string parameter
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "orderBy": [
            {
              "expression": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
            }
          ],
          "range": { "preceding": { "param": "tolerance", "type": { "name": "string" } } }
        }
      }
    }
  ]
}
