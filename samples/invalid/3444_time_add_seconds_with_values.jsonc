// timeAddSeconds with a values array
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "time" },
        "values": [
          { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
          { "type": { "name": "integer" }, "value": 3 }
        ]
      }
    }
  ]
}
