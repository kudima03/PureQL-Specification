// asInteger with a values array
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asInteger",
        "type": { "name": "integer" },
        "values": [
          { "source": "users", "field": "tier", "type": { "name": "string" } },
          { "type": { "name": "string" }, "value": "0" }
        ]
      }
    }
  ]
}
