// datetimeAddSeconds declared datetime? has left as a group key reference, which only a grouped select, having and
// orderBy have, in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime", "nullable": true },
        "left": { "key": "k", "type": { "name": "datetime" } },
        "right": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
