// in declared boolean declares the opposite nullability of boolean in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean", "nullable": true },
        "operand": { "type": { "name": "date" }, "value": "2024-01-31" },
        "list": { "type": { "name": "dateList" }, "value": [ "2024-01-31", "2024-03-01" ] }
      }
    }
  ]
}
