// timeDiffSeconds declared decimal? has left as a group key reference, which only a grouped select, having and orderBy
// have, in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "timeDiffSeconds",
        "type": { "name": "decimal", "nullable": true },
        "left": { "key": "k", "type": { "name": "time", "nullable": true } },
        "right": { "type": { "name": "time" }, "value": "08:30:00" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
