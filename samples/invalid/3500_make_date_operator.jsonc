// makeDate is not an operator: it is dateFromParts
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "makeDate",
        "type": { "name": "date" },
        "year": {
          "operator": "year",
          "type": { "name": "integer" },
          "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "month": { "type": { "name": "integer" }, "value": 4 },
        "day": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
