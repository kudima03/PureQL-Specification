// notEqual declared boolean has no left in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "notEqual",
        "type": { "name": "boolean" },
        "right": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ]
}
