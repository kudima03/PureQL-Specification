// timeAddSeconds declared time has no declared type in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "timeAddSeconds",
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
