// ceiling declared integer declares another type than integer in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "ceiling",
        "type": { "name": "string" },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
