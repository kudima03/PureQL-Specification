// percentileContinuous with the fraction "0.50": a decimal literal has one spelling
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "percentileContinuous",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.50" }
      }
    }
  ]
}
