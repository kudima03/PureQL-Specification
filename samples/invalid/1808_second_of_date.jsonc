// second of a date: a date has no clock parts
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "second",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
