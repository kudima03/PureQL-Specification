// asString of a string literal: it takes every type but string, since asString of a string changes nothing
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "type": { "name": "string" }, "value": "paid" }
      }
    }
  ]
}
