// max declared boolean? over a boolean selector has a group key reference as its selector in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "boolean", "nullable": true },
        "selector": { "key": "k", "type": { "name": "boolean" } }
      }
    }
  ]
}
