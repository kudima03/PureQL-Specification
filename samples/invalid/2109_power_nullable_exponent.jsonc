// power with a nullable exponent: the exponent is never null, so that the result is nullable exactly when the
// operand is
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "power",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "exponent": { "param": "exponent", "type": { "name": "decimal", "nullable": true } }
      }
    }
  ]
}
