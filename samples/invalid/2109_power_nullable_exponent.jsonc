// power with a nullable exponent declared decimal: it is lifted over exponent as over operand, so the result
// is decimal?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "power",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "exponent": { "param": "exponent", "type": { "name": "decimal", "nullable": true } }
      }
    }
  ]
}
