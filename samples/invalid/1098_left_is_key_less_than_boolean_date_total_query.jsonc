// lessThan declared boolean has left as a group key reference, which only a grouped select, having and orderBy have, in
// a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "date" } },
        "right": { "type": { "name": "date" }, "value": "2024-03-01" }
      }
    }
  ]
}
