// splitPart with the number 1 as index
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "splitPart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "delimiter": { "type": { "name": "string" }, "value": " " },
        "index": 1
      }
    }
  ]
}
