// average with a predicate declared non-null in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": { "type": { "name": "decimal" }, "value": "2.5" },
        "predicate": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
