// regressionRSquared in a grouped query declared decimal: a group of one row has no line
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "k",
      "expression": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "regressionRSquared",
        "type": { "name": "decimal" },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ]
}
