// datetimeDiffMonths with a list of zones
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
        "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": [
          { "type": { "name": "string" }, "value": "Europe/Moscow" },
          { "type": { "name": "string" }, "value": "America/New_York" }
        ]
      }
    }
  ]
}
