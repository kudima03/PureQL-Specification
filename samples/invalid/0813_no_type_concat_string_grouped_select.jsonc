// concat declared string has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "concat",
        "values": [
          { "type": { "name": "string" }, "value": "a" },
          { "type": { "name": "string" }, "value": "b" }
        ]
      }
    }
  ]
}
