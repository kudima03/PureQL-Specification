// toDatetime of an aggregate in join.on, a row context without aggregates
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "greaterThanOrEqual",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "right": {
              "operator": "toDatetime",
              "type": { "name": "datetime" },
              "operand": {
                "operator": "min",
                "type": { "name": "date" },
                "selector": { "source": "users", "field": "birth_date", "type": { "name": "date" } }
              }
            }
          }
        ]
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
