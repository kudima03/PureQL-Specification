// if declared uuid has else as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "uuid" },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "uuid" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" },
        "else": { "source": "orders", "field": "f", "type": { "name": "uuid" } }
      }
    }
  ]
}
