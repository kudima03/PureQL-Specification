// padStart with a nullable length declared string: it is lifted over length as over operand, so the result is
// string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "padStart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "length": { "param": "width", "type": { "name": "integer", "nullable": true } },
        "fill": { "type": { "name": "string" }, "value": " " }
      }
    }
  ]
}
