// normalize of a uuid
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "form": "NFC"
      }
    }
  ]
}
