// multiply with a decimal in the middle declared integer
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "value",
      "expression": {
        "operator": "multiply",
        "type": { "name": "integer" },
        "values": [
          { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "decimal" }, "value": "1.5" },
          { "source": "order_items", "field": "returned_quantity", "type": { "name": "integer" } }
        ]
      }
    }
  ]
}
