// datetimeDiffMonths with a nullable operand, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
        "right": { "type": { "name": "datetime", "nullable": true }, "value": null }
      }
    }
  ]
}
