// lessThanOrEqual declared boolean has left as a group key reference, which only a grouped select, having and orderBy
// have, in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "lessThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "boolean" } },
        "right": { "type": { "name": "boolean" }, "value": false }
      }
    }
  ]
}
