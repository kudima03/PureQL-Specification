// trim of a nullable operand, declared non-null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trim",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } },
        "removables": [
          { "type": { "name": "string" }, "value": "0" },
          { "type": { "name": "string" }, "value": "0 " }
        ]
      }
    }
  ]
}
