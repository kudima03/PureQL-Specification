// max declared uuid? over a uuid selector with a predicate declares the opposite nullability of uuid? in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "uuid" },
        "selector": { "type": { "name": "uuid" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" },
        "predicate": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
