// substring with a string start: no implicit conversion to integer
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "substring",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "start": { "type": { "name": "string" }, "value": "2" }
      }
    }
  ]
}
