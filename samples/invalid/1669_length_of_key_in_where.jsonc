// length of a group key reference in where, which has no group keys
{
  "from": { "entity": "users" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "length",
      "type": { "name": "integer" },
      "operand": { "key": "name", "type": { "name": "string" } }
    },
    "right": { "type": { "name": "integer" }, "value": 3 }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
