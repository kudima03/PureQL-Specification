// datetimeAddMonths in a nullable zone declared datetime: the operator is lifted over its zone
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddMonths",
        "type": { "name": "datetime" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "months": { "type": { "name": "integer" }, "value": 1 },
        "zone": { "param": "zone", "type": { "name": "string", "nullable": true } }
      }
    }
  ]
}
