// coalesce declared integer declares the opposite nullability of integer in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "integer", "nullable": true },
        "values": [
          { "type": { "name": "integer", "nullable": true }, "value": null },
          { "type": { "name": "integer" }, "value": 7 }
        ]
      }
    }
  ]
}
