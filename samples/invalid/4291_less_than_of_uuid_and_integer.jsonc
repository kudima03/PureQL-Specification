// lessThan of a uuid and an integer: both operands of a comparison are one family, as in equal, though every
// type is ordered
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "lessThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
    "right": { "type": { "name": "integer" }, "value": 1 }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
