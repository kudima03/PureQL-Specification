// average declared date over a date selector declares the opposite nullability of date in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "date", "nullable": true },
        "selector": { "type": { "name": "date" }, "value": "2024-01-31" }
      }
    }
  ]
}
