// replace with the bare string " " as pattern: the pattern is an expression, here a literal with its type
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "replace",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": " ",
        "replacement": { "type": { "name": "string" }, "value": "_" }
      }
    }
  ]
}
