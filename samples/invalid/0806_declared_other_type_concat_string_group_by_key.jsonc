// concat declared string declares another type than string in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "concat",
        "type": { "name": "boolean" },
        "values": [
          { "type": { "name": "string" }, "value": "a" },
          { "type": { "name": "string" }, "value": "b" }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
