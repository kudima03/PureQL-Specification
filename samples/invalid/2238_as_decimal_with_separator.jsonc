// asDecimal with a decimal separator: the text is spelled as a decimal literal, with a point
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDecimal",
        "type": { "name": "decimal" },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } },
        "separator": { "type": { "name": "string" }, "value": "," }
      }
    }
  ]
}
