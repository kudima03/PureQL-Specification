// multiply with a boolean among its values
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "value",
      "expression": {
        "operator": "multiply",
        "type": { "name": "decimal" },
        "values": [
          { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "boolean" }, "value": true }
        ]
      }
    }
  ]
}
