// asDate of a group key in where, which is evaluated per row before grouping
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": {
      "operator": "asDate",
      "type": { "name": "date" },
      "operand": { "key": "ordered_at", "type": { "name": "datetime" } }
    },
    "right": { "param": "day", "type": { "name": "date" } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
