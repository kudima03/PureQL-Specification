// replaceRegex of an aggregate in join.on, a row context without aggregates
{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "kind": "inner",
      "entity": "products",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "asString",
          "type": { "name": "string" },
          "operand": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } }
        },
        "right": {
          "operator": "replaceRegex",
          "type": { "name": "string" },
          "operand": {
            "operator": "min",
            "type": { "name": "string" },
            "selector": { "source": "products", "field": "sku", "type": { "name": "string" } }
          },
          "pattern": { "type": { "name": "string" }, "value": "[^0-9a-f-]" },
          "replacement": { "type": { "name": "string" }, "value": "" }
        }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
  ]
}
