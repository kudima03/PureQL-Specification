// substring whose length is a group key in where, which is evaluated per row before grouping
{
  "from": { "entity": "users" },
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": {
      "operator": "substring",
      "type": { "name": "string", "nullable": true },
      "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } },
      "start": { "type": { "name": "integer" }, "value": 1 },
      "length": { "key": "letters", "type": { "name": "integer", "nullable": true } }
    },
    "right": { "type": { "name": "string" }, "value": "a" }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
