// tryParseDate declared date: it is null whenever the text is not a date literal, so it is always nullable
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "tryParseDate",
        "type": { "name": "date" },
        "operand": { "source": "users", "field": "tier", "type": { "name": "string" } }
      }
    }
  ]
}
