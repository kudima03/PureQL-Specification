// unionAll with an input that has no select
{
  "unionAll": [
    {
      "from": { "entity": "orders" },
      "select": [
        {
          "alias": "id",
          "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
        }
      ]
    },
    { "from": { "entity": "users" } }
  ]
}
