// trim with a field as characters in a total query, which reads fields only inside aggregates
{
  "from": { "entity": "users" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "trim",
        "type": { "name": "string" },
        "operand": { "type": { "name": "string" }, "value": " a " },
        "characters": { "source": "users", "field": "name", "type": { "name": "string" } }
      }
    }
  ]
}
