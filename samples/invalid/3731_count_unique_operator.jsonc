// countUnique is not an operator
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countUnique",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ]
}
