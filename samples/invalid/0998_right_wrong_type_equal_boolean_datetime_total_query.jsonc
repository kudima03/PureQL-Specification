// equal declared boolean has right of a type that does not fit in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" },
        "right": { "type": { "name": "date" }, "value": "2024-01-31" }
      }
    }
  ]
}
