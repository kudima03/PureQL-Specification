// datetimeAddSeconds declared datetime has no left in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime" },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
