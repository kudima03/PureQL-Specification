// coalesce declared date has two non-null operands, the second never reached in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "date" },
        "values": [
          { "type": { "name": "date" }, "value": "2024-01-31" },
          { "type": { "name": "date" }, "value": "2024-03-01" }
        ]
      }
    }
  ]
}
