// normalize whose form is a parameter: the form is part of the query
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
        "form": { "param": "form", "type": { "name": "string" } }
      }
    }
  ]
}
