// modulo by a string
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "decimal" },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "type": { "name": "string" }, "value": "1" }
      }
    }
  ]
}
