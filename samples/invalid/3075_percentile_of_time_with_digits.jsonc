// percentileContinuous of a time with digits: a temporal mean is rounded to the precision of its type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "percentileContinuous",
        "type": { "name": "time" },
        "selector": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.5" },
        "digits": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
