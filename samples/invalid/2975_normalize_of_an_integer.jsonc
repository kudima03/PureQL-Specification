// normalize of an integer
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string" },
        "operand": { "type": { "name": "integer" }, "value": 7 },
        "form": "NFC"
      }
    }
  ]
}
