// max declared boolean over a boolean selector declares the opposite nullability of boolean in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "boolean", "nullable": true },
        "selector": { "type": { "name": "boolean" }, "value": true }
      }
    }
  ]
}
