// trimEnd with integer characters: characters is a string
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimEnd",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "characters": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
