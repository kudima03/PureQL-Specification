// arctan2 is not an operator: it is atan2
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "arctan2",
        "type": { "name": "decimal" },
        "y": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "x": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
