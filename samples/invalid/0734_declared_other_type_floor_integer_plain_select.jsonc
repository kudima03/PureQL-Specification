// floor declared integer declares another type than integer in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "string" },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
