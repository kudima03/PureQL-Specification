// time literal with a one-digit minute
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "window_start", "type": { "name": "time" } },
    "right": { "type": { "name": "time" }, "value": "12:3:00" }
  }
}
