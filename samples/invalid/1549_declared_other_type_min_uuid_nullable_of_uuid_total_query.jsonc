// min declared uuid? over a uuid selector declares another type than uuid? in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "min",
        "type": { "name": "string", "nullable": true },
        "selector": { "type": { "name": "uuid" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" }
      }
    }
  ]
}
