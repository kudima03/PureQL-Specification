// divide declared decimal has no declared type in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "divide",
        "values": [
          { "type": { "name": "integer" }, "value": 7 },
          { "type": { "name": "decimal" }, "value": "2.5" }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
