// modulo declared integer? has left as a group key reference, which only a grouped select, having and orderBy have, in a
// plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "integer", "nullable": true },
        "left": { "key": "k", "type": { "name": "integer", "nullable": true } },
        "right": { "type": { "name": "integer" }, "value": -3 }
      }
    }
  ]
}
