// if declared time declares the opposite nullability of time in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "if",
        "type": { "name": "time", "nullable": true },
        "condition": { "type": { "name": "boolean" }, "value": true },
        "then": { "type": { "name": "time" }, "value": "08:30:00" },
        "else": { "type": { "name": "time" }, "value": "17:45:30.5" }
      }
    }
  ]
}
