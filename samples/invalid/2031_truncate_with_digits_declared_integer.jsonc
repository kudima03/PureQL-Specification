// truncate with digits declared integer: with digits it keeps decimal places, so it is decimal
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "truncate",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
