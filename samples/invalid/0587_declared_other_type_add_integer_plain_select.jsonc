// add declared integer declares another type than integer in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "string" },
        "values": [
          { "type": { "name": "integer" }, "value": 7 },
          { "type": { "name": "integer" }, "value": -3 }
        ]
      }
    }
  ]
}
