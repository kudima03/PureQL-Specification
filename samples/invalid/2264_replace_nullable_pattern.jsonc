// replace with a nullable pattern declared string: it is lifted over pattern as over operand, so the result
// is string?
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "replace",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } },
        "replacement": { "type": { "name": "string" }, "value": "_" }
      }
    }
  ]
}
