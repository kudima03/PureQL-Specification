// asNullable of a null literal
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNullable",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "type": { "name": "uuid", "nullable": true }, "value": null }
      }
    }
  ]
}
