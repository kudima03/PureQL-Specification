// datetimeFromParts whose time is a datetime: its time of day is asTime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "time": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    }
  ]
}
