// lessThanOrEqual of a nullable date and a nullable datetime: both operands of a comparison are one family, as
// in equal, though every type is ordered
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "left",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "lessThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
    "right": { "source": "users", "field": "last_login_at", "type": { "name": "datetime", "nullable": true } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
