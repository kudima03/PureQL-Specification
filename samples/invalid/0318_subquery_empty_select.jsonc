// A subquery with no select columns
{
  "subqueries": [{ "name": "recent", "query": { "from": { "entity": "orders" }, "select": [] } }],
  "from": { "subquery": "recent" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "recent", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
