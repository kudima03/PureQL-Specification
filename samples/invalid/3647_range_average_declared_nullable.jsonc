// average of a non-null selector over a range declared decimal?: the current row is always in its range
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "order_date", "type": { "name": "date" } } }
          ],
          "range": { "preceding": { "days": 29 } }
        }
      }
    }
  ]
}
