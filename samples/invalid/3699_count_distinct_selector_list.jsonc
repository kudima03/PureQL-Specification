// countDistinct with a list as its selector
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "selector": [
          { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
          { "source": "orders", "field": "status", "type": { "name": "string" } }
        ]
      }
    }
  ]
}
