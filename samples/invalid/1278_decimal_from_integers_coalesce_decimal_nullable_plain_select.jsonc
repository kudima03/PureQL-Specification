// coalesce declared decimal? declares decimal with integer operands only in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          { "type": { "name": "integer", "nullable": true }, "value": null },
          { "type": { "name": "integer", "nullable": true }, "value": null }
        ]
      }
    }
  ]
}
