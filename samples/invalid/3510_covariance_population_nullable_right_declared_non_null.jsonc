// covariancePopulation with a nullable right declared decimal
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "covariancePopulation",
        "type": { "name": "decimal" },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "param": "discount", "type": { "name": "decimal", "nullable": true } }
      }
    }
  ]
}
