// median of an aggregate: the selector is a row expression, so aggregates cannot nest
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "median",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "sum",
          "type": { "name": "decimal" },
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      }
    }
  ]
}
