// asDecimal of an integerList: a list is accepted only by in
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDecimal",
        "type": { "name": "decimal" },
        "operand": { "type": { "name": "integerList" }, "value": [ 1, 2 ] }
      }
    }
  ]
}
