// datetimeFromParts with a nullable time declared non-null: it is lifted over every part
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "users", "field": "birth_date", "type": { "name": "date" } },
        "time": { "type": { "name": "time", "nullable": true }, "value": null }
      }
    }
  ]
}
