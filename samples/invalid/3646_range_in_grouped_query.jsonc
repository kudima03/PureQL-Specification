// A range in a grouped query, where over is only "all"
{
  "from": { "entity": "orders" },
  "groupBy": [
    { "alias": "k", "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "orderBy": [
            { "expression": { "source": "orders", "field": "order_date", "type": { "name": "date" } } }
          ],
          "range": { "preceding": { "days": 29 } }
        }
      }
    }
  ]
}
