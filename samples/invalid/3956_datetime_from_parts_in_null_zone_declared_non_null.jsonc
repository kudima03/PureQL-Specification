// datetimeFromParts in a null zone declared datetime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "zone": { "type": { "name": "string", "nullable": true }, "value": null }
      }
    }
  ]
}
