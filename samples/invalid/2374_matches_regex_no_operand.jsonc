// matchesRegex without an operand
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "pattern": { "type": { "name": "string" }, "value": "^[^@]+@[^@]+$" }
      }
    }
  ]
}
