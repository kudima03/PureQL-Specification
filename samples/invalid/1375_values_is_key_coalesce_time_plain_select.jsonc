// coalesce declared time has values as a group key reference, which only a grouped select, having and orderBy have, in a
// plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "time" },
        "values": [
          { "key": "k", "type": { "name": "time", "nullable": true } },
          { "type": { "name": "time" }, "value": "08:30:00" }
        ]
      }
    }
  ]
}
