// fractionalPart is not an operator: it is modulo by 1
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "fractionalPart",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
      }
    }
  ]
}
