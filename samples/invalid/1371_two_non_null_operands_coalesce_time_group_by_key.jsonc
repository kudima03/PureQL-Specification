// coalesce declared time has two non-null operands, the second never reached in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "time" },
        "values": [
          { "type": { "name": "time" }, "value": "08:30:00" },
          { "type": { "name": "time" }, "value": "17:45:30.5" }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
