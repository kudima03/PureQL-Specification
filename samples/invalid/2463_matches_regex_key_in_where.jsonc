// matchesRegex of a group key in where, which is evaluated per row before grouping
{
  "from": { "entity": "users" },
  "where": {
    "operator": "matchesRegex",
    "type": { "name": "boolean" },
    "operand": { "key": "email", "type": { "name": "string" } },
    "pattern": { "type": { "name": "string" }, "value": "@" }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
