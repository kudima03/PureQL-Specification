// greaterThanOrEqual declared boolean has left as a group key reference, which only a grouped select, having and orderBy
// have, in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "uuid" } },
        "right": { "type": { "name": "uuid" }, "value": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
