// greatest with a predicate: it is not an aggregate, and compares the values of one row
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greatest",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "source": "orders", "field": "credit_limit", "type": { "name": "decimal" } },
          { "type": { "name": "integer" }, "value": 0 }
        ],
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    }
  ]
}
