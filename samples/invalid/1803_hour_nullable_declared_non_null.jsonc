// hour of a nullable operand, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "hour",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "datetime", "nullable": true }, "value": null }
      }
    }
  ]
}
