// round of an integer with nullable digits declared decimal?
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "param": "digits", "type": { "name": "integer", "nullable": true } }
      }
    }
  ]
}
