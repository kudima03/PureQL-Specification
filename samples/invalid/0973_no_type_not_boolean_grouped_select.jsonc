// not declared boolean has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": { "operator": "not", "condition": { "type": { "name": "boolean" }, "value": true } }
    }
  ]
}
