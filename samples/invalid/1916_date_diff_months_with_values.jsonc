// dateDiffMonths with `values` instead of left / right
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffMonths",
        "type": { "name": "integer" },
        "values": [
          { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          { "param": "today", "type": { "name": "date" } }
        ]
      }
    }
  ]
}
