// in declared boolean has operand as a field, which this context has no rows to read from, in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "f", "type": { "name": "time" } },
        "list": { "type": { "name": "timeList" }, "value": [ "08:30:00", "17:45:30.5" ] }
      }
    }
  ]
}
