// max declared string over a string selector has a group key reference as its selector in a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "string" },
        "selector": { "key": "k", "type": { "name": "string" } }
      }
    }
  ]
}
