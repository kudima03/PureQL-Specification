// upper of a non-null operand, declared nullable: a lifted operator is nullable exactly when an operand is
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "upper",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } }
      }
    }
  ]
}
