// dateDiffYears is not an operator: whole years are integerDivide of the months by 12
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffYears",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "param": "today", "type": { "name": "date" } }
      }
    }
  ]
}
