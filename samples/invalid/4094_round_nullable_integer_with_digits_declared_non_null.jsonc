// round of a nullable integer with digits declared integer
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "param": "units", "type": { "name": "integer", "nullable": true } },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    }
  ]
}
