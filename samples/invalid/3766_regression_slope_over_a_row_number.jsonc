// regressionSlope over a window function: its operands are row expressions
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": {
          "operator": "rowNumber",
          "type": { "name": "integer" },
          "over": {
            "orderBy": [
              { "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } } }
            ]
          }
        }
      }
    }
  ]
}
