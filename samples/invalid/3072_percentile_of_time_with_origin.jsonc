// percentileContinuous of a time with an origin: the result does not depend on a day that time is counted
// from
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "percentileContinuous",
        "type": { "name": "time" },
        "selector": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.5" },
        "origin": { "type": { "name": "date" }, "value": "1970-01-01" }
      }
    }
  ]
}
