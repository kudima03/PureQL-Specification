// divide declared decimal has no declared type in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "divide",
        "values": [
          { "type": { "name": "integer" }, "value": 7 },
          { "type": { "name": "decimal" }, "value": "2.5" }
        ]
      }
    }
  ]
}
