// trimStart with a nullable removable: a removable is never null
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "trimStart",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "removables": [
          { "type": { "name": "string" }, "value": "0" },
          { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } }
        ]
      }
    }
  ]
}
