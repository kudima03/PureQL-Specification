// contains with a regex flag: its pattern is literal text; a regular expression is matched with matchesRegex
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "contains",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "@" },
        "regex": true
      }
    }
  ]
}
