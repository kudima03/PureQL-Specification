// average of a nullIf selector declared decimal: the selector is nullable, so every value of a group may be
// null
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "status",
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "nullIf",
          "type": { "name": "decimal", "nullable": true },
          "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "right": { "type": { "name": "integer" }, "value": 0 }
        }
      }
    }
  ]
}
