// A group key that names a select column
{
  "from": { "entity": "orders" },
  "groupBy": [ { "alias": "user_id", "column": "user_id" } ],
  "select": [
    { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } },
    {
      "alias": "revenue",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "paid_revenue",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    },
    { "alias": "orders", "expression": { "operator": "count", "type": { "name": "integer" } } },
    {
      "alias": "average_order",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal" },
        "values": [
          {
            "operator": "sum",
            "type": { "name": "decimal" },
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          },
          { "operator": "count", "type": { "name": "integer" } }
        ]
      }
    }
  ],
  "orderBy": [
    { "column": "paid_revenue", "direction": "desc" },
    { "column": "average_order", "direction": "desc" },
    { "column": "user_id" }
  ],
  "pagination": { "take": 10 }
}
