// dateAddMonths without the number of months
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddMonths",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
