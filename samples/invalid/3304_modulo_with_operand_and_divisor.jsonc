// modulo with operand and divisor instead of left and right
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "divisor": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
