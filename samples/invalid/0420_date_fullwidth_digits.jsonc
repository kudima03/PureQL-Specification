// date literal with fullwidth digits: patterns accept ASCII [0-9] only, and nothing around the value
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": { "type": { "name": "date" }, "value": "２０２４-０１-０１" }
  }
}
