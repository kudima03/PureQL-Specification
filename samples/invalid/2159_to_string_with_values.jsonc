// toString with a values array: it takes one operand; several are joined with concat
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "toString",
        "type": { "name": "string" },
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        ]
      }
    }
  ]
}
