// contains with a string list as pattern: a list is accepted only by in
{
  "from": { "entity": "users" },
  "where": {
    "operator": "contains",
    "type": { "name": "boolean" },
    "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
    "pattern": { "type": { "name": "stringList" }, "value": [ "abc", "def" ] }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
  ]
}
