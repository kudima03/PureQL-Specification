// normalize without a form: there is no default form, a query names the one it compares in
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } }
      }
    }
  ]
}
