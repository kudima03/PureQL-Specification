// A label on a column: a column has an alias and an expression
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
      "label": "Order"
    },
    {
      "alias": "total",
      "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
    }
  ]
}
