// in whose list is a scalar string parameter
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "source": "orders", "field": "f", "type": { "name": "string" } },
    "list": { "param": "p", "type": { "name": "string" } }
  }
}
