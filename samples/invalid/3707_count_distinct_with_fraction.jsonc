// countDistinct with a fraction
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "countDistinct",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "fraction": { "type": { "name": "decimal" }, "value": "0.5" }
      }
    }
  ]
}
