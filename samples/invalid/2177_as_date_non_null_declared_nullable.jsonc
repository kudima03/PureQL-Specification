// asDate of a non-null operand declared date?
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date", "nullable": true },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    }
  ]
}
