// max declared date over a date selector has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": { "operator": "max", "selector": { "type": { "name": "date" }, "value": "2024-01-31" } }
    }
  ]
}
