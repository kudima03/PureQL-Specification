// greaterThanOrEqual of a null date and a null datetime: two nulls are compared only within one type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "type": { "name": "date", "nullable": true }, "value": null },
        "right": { "type": { "name": "datetime", "nullable": true }, "value": null }
      }
    }
  ]
}
