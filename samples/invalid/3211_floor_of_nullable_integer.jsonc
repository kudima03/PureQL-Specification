// floor of a nullable integer: an integer is a whole number already, so floor cannot change it
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer", "nullable": true },
        "operand": { "param": "units", "type": { "name": "integer", "nullable": true } }
      }
    }
  ]
}
