// An empty dateList literal: a list literal has at least one value; a set that may be empty is a list
// parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "date" }, "value": "2024-01-31" },
        "list": { "type": { "name": "dateList" }, "value": [] }
      }
    }
  ]
}
