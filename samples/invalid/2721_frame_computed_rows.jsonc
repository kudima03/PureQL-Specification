// A frame whose number of rows is computed: it is a number or a parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ],
          "frame": {
            "preceding": {
              "operator": "add",
              "type": { "name": "integer" },
              "values": [
                { "type": { "name": "integer" }, "value": 1 },
                { "type": { "name": "integer" }, "value": 2 }
              ]
            }
          }
        }
      }
    }
  ]
}
