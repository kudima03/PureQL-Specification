// max declared date? over a date selector declares another type than date? in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "string", "nullable": true },
        "selector": { "type": { "name": "date", "nullable": true }, "value": null }
      }
    }
  ]
}
