// asBoolean is not an operator: a number becomes a condition with a comparison
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asBoolean",
        "type": { "name": "boolean" },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ]
}
