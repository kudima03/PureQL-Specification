// timeAddSeconds declared time has no declared type in a grouped select
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeAddSeconds",
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "decimal" }, "value": "2.5" }
      }
    }
  ]
}
