// notEqual declared boolean has left as a group key reference, which only a grouped select, having and orderBy have, in
// a plain select
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "notEqual",
        "type": { "name": "boolean" },
        "left": { "key": "k", "type": { "name": "boolean" } },
        "right": { "type": { "name": "boolean" }, "value": false }
      }
    }
  ]
}
