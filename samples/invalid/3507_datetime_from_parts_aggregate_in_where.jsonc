// datetimeFromParts of an aggregate in where, a row context without aggregates
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "lessThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
    "right": {
      "operator": "datetimeFromParts",
      "type": { "name": "datetime" },
      "date": {
        "operator": "max",
        "type": { "name": "date" },
        "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      },
      "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
