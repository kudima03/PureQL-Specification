// timeDiffSeconds declared decimal declares another type than decimal in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "timeDiffSeconds",
        "type": { "name": "string" },
        "left": { "type": { "name": "time" }, "value": "08:30:00" },
        "right": { "type": { "name": "time" }, "value": "17:45:30.5" }
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
