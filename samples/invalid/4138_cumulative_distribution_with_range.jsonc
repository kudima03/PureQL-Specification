// cumulativeDistribution with a range: a ranking function takes an order and neither a frame nor a range
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "cumulativeDistribution",
        "type": { "name": "decimal" },
        "over": {
          "orderBy": [ { "expression": { "source": "orders", "field": "order_date", "type": { "name": "date" } } } ],
          "range": { "preceding": { "days": 1 } }
        }
      }
    }
  ]
}
