// asNullable with a default: a default for a null is coalesce
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "asNullable",
        "type": { "name": "uuid", "nullable": true },
        "operand": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } },
        "default": { "source": "order_items", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
