// and declared boolean has no declared type in a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "k",
      "expression": {
        "operator": "and",
        "conditions": [
          { "type": { "name": "boolean" }, "value": true },
          { "type": { "name": "boolean" }, "value": false }
        ]
      }
    }
  ],
  "select": [ { "alias": "n", "expression": { "operator": "count", "type": { "name": "integer" } } } ]
}
