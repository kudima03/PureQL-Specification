// average declared time? over a time selector declares another type than time? in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "string", "nullable": true },
        "selector": { "type": { "name": "time" }, "value": "08:30:00" }
      }
    }
  ]
}
