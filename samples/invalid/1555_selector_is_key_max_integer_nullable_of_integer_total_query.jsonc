// max declared integer? over a integer selector has a group key reference as its selector in a total query
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "c",
      "expression": {
        "operator": "max",
        "type": { "name": "integer", "nullable": true },
        "selector": { "key": "k", "type": { "name": "integer" } }
      }
    }
  ]
}
