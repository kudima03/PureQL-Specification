// modulo of decimals with a values array: it takes left and right
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "modulo",
        "type": { "name": "decimal" },
        "values": [
          { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
