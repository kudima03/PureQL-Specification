// dateDiffMonths without its right operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffMonths",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
