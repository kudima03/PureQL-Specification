// floor of an integer literal: an integer is a whole number already, so floor cannot change it
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "integer" }, "value": 7 }
      }
    }
  ]
}
