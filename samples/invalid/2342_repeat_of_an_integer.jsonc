// repeat of an integer
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "repeat",
        "type": { "name": "string" },
        "operand": { "type": { "name": "integer" }, "value": 7 },
        "count": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
