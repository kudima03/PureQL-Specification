{
  "from": { "entity": "orders" },
  "groupBy": [{ "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
  "having": {
    "operator": "greaterThanOrEqual",
    "left": { "operator": "count", "over": "group" },
    "right": { "type": { "name": "integer" }, "value": 5 }
  },
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } },
    {
      "alias": "orders",
      "type": { "name": "integer" },
      "expression": { "operator": "count", "over": "group" }
    }
  ]
}
