{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    },
    {
      "alias": "amount",
      "type": { "name": "decimal" },
      "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
    }
  ],
  "where": {
    "operator": "and",
    "conditions": [
      {
        "operator": "equal",
        "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "right": { "type": { "name": "string" }, "value": "completed" }
      },
      {
        "operator": "greaterThan",
        "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "right": { "param_name": "min_total", "type": { "name": "decimal" } }
      }
    ]
  },
  "orderBy": [
    {
      "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
      "direction": "desc"
    },
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "pagination": { "skip": 0, "take": 20 }
}
