{
  "from": { "entity": "orders" },
  "joins": [
    {
      "type": "left",
      "entity": "coupons",
      "on": {
        "operator": "equal",
        "left": { "source": "orders", "field": "coupon_id", "type": { "name": "uuid", "nullable": true } },
        "right": { "source": "coupons", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    },
    {
      "alias": "coupon_code",
      "type": { "name": "string" },
      "expression": {
        "operator": "coalesce",
        "values": [
          { "source": "coupons", "field": "code", "type": { "name": "string", "nullable": true } },
          { "type": { "name": "string" }, "value": "none" }
        ]
      }
    },
    {
      "alias": "total_after_discount",
      "type": { "name": "decimal", "nullable": true },
      "expression": {
        "operator": "subtract",
        "values": [
          { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          { "source": "coupons", "field": "discount", "type": { "name": "decimal", "nullable": true } }
        ]
      }
    }
  ],
  "where": {
    "operator": "or",
    "conditions": [
      {
        "operator": "equal",
        "left": { "source": "orders", "field": "coupon_id", "type": { "name": "uuid", "nullable": true } },
        "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
      },
      {
        "operator": "greaterThan",
        "left": { "source": "coupons", "field": "discount", "type": { "name": "decimal", "nullable": true } },
        "right": { "type": { "name": "integer" }, "value": 10 }
      }
    ]
  }
}
