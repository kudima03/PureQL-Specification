        "operator": "equal",
        "type": {
          "name": "boolean"
        },
        "left": {
          "source": "orders",
          "field": "coupon_id",
          "type": {
            "name": "uuid",
            "nullable": true
          }
        },
        "right": {
          "source": "coupons",
          "field": "id",
          "type": {
            "name": "uuid"
          }
        }
      }
    }
  ],
  "groupBy": [
    {
      "alias": "coupon_code",
      "expression": {
        "source": "coupons",
        "field": "code",
        "type": {
          "name": "string",
          "nullable": true
        }
      }
    }
  ],
  "select": [
    {
      "alias": "coupon_code",
      "expression": {
        "key": "coupon_code",
        "type": {
          "name": "string",
          "nullable": true
        }
      }
    },
    {
      "alias": "last_order_at",
      "expression": {
        "operator": "max",
        "type": {
          "name": "datetime"
        },
        "selector": {
          "source": "orders",
          "field": "ordered_at",
          "type": {
            "name": "datetime"
          }
        }
      }
    },
    {
      "alias": "avg_order_at",
      "expression": {
        "operator": "average",
        "type": {
          "name": "datetime"
        },
        "selector": {
          "source": "orders",
          "field": "ordered_at",
          "type": {
            "name": "datetime"
          }
        }
      }
    },
    {
      "alias": "min_paid_total",
      "expression": {
        "operator": "coalesce",
        "type": {
          "name": "decimal"
        },
        "values": [
          {
            "operator": "min",
            "type": {
              "name": "decimal",
              "nullable": true
            },
            "selector": {
              "source": "orders",
              "field": "total",
              "type": {
                "name": "decimal"
              }
            },
            "predicate": {
              "source": "orders",
              "field": "is_paid",
              "type": {
                "name": "boolean"
              }
            }
          },
          {
            "type": {
              "name": "integer"
            },
            "value": 0
          }
        ]
      }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": {
      "name": "boolean"
    },
    "left": {
      "operator": "max",
      "type": {
        "name": "datetime"
      },
      "selector": {
        "source": "orders",
        "field": "ordered_at",
        "type": {
          "name": "datetime"
        }
      }
    },
    "right": {
      "param": "since",
      "type": {
        "name": "datetime"
      }
    }
  },
  "orderBy": [
    {
      "expression": {
        "key": "coupon_code",
        "type": {
          "name": "string",
          "nullable": true
        }
      }
    }
  ]
