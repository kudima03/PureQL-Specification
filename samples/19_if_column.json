{
  "from": {
    "entity": "orders"
  },
  "select": [
    {
      "alias": "id",
      "expression": {
        "source": "orders",
        "field": "id",
        "type": {
          "name": "uuid"
        }
      }
    },
    {
      "alias": "size",
      "expression": {
        "operator": "if",
        "type": {
          "name": "string"
        },
        "condition": {
          "operator": "greaterThan",
          "type": {
            "name": "boolean"
          },
          "left": {
            "source": "orders",
            "field": "total",
            "type": {
              "name": "decimal"
            }
          },
          "right": {
            "type": {
              "name": "integer"
            },
            "value": 100
          }
        },
        "then": {
          "type": {
            "name": "string"
          },
          "value": "large"
        },
        "else": {
          "type": {
            "name": "string"
          },
          "value": "small"
        }
      }
    },
    {
      "alias": "discount",
      "expression": {
        "operator": "if",
        "type": {
          "name": "decimal"
        },
        "condition": {
          "source": "orders",
          "field": "is_vip",
          "type": {
            "name": "boolean"
          }
        },
        "then": {
          "operator": "multiply",
          "type": {
            "name": "decimal"
          },
          "values": [
            {
              "source": "orders",
              "field": "total",
              "type": {
                "name": "decimal"
              }
            },
            {
              "type": {
                "name": "decimal"
              },
              "value": 0.1
            }
          ]
        },
        "else": {
          "type": {
            "name": "integer"
          },
          "value": 0
        }
      }
    }
  ]
}
