{
  "from": { "entity": "order_items" },
  "joins": [
    {
      "type": "inner",
      "entity": "orders",
      "on": {
        "operator": "equal",
        "left": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } },
        "right": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "equal",
    "left": {
      "operator": "modulo",
      "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
      "right": { "type": { "name": "integer" }, "value": 2 }
    },
    "right": { "type": { "name": "integer" }, "value": 0 }
  },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } },
    {
      "alias": "units",
      "type": { "name": "integer" },
      "expression": {
        "operator": "sum",
        "over": "group",
        "selector": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "revenue",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "round",
        "value": {
          "operator": "sum",
          "over": "group",
          "selector": {
            "operator": "multiply",
            "values": [
              { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
              { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
            ]
          }
        },
        "digits": { "type": { "name": "integer" }, "value": 2 }
      }
    },
    {
      "alias": "tens_of_lines",
      "type": { "name": "integer" },
      "expression": {
        "operator": "integerDivide",
        "left": { "operator": "count", "over": "group" },
        "right": { "type": { "name": "integer" }, "value": 10 }
      }
    },
    {
      "alias": "reorder_estimate",
      "type": { "name": "date" },
      "expression": {
        "operator": "dateAddDays",
        "left": {
          "operator": "max",
          "over": "group",
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "right": {
          "operator": "floor",
          "value": {
            "operator": "average",
            "over": "group",
            "selector": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          }
        }
      }
    }
  ]
}
