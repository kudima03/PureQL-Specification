{
  "from": {
    "entity": "order_items"
  },
  "joins": [
    {
      "type": "inner",
      "entity": "orders",
      "on": {
        "operator": "equal",
        "left": {
          "source": "order_items",
          "field": "order_id",
          "type": {
            "name": "uuid"
          }
        },
        "right": {
          "source": "orders",
          "field": "id",
          "type": {
            "name": "uuid"
          }
        }
      }
    },
    {
      "type": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "left": {
          "source": "orders",
          "field": "user_id",
          "type": {
            "name": "uuid"
          }
        },
        "right": {
          "source": "users",
          "field": "id",
          "type": {
            "name": "uuid"
          }
        }
      }
    },
    {
      "type": "left",
      "entity": "products",
      "on": {
        "operator": "equal",
        "left": {
          "source": "order_items",
          "field": "product_id",
          "type": {
            "name": "uuid"
          }
        },
        "right": {
          "source": "products",
          "field": "id",
          "type": {
            "name": "uuid"
          }
        }
      }
    }
  ],
  "select": [
    {
      "alias": "email",
      "type": {
        "name": "string"
      },
      "expression": {
        "source": "users",
        "field": "email",
        "type": {
          "name": "string"
        }
      }
    },
    {
      "alias": "order_id",
      "type": {
        "name": "uuid"
      },
      "expression": {
        "source": "orders",
        "field": "id",
        "type": {
          "name": "uuid"
        }
      }
    },
    {
      "alias": "product",
      "type": {
        "name": "string",
        "nullable": true
      },
      "expression": {
        "source": "products",
        "field": "name",
        "type": {
          "name": "string",
          "nullable": true
        }
      }
    },
    {
      "alias": "quantity",
      "type": {
        "name": "integer"
      },
      "expression": {
        "source": "order_items",
        "field": "quantity",
        "type": {
          "name": "integer"
        }
      }
    }
  ]
}
