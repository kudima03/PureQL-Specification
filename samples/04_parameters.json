{
  "from": {
    "entity": "orders"
  },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": {
      "name": "boolean"
    },
    "left": {
      "source": "orders",
      "field": "ordered_at",
      "type": {
        "name": "datetime"
      }
    },
    "right": {
      "param_name": "since",
      "type": {
        "name": "datetime"
      }
    }
  },
  "select": [
    {
      "alias": "id",
      "expression": {
        "source": "orders",
        "field": "id",
        "type": {
          "name": "uuid"
        }
      }
    },
    {
      "alias": "report_currency",
      "expression": {
        "param_name": "currency",
        "type": {
          "name": "string"
        }
      }
    }
  ]
}
