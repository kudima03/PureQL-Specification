{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } }
    },
    {
      "alias": "line_total",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "multiply",
        "values": [
          { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
        ]
      }
    },
    {
      "alias": "half_quantity",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "divide",
        "values": [
          { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "integer" }, "value": 2 }
        ]
      }
    },
    {
      "alias": "price_with_tax",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "multiply",
        "values": [
          { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          { "type": { "name": "decimal" }, "value": 1.2 }
        ]
      }
    }
  ]
}
