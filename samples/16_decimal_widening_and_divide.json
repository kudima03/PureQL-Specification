{
  "from": {
    "entity": "order_items"
  },
  "select": [
    {
      "alias": "id",
      "expression": {
        "source": "order_items",
        "field": "id",
        "type": {
          "name": "uuid"
        }
      }
    },
    {
      "alias": "line_total",
      "expression": {
        "operator": "multiply",
        "type": {
          "name": "decimal"
        },
        "values": [
          {
            "source": "order_items",
            "field": "unit_price",
            "type": {
              "name": "decimal"
            }
          },
          {
            "source": "order_items",
            "field": "quantity",
            "type": {
              "name": "integer"
            }
          }
        ]
      }
    },
    {
      "alias": "half_quantity",
      "expression": {
        "operator": "divide",
        "type": {
          "name": "decimal"
        },
        "values": [
          {
            "source": "order_items",
            "field": "quantity",
            "type": {
              "name": "integer"
            }
          },
          {
            "type": {
              "name": "integer"
            },
            "value": 2
          }
        ]
      }
    },
    {
      "alias": "price_with_tax",
      "expression": {
        "operator": "multiply",
        "type": {
          "name": "decimal"
        },
        "values": [
          {
            "source": "order_items",
            "field": "unit_price",
            "type": {
              "name": "decimal"
            }
          },
          {
            "type": {
              "name": "decimal"
            },
            "value": 1.2
          }
        ]
      }
    }
  ]
}
