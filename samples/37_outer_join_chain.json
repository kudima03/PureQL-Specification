{
  "from": {
    "entity": "orders"
  },
  "joins": [
    {
      "kind": "left",
      "entity": "coupons",
      "on": {
        "operator": "equal",
        "type": {
          "name": "boolean"
        },
        "left": {
          "source": "orders",
          "field": "coupon_id",
          "type": {
            "name": "uuid",
            "nullable": true
          }
        },
        "right": {
          "source": "coupons",
          "field": "id",
          "type": {
            "name": "uuid"
          }
        }
      }
    },
    {
      "kind": "left",
      "entity": "users",
      "alias": "issuer",
      "on": {
        "operator": "equal",
        "type": {
          "name": "boolean"
        },
        "left": {
          "source": "coupons",
          "field": "issued_by",
          "type": {
            "name": "uuid",
            "nullable": true
          }
        },
        "right": {
          "source": "issuer",
          "field": "id",
          "type": {
            "name": "uuid"
          }
        }
      }
    }
  ],
  "select": [
    {
      "alias": "order_id",
      "expression": {
        "source": "orders",
        "field": "id",
        "type": {
          "name": "uuid"
        }
      }
    },
    {
      "alias": "coupon",
      "expression": {
        "source": "coupons",
        "field": "code",
        "type": {
          "name": "string",
          "nullable": true
        }
      }
    },
    {
      "alias": "issued_by",
      "expression": {
        "source": "issuer",
        "field": "name",
        "type": {
          "name": "string",
          "nullable": true
        }
      }
    }
  ]
}
