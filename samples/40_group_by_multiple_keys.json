{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    },
    {
      "type": { "name": "string" },
      "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
    }
  ],
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } },
    {
      "alias": "status",
      "type": { "name": "string" },
      "expression": { "key": 1, "type": { "name": "string" } }
    },
    {
      "alias": "orders",
      "type": { "name": "integer" },
      "expression": { "operator": "count", "over": "group" }
    },
    {
      "alias": "revenue",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "sum",
        "over": "group",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
