{
  "from": { "entity": "users" },
  "where": {
    "operator": "and",
    "conditions": [
      {
        "operator": "equal",
        "left": { "source": "users", "field": "deleted_at", "type": { "name": "datetime", "nullable": true } },
        "right": { "type": { "name": "datetime", "nullable": true }, "value": null }
      },
      {
        "operator": "notEqual",
        "left": {
          "source": "users",
          "field": "email_verified_at",
          "type": { "name": "datetime", "nullable": true }
        },
        "right": { "type": { "name": "datetime", "nullable": true }, "value": null }
      }
    ]
  },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
