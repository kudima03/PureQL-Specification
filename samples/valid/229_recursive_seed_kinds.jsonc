// The seed of a recursive subquery is any query: grouped with having, combined, paged, or total. A grouped
// key and a total aggregate make the seed's column nullable, and next returns a non-null value for it.
{
  "subqueries": [
    {
      "name": "from_top_referrers",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "notEqual",
            "type": { "name": "boolean" },
            "left": {
              "source": "users",
              "field": "referrer_id",
              "type": { "name": "uuid", "nullable": true }
            },
            "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
          },
          "groupBy": [
            {
              "alias": "id",
              "expression": {
                "source": "users",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            }
          ],
          "having": {
            "operator": "greaterThanOrEqual",
            "type": { "name": "boolean" },
            "left": { "operator": "count", "type": { "name": "integer" } },
            "right": { "param": "referrals", "type": { "name": "integer" } }
          },
          "select": [
            { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid", "nullable": true } } }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "from_top_referrers",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": {
                  "source": "from_top_referrers",
                  "field": "id",
                  "type": { "name": "uuid", "nullable": true }
                }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ]
        },
        "maxDepth": 50
      }
    },
    {
      "name": "from_two_roots",
      "recursive": {
        "seed": {
          "unionAll": [
            {
              "from": { "entity": "users" },
              "where": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
                "right": { "param": "first_root", "type": { "name": "uuid" } }
              },
              "select": [
                {
                  "alias": "id",
                  "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
                }
              ]
            },
            {
              "from": { "entity": "users" },
              "where": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
                "right": { "param": "second_root", "type": { "name": "uuid" } }
              },
              "select": [
                {
                  "alias": "id",
                  "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
                }
              ]
            }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "from_two_roots",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "from_two_roots", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ]
        },
        "maxDepth": 20
      }
    },
    {
      "name": "from_first_sign_ups",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ],
          "orderBy": [
            { "expression": { "source": "users", "field": "created_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ],
          "pagination": { "take": 10 }
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "from_first_sign_ups",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "from_first_sign_ups", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ]
        },
        "maxDepth": 1
      }
    },
    {
      "name": "since_first_order",
      "recursive": {
        "seed": {
          "from": { "entity": "orders" },
          "aggregate": [
            {
              "alias": "day",
              "expression": {
                "operator": "min",
                "type": { "name": "date", "nullable": true },
                "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
              }
            }
          ]
        },
        "next": {
          "from": { "subquery": "since_first_order" },
          "where": {
            "operator": "lessThan",
            "type": { "name": "boolean" },
            "left": {
              "source": "since_first_order",
              "field": "day",
              "type": { "name": "date", "nullable": true }
            },
            "right": { "param": "to", "type": { "name": "date" } }
          },
          "select": [
            {
              "alias": "day",
              "expression": {
                "operator": "dateAddDays",
                "type": { "name": "date", "nullable": true },
                "left": {
                  "source": "since_first_order",
                  "field": "day",
                  "type": { "name": "date", "nullable": true }
                },
                "right": { "type": { "name": "integer" }, "value": 1 }
              }
            }
          ]
        },
        "maxDepth": { "param": "days", "type": { "name": "integer" } }
      }
    }
  ],
  "from": { "entity": "users" },
  "joins": [
    {
      "kind": "inner",
      "subquery": "since_first_order",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
        },
        "right": {
          "source": "since_first_order",
          "field": "day",
          "type": { "name": "date", "nullable": true }
        }
      }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "list": { "subquery": "from_two_roots", "field": "id", "type": { "name": "uuid" } }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "list": {
          "subquery": "from_top_referrers",
          "field": "id",
          "type": { "name": "uuid", "nullable": true }
        }
      },
      {
        "operator": "not",
        "type": { "name": "boolean" },
        "condition": {
          "operator": "in",
          "type": { "name": "boolean" },
          "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
          "list": { "subquery": "from_first_sign_ups", "field": "id", "type": { "name": "uuid" } }
        }
      }
    ]
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "signed_up_on",
      "expression": {
        "source": "since_first_order",
        "field": "day",
        "type": { "name": "date", "nullable": true }
      }
    }
  ]
}
