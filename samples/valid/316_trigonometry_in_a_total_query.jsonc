// Trigonometry in where and over the aggregates of a total query, lifted over those that are nullable there,
// and pi next to count.
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": { "name": "boolean" },
    "left": {
      "operator": "sin",
      "type": { "name": "decimal" },
      "operand": {
        "operator": "multiply",
        "type": { "name": "decimal" },
        "values": [
          {
            "operator": "hour",
            "type": { "name": "integer" },
            "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
          },
          {
            "operator": "divide",
            "type": { "name": "decimal" },
            "values": [
              { "operator": "pi", "type": { "name": "decimal" } },
              { "type": { "name": "integer" }, "value": 12 }
            ]
          }
        ]
      }
    },
    "right": { "type": { "name": "integer" }, "value": 0 }
  },
  "aggregate": [
    {
      "alias": "mean_hour_angle",
      "expression": {
        "operator": "atan2",
        "type": { "name": "decimal" },
        "y": {
          "operator": "sum",
          "type": { "name": "decimal" },
          "selector": {
            "operator": "sin",
            "type": { "name": "decimal" },
            "operand": {
              "operator": "multiply",
              "type": { "name": "decimal" },
              "values": [
                {
                  "operator": "hour",
                  "type": { "name": "integer" },
                  "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
                },
                {
                  "operator": "divide",
                  "type": { "name": "decimal" },
                  "values": [
                    { "operator": "pi", "type": { "name": "decimal" } },
                    { "type": { "name": "integer" }, "value": 12 }
                  ]
                }
              ]
            }
          }
        },
        "x": {
          "operator": "sum",
          "type": { "name": "decimal" },
          "selector": {
            "operator": "cos",
            "type": { "name": "decimal" },
            "operand": {
              "operator": "multiply",
              "type": { "name": "decimal" },
              "values": [
                {
                  "operator": "hour",
                  "type": { "name": "integer" },
                  "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
                },
                {
                  "operator": "divide",
                  "type": { "name": "decimal" },
                  "values": [
                    { "operator": "pi", "type": { "name": "decimal" } },
                    { "type": { "name": "integer" }, "value": 12 }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "alias": "largest_cosine",
      "expression": {
        "operator": "cos",
        "type": { "name": "decimal", "nullable": true },
        "operand": {
          "operator": "min",
          "type": { "name": "decimal", "nullable": true },
          "selector": {
            "operator": "multiply",
            "type": { "name": "decimal" },
            "values": [
              {
                "operator": "hour",
                "type": { "name": "integer" },
                "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
              },
              {
                "operator": "divide",
                "type": { "name": "decimal" },
                "values": [
                  { "operator": "pi", "type": { "name": "decimal" } },
                  { "type": { "name": "integer" }, "value": 12 }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "alias": "angle_of_the_average",
      "expression": {
        "operator": "atan",
        "type": { "name": "decimal", "nullable": true },
        "operand": {
          "operator": "average",
          "type": { "name": "decimal", "nullable": true },
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      }
    },
    {
      "alias": "pi_times_count",
      "expression": {
        "operator": "multiply",
        "type": { "name": "decimal" },
        "values": [
          { "operator": "pi", "type": { "name": "decimal" } },
          { "operator": "count", "type": { "name": "integer" } }
        ]
      }
    },
    {
      "alias": "running",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "tan",
          "type": { "name": "decimal" },
          "operand": {
            "operator": "divide",
            "type": { "name": "decimal" },
            "values": [
              {
                "operator": "multiply",
                "type": { "name": "decimal" },
                "values": [
                  {
                    "operator": "hour",
                    "type": { "name": "integer" },
                    "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
                  },
                  {
                    "operator": "divide",
                    "type": { "name": "decimal" },
                    "values": [
                      { "operator": "pi", "type": { "name": "decimal" } },
                      { "type": { "name": "integer" }, "value": 12 }
                    ]
                  }
                ]
              },
              { "type": { "name": "integer" }, "value": 4 }
            ]
          }
        }
      }
    }
  ]
}
