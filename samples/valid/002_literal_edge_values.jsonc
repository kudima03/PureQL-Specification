// Literal values at the edges of each format: 5.0 is a JSON integer, a decimal may be written without a fraction,
// decimals of 28 digits and of 28 decimal places, leap day, the first and last days of the range (0001-01-01 and
// 9999-12-31), six fractional digits, datetimes in UTC with a fraction, a uuid of hex letters, and the largest and
// smallest 64-bit integers.
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "int_written_as_5_0",
      "expression": { "type": { "name": "integer" }, "value": 5.0 }
    },
    {
      "alias": "negative_int",
      "expression": { "type": { "name": "integer" }, "value": -42 }
    },
    {
      "alias": "decimal_without_fraction",
      "expression": { "type": { "name": "decimal" }, "value": "5" }
    },
    {
      "alias": "decimal_exponent",
      "expression": { "type": { "name": "decimal" }, "value": "0.00000015" }
    },
    {
      "alias": "empty_string",
      "expression": { "type": { "name": "string" }, "value": "" }
    },
    {
      "alias": "leap_day",
      "expression": { "type": { "name": "date" }, "value": "2024-02-29" }
    },
    {
      "alias": "first_day",
      "expression": { "type": { "name": "date" }, "value": "0001-01-01" }
    },
    {
      "alias": "last_day",
      "expression": { "type": { "name": "date" }, "value": "9999-12-31" }
    },
    {
      "alias": "midnight",
      "expression": { "type": { "name": "time" }, "value": "00:00:00" }
    },
    {
      "alias": "microseconds",
      "expression": { "type": { "name": "time" }, "value": "23:59:59.999999" }
    },
    {
      "alias": "utc_half_second",
      "expression": { "type": { "name": "datetime" }, "value": "2024-12-31T23:59:59.5Z" }
    },
    {
      "alias": "utc_one_microsecond",
      "expression": { "type": { "name": "datetime" }, "value": "2024-01-01T00:00:00.000001Z" }
    },
    {
      "alias": "hex_letters_uuid",
      "expression": { "type": { "name": "uuid" }, "value": "abcdefab-cdef-4abc-8def-abcdefabcdef" }
    },
    {
      "alias": "decimal_28_digits",
      "expression": { "type": { "name": "decimal" }, "value": "-9999999999999999999999999999" }
    },
    {
      "alias": "decimal_28_digits_with_fraction",
      "expression": { "type": { "name": "decimal" }, "value": "1234567890123456.789012345678" }
    },
    {
      "alias": "decimal_28_places",
      "expression": { "type": { "name": "decimal" }, "value": "-0.0000000000000000000000000001" }
    },
    { "alias": "largest_integer", "expression": { "type": { "name": "integer" }, "value": 9223372036854775807 } },
    { "alias": "smallest_integer", "expression": { "type": { "name": "integer" }, "value": -9223372036854775808 } }
  ]
}
