// Windows over a left join: aggregates of a nullable selector or with a predicate are nullable, count and sum
// never are, previous of a nullable operand stays nullable with a default, and nullable fields are partition
// and sort keys.
{
  "from": { "entity": "users" },
  "joins": [
    {
      "kind": "left",
      "entity": "orders",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    { "alias": "user_id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "order_id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid", "nullable": true } }
    },
    {
      "alias": "orders",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "notEqual",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "id", "type": { "name": "uuid", "nullable": true } },
          "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
        },
        "over": { "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ] }
      }
    },
    {
      "alias": "total",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal", "nullable": true } },
        "over": { "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ] }
      }
    },
    {
      "alias": "average",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal", "nullable": true } },
        "over": { "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ] }
      }
    },
    {
      "alias": "largest_so_far",
      "expression": {
        "operator": "max",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal", "nullable": true } },
        "over": {
          "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ],
          "orderBy": [
            {
              "expression": {
                "source": "orders",
                "field": "ordered_at",
                "type": { "name": "datetime", "nullable": true }
              }
            },
            {
              "expression": {
                "source": "orders",
                "field": "id",
                "type": { "name": "uuid", "nullable": true }
              }
            }
          ],
          "frame": { "preceding": "all" }
        }
      }
    },
    {
      "alias": "first_order_at",
      "expression": {
        "operator": "first",
        "type": { "name": "datetime", "nullable": true },
        "selector": {
          "source": "orders",
          "field": "ordered_at",
          "type": { "name": "datetime", "nullable": true }
        },
        "orderBy": [
          {
            "expression": {
              "source": "orders",
              "field": "ordered_at",
              "type": { "name": "datetime", "nullable": true }
            }
          },
          {
            "expression": { "source": "orders", "field": "id", "type": { "name": "uuid", "nullable": true } }
          }
        ],
        "over": { "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ] }
      }
    },
    {
      "alias": "average_age_in_country",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } },
        "over": { "partitionBy": [ { "source": "users", "field": "country", "type": { "name": "string" } } ] }
      }
    },
    {
      "alias": "youngest_in_country",
      "expression": {
        "operator": "min",
        "type": { "name": "integer", "nullable": true },
        "selector": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } },
        "over": { "partitionBy": [ { "source": "users", "field": "country", "type": { "name": "string" } } ] }
      }
    },
    {
      "alias": "earliest_sign_up_in_country",
      "expression": {
        "operator": "min",
        "type": { "name": "datetime" },
        "selector": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
        "over": { "partitionBy": [ { "source": "users", "field": "country", "type": { "name": "string" } } ] }
      }
    },
    {
      "alias": "paid_average",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "type": { "name": "decimal" }, "value": "1" },
        "predicate": {
          "operator": "equal",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "is_paid", "type": { "name": "boolean", "nullable": true } },
          "right": { "type": { "name": "boolean" }, "value": true }
        },
        "over": { "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ] }
      }
    },
    {
      "alias": "previous_total",
      "expression": {
        "operator": "previous",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal", "nullable": true } },
        "over": {
          "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ],
          "orderBy": [
            {
              "expression": {
                "source": "orders",
                "field": "ordered_at",
                "type": { "name": "datetime", "nullable": true }
              }
            },
            {
              "expression": {
                "source": "orders",
                "field": "id",
                "type": { "name": "uuid", "nullable": true }
              }
            }
          ]
        }
      }
    },
    {
      "alias": "previous_total_or_zero",
      "expression": {
        "operator": "previous",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal", "nullable": true } },
        "default": { "type": { "name": "integer" }, "value": 0 },
        "over": {
          "partitionBy": [ { "source": "users", "field": "id", "type": { "name": "uuid" } } ],
          "orderBy": [
            {
              "expression": {
                "source": "orders",
                "field": "ordered_at",
                "type": { "name": "datetime", "nullable": true }
              }
            },
            {
              "expression": {
                "source": "orders",
                "field": "id",
                "type": { "name": "uuid", "nullable": true }
              }
            }
          ]
        }
      }
    },
    {
      "alias": "previous_user_created_at",
      "expression": {
        "operator": "previous",
        "type": { "name": "datetime" },
        "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
        "default": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
        "over": {
          "orderBy": [
            { "expression": { "source": "users", "field": "created_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    },
    {
      "alias": "users_in_tier_of_login",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            { "source": "users", "field": "tier", "type": { "name": "string" } },
            { "source": "users", "field": "last_login_at", "type": { "name": "datetime", "nullable": true } }
          ]
        }
      }
    },
    {
      "alias": "rank_by_last_login",
      "expression": {
        "operator": "rank",
        "type": { "name": "integer" },
        "over": {
          "orderBy": [
            {
              "expression": {
                "source": "users",
                "field": "last_login_at",
                "type": { "name": "datetime", "nullable": true }
              },
              "direction": "desc"
            }
          ]
        }
      }
    }
  ],
  "orderBy": [
    { "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
    {
      "expression": {
        "source": "orders",
        "field": "ordered_at",
        "type": { "name": "datetime", "nullable": true }
      }
    },
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid", "nullable": true } } }
  ]
}
