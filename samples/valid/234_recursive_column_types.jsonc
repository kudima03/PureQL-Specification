// Columns of every type: the seed fixes them, with typed nulls and a decimal, and next returns values those
// columns accept: non-null for nullable, integer for decimal.
{
  "subqueries": [
    {
      "name": "rows",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "parent_id",
              "expression": { "type": { "name": "uuid", "nullable": true }, "value": null }
            },
            { "alias": "level", "expression": { "type": { "name": "integer" }, "value": 0 } },
            { "alias": "weight", "expression": { "type": { "name": "decimal" }, "value": "1" } },
            {
              "alias": "label",
              "expression": { "type": { "name": "string", "nullable": true }, "value": null }
            },
            { "alias": "is_root", "expression": { "type": { "name": "boolean" }, "value": true } },
            {
              "alias": "since",
              "expression": { "source": "users", "field": "birth_date", "type": { "name": "date" } }
            },
            {
              "alias": "call_time",
              "expression": { "source": "users", "field": "preferred_call_time", "type": { "name": "time" } }
            },
            {
              "alias": "seen_at",
              "expression": {
                "source": "users",
                "field": "last_login_at",
                "type": { "name": "datetime", "nullable": true }
              }
            }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "rows",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "rows", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "parent_id",
              "expression": { "source": "rows", "field": "id", "type": { "name": "uuid" } }
            },
            {
              "alias": "level",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  { "source": "rows", "field": "level", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            },
            {
              "alias": "weight",
              "expression": {
                "operator": "floor",
                "type": { "name": "integer" },
                "operand": {
                  "operator": "multiply",
                  "type": { "name": "decimal" },
                  "values": [
                    { "source": "rows", "field": "weight", "type": { "name": "decimal" } },
                    { "type": { "name": "decimal" }, "value": "2.5" }
                  ]
                }
              }
            },
            {
              "alias": "label",
              "expression": { "source": "users", "field": "first_name", "type": { "name": "string" } }
            },
            { "alias": "is_root", "expression": { "type": { "name": "boolean" }, "value": false } },
            {
              "alias": "since",
              "expression": {
                "operator": "dateAddDays",
                "type": { "name": "date" },
                "left": { "source": "rows", "field": "since", "type": { "name": "date" } },
                "right": { "source": "rows", "field": "level", "type": { "name": "integer" } }
              }
            },
            {
              "alias": "call_time",
              "expression": { "source": "rows", "field": "call_time", "type": { "name": "time" } }
            },
            {
              "alias": "seen_at",
              "expression": {
                "operator": "coalesce",
                "type": { "name": "datetime" },
                "values": [
                  {
                    "source": "users",
                    "field": "last_login_at",
                    "type": { "name": "datetime", "nullable": true }
                  },
                  { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
                ]
              }
            }
          ]
        },
        "maxDepth": 12
      }
    }
  ],
  "from": { "subquery": "rows" },
  "select": [
    { "alias": "id", "expression": { "source": "rows", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "parent_id",
      "expression": { "source": "rows", "field": "parent_id", "type": { "name": "uuid", "nullable": true } }
    },
    { "alias": "level", "expression": { "source": "rows", "field": "level", "type": { "name": "integer" } } },
    {
      "alias": "weight",
      "expression": { "source": "rows", "field": "weight", "type": { "name": "decimal" } }
    },
    {
      "alias": "label",
      "expression": { "source": "rows", "field": "label", "type": { "name": "string", "nullable": true } }
    },
    {
      "alias": "is_root",
      "expression": { "source": "rows", "field": "is_root", "type": { "name": "boolean" } }
    },
    { "alias": "since", "expression": { "source": "rows", "field": "since", "type": { "name": "date" } } },
    {
      "alias": "call_time",
      "expression": { "source": "rows", "field": "call_time", "type": { "name": "time" } }
    },
    {
      "alias": "seen_at",
      "expression": { "source": "rows", "field": "seen_at", "type": { "name": "datetime", "nullable": true } }
    }
  ],
  "orderBy": [
    { "expression": { "source": "rows", "field": "level", "type": { "name": "integer" } } },
    { "expression": { "source": "rows", "field": "id", "type": { "name": "uuid" } } }
  ]
}
