// normalize in a total query: in where, in predicates and selectors, and lifted over min, which is nullable
// there.
{
  "from": { "entity": "users" },
  "where": {
    "operator": "notEqual",
    "type": { "name": "boolean" },
    "left": {
      "operator": "normalize",
      "type": { "name": "string" },
      "operand": { "source": "users", "field": "country", "type": { "name": "string" } },
      "form": "NFC"
    },
    "right": {
      "operator": "normalize",
      "type": { "name": "string" },
      "operand": { "param": "excluded_country", "type": { "name": "string" } },
      "form": "NFC"
    }
  },
  "aggregate": [
    {
      "alias": "stored_decomposed",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "notEqual",
          "type": { "name": "boolean" },
          "left": { "source": "users", "field": "last_name", "type": { "name": "string" } },
          "right": {
            "operator": "normalize",
            "type": { "name": "string" },
            "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } },
            "form": "NFC"
          }
        }
      }
    },
    {
      "alias": "first_last_name",
      "expression": {
        "operator": "normalize",
        "type": { "name": "string", "nullable": true },
        "operand": {
          "operator": "min",
          "type": { "name": "string", "nullable": true },
          "selector": { "source": "users", "field": "last_name", "type": { "name": "string" } }
        },
        "form": "NFC"
      }
    },
    {
      "alias": "first_normalized_last_name",
      "expression": {
        "operator": "min",
        "type": { "name": "string", "nullable": true },
        "selector": {
          "operator": "normalize",
          "type": { "name": "string" },
          "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } },
          "form": "NFC"
        }
      }
    },
    {
      "alias": "countries",
      "expression": {
        "operator": "concatAll",
        "type": { "name": "string" },
        "selector": {
          "operator": "normalize",
          "type": { "name": "string" },
          "operand": { "source": "users", "field": "country", "type": { "name": "string" } },
          "form": "NFKC"
        },
        "separator": { "type": { "name": "string" }, "value": ", " },
        "orderBy": [
          {
            "expression": {
              "operator": "normalize",
              "type": { "name": "string" },
              "operand": { "source": "users", "field": "country", "type": { "name": "string" } },
              "form": "NFKC"
            }
          }
        ],
        "distinct": true
      }
    },
    {
      "alias": "all_composed",
      "expression": {
        "operator": "all",
        "type": { "name": "boolean" },
        "predicate": {
          "operator": "equal",
          "type": { "name": "boolean" },
          "left": { "source": "users", "field": "first_name", "type": { "name": "string" } },
          "right": {
            "operator": "normalize",
            "type": { "name": "string" },
            "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
            "form": "NFC"
          }
        }
      }
    },
    {
      "alias": "most_common_key",
      "expression": {
        "operator": "mode",
        "type": { "name": "string", "nullable": true },
        "selector": {
          "operator": "normalize",
          "type": { "name": "string" },
          "operand": {
            "operator": "foldCase",
            "type": { "name": "string" },
            "operand": { "source": "users", "field": "last_name", "type": { "name": "string" } }
          },
          "form": "NFKC"
        }
      }
    }
  ]
}
