// A total query returns its row even over no rows, where count is 0: dividing by nullIfEqual(count, 0) gives
// null rather than an execution error.
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": { "param": "since", "type": { "name": "date" } }
  },
  "aggregate": [
    { "alias": "orders", "expression": { "operator": "count", "type": { "name": "integer" } } },
    {
      "alias": "average_total",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          {
            "operator": "sum",
            "type": { "name": "decimal" },
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          },
          {
            "operator": "nullIfEqual",
            "type": { "name": "integer", "nullable": true },
            "left": { "operator": "count", "type": { "name": "integer" } },
            "right": { "type": { "name": "integer" }, "value": 0 }
          }
        ]
      }
    },
    {
      "alias": "paid_share",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          {
            "operator": "count",
            "type": { "name": "integer" },
            "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
          },
          {
            "operator": "nullIfEqual",
            "type": { "name": "integer", "nullable": true },
            "left": { "operator": "count", "type": { "name": "integer" } },
            "right": { "type": { "name": "integer" }, "value": 0 }
          }
        ]
      }
    },
    {
      "alias": "paid_share_or_zero",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "decimal" },
        "values": [
          {
            "operator": "divide",
            "type": { "name": "decimal", "nullable": true },
            "values": [
              {
                "operator": "count",
                "type": { "name": "integer" },
                "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
              },
              {
                "operator": "nullIfEqual",
                "type": { "name": "integer", "nullable": true },
                "left": { "operator": "count", "type": { "name": "integer" } },
                "right": { "type": { "name": "integer" }, "value": 0 }
              }
            ]
          },
          { "type": { "name": "decimal" }, "value": "0" }
        ]
      }
    },
    {
      "alias": "orders_or_null",
      "expression": {
        "operator": "nullIfEqual",
        "type": { "name": "integer", "nullable": true },
        "left": { "operator": "count", "type": { "name": "integer" } },
        "right": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
