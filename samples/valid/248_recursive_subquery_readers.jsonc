// A recursive subquery read by a grouped subquery, a total subquery, in, joins, window functions and an
// aggregate over all rows, with distinctBy and pagination.
{
  "subqueries": [
    {
      "name": "referrals",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "first_name",
              "expression": { "source": "users", "field": "first_name", "type": { "name": "string" } }
            },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "referrals",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "referrals", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "first_name",
              "expression": { "source": "users", "field": "first_name", "type": { "name": "string" } }
            },
            {
              "alias": "depth",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  { "source": "referrals", "field": "depth", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            }
          ]
        },
        "maxDepth": 50
      }
    },
    {
      "name": "levels",
      "query": {
        "from": { "subquery": "referrals" },
        "groupBy": [
          {
            "alias": "depth",
            "expression": { "source": "referrals", "field": "depth", "type": { "name": "integer" } }
          }
        ],
        "select": [
          { "alias": "depth", "expression": { "key": "depth", "type": { "name": "integer" } } },
          { "alias": "members", "expression": { "operator": "count", "type": { "name": "integer" } } }
        ]
      }
    },
    {
      "name": "deepest",
      "query": {
        "from": { "subquery": "referrals" },
        "aggregate": [
          {
            "alias": "depth",
            "expression": {
              "operator": "max",
              "type": { "name": "integer", "nullable": true },
              "selector": { "source": "referrals", "field": "depth", "type": { "name": "integer" } }
            }
          }
        ]
      }
    }
  ],
  "from": { "subquery": "referrals" },
  "joins": [
    {
      "kind": "inner",
      "subquery": "levels",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "levels", "field": "depth", "type": { "name": "integer" } },
        "right": { "source": "referrals", "field": "depth", "type": { "name": "integer" } }
      }
    },
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "referrals", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "source": "referrals", "field": "depth", "type": { "name": "integer" } },
    "list": { "subquery": "deepest", "field": "depth", "type": { "name": "integer", "nullable": true } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "referrals", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "first_name",
      "expression": { "source": "referrals", "field": "first_name", "type": { "name": "string" } }
    },
    {
      "alias": "country",
      "expression": { "source": "users", "field": "country", "type": { "name": "string" } }
    },
    {
      "alias": "members_at_this_depth",
      "expression": { "source": "levels", "field": "members", "type": { "name": "integer" } }
    },
    {
      "alias": "position_in_level",
      "expression": {
        "operator": "rowNumber",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [ { "source": "referrals", "field": "depth", "type": { "name": "integer" } } ],
          "orderBy": [
            { "expression": { "source": "referrals", "field": "first_name", "type": { "name": "string" } } },
            { "expression": { "source": "referrals", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    },
    {
      "alias": "share_of_tree",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal" },
        "values": [
          { "type": { "name": "integer" }, "value": 1 },
          { "operator": "count", "type": { "name": "integer" } }
        ]
      }
    }
  ],
  "orderBy": [
    { "expression": { "source": "referrals", "field": "first_name", "type": { "name": "string" } } },
    { "expression": { "source": "referrals", "field": "id", "type": { "name": "uuid" } } }
  ],
  "distinctBy": [ "id" ],
  "pagination": { "take": 100 }
}
