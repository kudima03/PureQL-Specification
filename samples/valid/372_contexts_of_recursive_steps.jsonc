// A recursive next without groupBy computes row expressions from both sources; one with groupBy reads keys and aggregates, over the group and over every row of the step, in select and having
{
  "subqueries": [
    {
      "name": "chain",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } },
            {
              "alias": "label",
              "expression": { "source": "users", "field": "name", "type": { "name": "string" } }
            }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "chain",
              "on": {
                "operator": "and",
                "type": { "name": "boolean" },
                "conditions": [
                  {
                    "operator": "equal",
                    "type": { "name": "boolean" },
                    "left": {
                      "source": "users",
                      "field": "referrer_id",
                      "type": { "name": "uuid", "nullable": true }
                    },
                    "right": { "source": "chain", "field": "id", "type": { "name": "uuid" } }
                  },
                  {
                    "operator": "notEqual",
                    "type": { "name": "boolean" },
                    "left": {
                      "operator": "foldCase",
                      "type": { "name": "string" },
                      "operand": { "source": "users", "field": "name", "type": { "name": "string" } }
                    },
                    "right": {
                      "operator": "foldCase",
                      "type": { "name": "string" },
                      "operand": { "source": "chain", "field": "label", "type": { "name": "string" } }
                    }
                  }
                ]
              }
            }
          ],
          "where": {
            "operator": "and",
            "type": { "name": "boolean" },
            "conditions": [
              {
                "operator": "lessThan",
                "type": { "name": "boolean" },
                "left": { "source": "chain", "field": "depth", "type": { "name": "integer" } },
                "right": { "type": { "name": "integer" }, "value": 10 }
              },
              {
                "operator": "contains",
                "type": { "name": "boolean" },
                "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
                "pattern": { "type": { "name": "string" }, "value": "@" }
              }
            ]
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "depth",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  { "source": "chain", "field": "depth", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            },
            {
              "alias": "label",
              "expression": {
                "operator": "concatWith",
                "type": { "name": "string" },
                "values": [
                  { "source": "chain", "field": "label", "type": { "name": "string" } },
                  {
                    "source": "users",
                    "field": "middle_name",
                    "type": { "name": "string", "nullable": true }
                  },
                  { "source": "users", "field": "name", "type": { "name": "string" } }
                ],
                "separator": { "type": { "name": "string" }, "value": " > " }
              }
            }
          ]
        },
        "maxDepth": 50
      }
    },
    {
      "name": "reach",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } },
            {
              "alias": "label",
              "expression": { "source": "users", "field": "name", "type": { "name": "string" } }
            }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "reach",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "users", "field": "referrer_id", "type": { "name": "uuid", "nullable": true } },
                "right": { "source": "reach", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "where": {
            "operator": "lessThan",
            "type": { "name": "boolean" },
            "left": { "source": "reach", "field": "depth", "type": { "name": "integer" } },
            "right": { "param": "levels", "type": { "name": "integer" } }
          },
          "groupBy": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "name",
              "expression": {
                "operator": "upper",
                "type": { "name": "string" },
                "operand": { "source": "users", "field": "name", "type": { "name": "string" } }
              }
            }
          ],
          "having": {
            "operator": "or",
            "type": { "name": "boolean" },
            "conditions": [
              {
                "operator": "greaterThan",
                "type": { "name": "boolean" },
                "left": { "operator": "count", "type": { "name": "integer" } },
                "right": { "type": { "name": "integer" }, "value": 0 }
              },
              {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "key": "name", "type": { "name": "string" } },
                "right": { "type": { "name": "string" }, "value": "ROOT" }
              }
            ]
          },
          "select": [
            { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid" } } },
            {
              "alias": "depth",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  {
                    "operator": "min",
                    "type": { "name": "integer" },
                    "selector": { "source": "reach", "field": "depth", "type": { "name": "integer" } }
                  },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            },
            {
              "alias": "label",
              "expression": {
                "operator": "concat",
                "type": { "name": "string" },
                "values": [
                  { "key": "name", "type": { "name": "string" } },
                  { "type": { "name": "string" }, "value": " of " },
                  {
                    "operator": "asString",
                    "type": { "name": "string" },
                    "operand": { "operator": "count", "type": { "name": "integer" }, "over": "all" }
                  }
                ]
              }
            }
          ]
        },
        "maxDepth": { "param": "levels", "type": { "name": "integer" } }
      }
    }
  ],
  "from": { "subquery": "chain" },
  "joins": [
    {
      "kind": "left",
      "subquery": "reach",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "chain", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "reach", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "chain", "field": "id", "type": { "name": "uuid" } } },
    { "alias": "depth", "expression": { "source": "chain", "field": "depth", "type": { "name": "integer" } } },
    { "alias": "label", "expression": { "source": "chain", "field": "label", "type": { "name": "string" } } },
    {
      "alias": "reach_label",
      "expression": { "source": "reach", "field": "label", "type": { "name": "string", "nullable": true } }
    }
  ],
  "orderBy": [
    { "expression": { "source": "chain", "field": "depth", "type": { "name": "integer" } } },
    { "expression": { "source": "chain", "field": "label", "type": { "name": "string" } } },
    { "expression": { "source": "chain", "field": "id", "type": { "name": "uuid" } } }
  ]
}
