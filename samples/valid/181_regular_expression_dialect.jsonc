// Every construct of the regular expression dialect in a literal pattern: literals, the dot, classes with
// ranges, negation, escapes and shorthands, the shorthand classes and control characters, anchors and word
// boundaries, alternation, capturing, non-capturing, nested and empty groups, greedy, counted and lazy
// quantifiers, and escaped special characters.
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "empty_pattern",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "" }
      }
    },
    {
      "alias": "literal",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "abc" }
      }
    },
    {
      "alias": "any_code_point",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "a.c" }
      }
    },
    {
      "alias": "class",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[abc]" }
      }
    },
    {
      "alias": "negated_class",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[^abc]" }
      }
    },
    {
      "alias": "ranges",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[a-zA-Z0-9_]" }
      }
    },
    {
      "alias": "escapes_in_a_class",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[\\]\\[\\\\\\^\\-]" }
      }
    },
    {
      "alias": "hyphen_first_and_last",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[-a][a-]" }
      }
    },
    {
      "alias": "shorthands_in_a_class",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[\\d\\s,;]" }
      }
    },
    {
      "alias": "metacharacters_in_a_class",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[*+?{}().|$]" }
      }
    },
    {
      "alias": "digit_word_space",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\d\\w\\s" }
      }
    },
    {
      "alias": "negated_shorthands",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\D\\W\\S" }
      }
    },
    {
      "alias": "control_characters",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\t\\r\\n" }
      }
    },
    {
      "alias": "anchors",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "^abc$" }
      }
    },
    {
      "alias": "word_boundaries",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\bword\\b\\B" }
      }
    },
    {
      "alias": "alternation",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "cat|dog|" }
      }
    },
    {
      "alias": "capturing_group",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "(ab)c" }
      }
    },
    {
      "alias": "non_capturing_group",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "(?:ab)c" }
      }
    },
    {
      "alias": "nested_groups",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "((a)(?:b(c)))" }
      }
    },
    {
      "alias": "empty_group",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "()" }
      }
    },
    {
      "alias": "star_plus_optional",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "a*b+c?" }
      }
    },
    {
      "alias": "counted",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "a{3}b{2,}c{2,5}" }
      }
    },
    {
      "alias": "lazy",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "a*?b+?c??d{2,3}?" }
      }
    },
    {
      "alias": "quantified_group",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "(?:ab){2}(c|d)+" }
      }
    },
    {
      "alias": "quantified_class",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "[0-9]{4}-[0-9]{2}" }
      }
    },
    {
      "alias": "quantified_escape",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\d+\\.\\d*" }
      }
    },
    {
      "alias": "escaped_metacharacters",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\.\\*\\+\\?\\(\\)\\[\\]\\{\\}\\|\\^\\$\\\\" }
      }
    },
    {
      "alias": "escaped_slash",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\/[\\/\\-\\.]" }
      }
    },
    {
      "alias": "literal_closing_parenthesis_escaped",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "\\(a\\)" }
      }
    },
    {
      "alias": "non_ascii_literals",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "é+ß" }
      }
    },
    {
      "alias": "astral_literal",
      "expression": {
        "operator": "matchesRegex",
        "type": { "name": "boolean" },
        "operand": { "source": "users", "field": "name", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "𝒳{2}" }
      }
    }
  ]
}
