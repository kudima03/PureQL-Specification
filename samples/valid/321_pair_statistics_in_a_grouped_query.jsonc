// correlation in having, select and orderBy of a grouped query, over all rows, over computed values, and the
// covariance compared with its operands swapped.
{
  "from": { "entity": "order_items" },
  "groupBy": [
    {
      "alias": "order_id",
      "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "coalesce",
      "type": { "name": "decimal" },
      "values": [
        {
          "operator": "correlation",
          "type": { "name": "decimal", "nullable": true },
          "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
        },
        { "type": { "name": "integer" }, "value": 0 }
      ]
    },
    "right": { "param": "threshold", "type": { "name": "decimal" } }
  },
  "select": [
    { "alias": "order_id", "expression": { "key": "order_id", "type": { "name": "uuid" } } },
    {
      "alias": "correlation",
      "expression": {
        "operator": "correlation",
        "type": { "name": "decimal", "nullable": true },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "correlation_over_all_orders",
      "expression": {
        "operator": "correlation",
        "type": { "name": "decimal", "nullable": true },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "over": "all"
      }
    },
    {
      "alias": "covariance_over_all_orders",
      "expression": {
        "operator": "covariancePopulation",
        "type": { "name": "decimal" },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "over": "all"
      }
    },
    {
      "alias": "of_computed_values",
      "expression": {
        "operator": "correlation",
        "type": { "name": "decimal", "nullable": true },
        "left": {
          "operator": "multiply",
          "type": { "name": "decimal" },
          "values": [
            { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          ]
        },
        "right": {
          "operator": "subtract",
          "type": { "name": "integer" },
          "values": [
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            { "source": "order_items", "field": "returned_quantity", "type": { "name": "integer" } }
          ]
        }
      }
    },
    {
      "alias": "symmetric",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "covariancePopulation",
          "type": { "name": "decimal" },
          "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
        },
        "right": {
          "operator": "covariancePopulation",
          "type": { "name": "decimal" },
          "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          "right": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
        }
      }
    },
    {
      "alias": "strongly_related",
      "expression": {
        "operator": "greaterThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "abs",
          "type": { "name": "decimal", "nullable": true },
          "operand": {
            "operator": "correlation",
            "type": { "name": "decimal", "nullable": true },
            "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
            "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          }
        },
        "right": { "type": { "name": "decimal" }, "value": "0.8" }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "correlation",
        "type": { "name": "decimal", "nullable": true },
        "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      },
      "direction": "desc"
    },
    { "expression": { "key": "order_id", "type": { "name": "uuid" } } }
  ]
}
