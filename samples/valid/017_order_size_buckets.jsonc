// Orders split into size buckets, with each bucket's share of all orders.
// The group key is a computed if chain; count over the group divided by count over all rows gives the share; buckets
// are sorted by their smallest order, since min of the total orders them the same way the buckets were cut.
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "bucket",
      "expression": {
        "operator": "if",
        "type": { "name": "string" },
        "condition": {
          "operator": "lessThan",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "right": { "type": { "name": "integer" }, "value": 50 }
        },
        "then": { "type": { "name": "string" }, "value": "small" },
        "else": {
          "operator": "if",
          "type": { "name": "string" },
          "condition": {
            "operator": "lessThan",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
            "right": { "type": { "name": "integer" }, "value": 200 }
          },
          "then": { "type": { "name": "string" }, "value": "medium" },
          "else": { "type": { "name": "string" }, "value": "large" }
        }
      }
    }
  ],
  "select": [
    {
      "alias": "bucket",
      "expression": { "key": "bucket", "type": { "name": "string" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    },
    {
      "alias": "revenue",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "share_of_orders",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": {
          "operator": "divide",
          "type": { "name": "decimal" },
          "values": [
            { "operator": "count", "type": { "name": "integer" } },
            { "operator": "count", "type": { "name": "integer" }, "over": "all" }
          ]
        },
        "digits": { "type": { "name": "integer" }, "value": 3 }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
