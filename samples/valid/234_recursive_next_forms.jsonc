// The next query reads the subquery under an alias in from, joins entities with inner and left, filters with
// in over an earlier subquery, and computes columns; maxDepth is a parameter. The result is read twice under
// aliases and by a later subquery.
{
  "subqueries": [
    {
      "name": "buyers",
      "query": {
        "from": { "entity": "orders" },
        "groupBy": [
          {
            "alias": "user_id",
            "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [ { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } } ]
      }
    },
    {
      "name": "tree",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": {
              "source": "users",
              "field": "referrer_id",
              "type": { "name": "uuid", "nullable": true }
            },
            "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "parent_id",
              "expression": {
                "source": "users",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            },
            {
              "alias": "root_id",
              "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
            },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } },
            {
              "alias": "path",
              "expression": {
                "operator": "asString",
                "type": { "name": "string" },
                "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } }
              }
            },
            {
              "alias": "other_tier_than_root",
              "expression": { "type": { "name": "boolean" }, "value": false }
            },
            {
              "alias": "shown_as",
              "expression": {
                "operator": "coalesce",
                "type": { "name": "string" },
                "values": [
                  { "source": "users", "field": "nickname", "type": { "name": "string", "nullable": true } },
                  { "source": "users", "field": "first_name", "type": { "name": "string" } }
                ]
              }
            }
          ]
        },
        "next": {
          "from": { "subquery": "tree", "alias": "parent" },
          "joins": [
            {
              "kind": "inner",
              "entity": "users",
              "alias": "child",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "child",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "parent", "field": "id", "type": { "name": "uuid" } }
              }
            },
            {
              "kind": "left",
              "entity": "users",
              "alias": "top",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "top", "field": "id", "type": { "name": "uuid" } },
                "right": { "source": "parent", "field": "root_id", "type": { "name": "uuid" } }
              }
            }
          ],
          "where": {
            "operator": "and",
            "type": { "name": "boolean" },
            "conditions": [
              {
                "operator": "in",
                "type": { "name": "boolean" },
                "operand": { "source": "child", "field": "id", "type": { "name": "uuid" } },
                "list": { "subquery": "buyers", "field": "user_id", "type": { "name": "uuid" } }
              },
              {
                "operator": "lessThan",
                "type": { "name": "boolean" },
                "left": { "source": "parent", "field": "depth", "type": { "name": "integer" } },
                "right": { "param": "levels", "type": { "name": "integer" } }
              },
              {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "top",
                  "field": "is_active",
                  "type": { "name": "boolean", "nullable": true }
                },
                "right": { "type": { "name": "boolean" }, "value": true }
              }
            ]
          },
          "select": [
            { "alias": "id", "expression": { "source": "child", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "parent_id",
              "expression": {
                "source": "child",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            },
            {
              "alias": "root_id",
              "expression": { "source": "parent", "field": "root_id", "type": { "name": "uuid" } }
            },
            {
              "alias": "depth",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  { "source": "parent", "field": "depth", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            },
            {
              "alias": "path",
              "expression": {
                "operator": "concat",
                "type": { "name": "string" },
                "values": [
                  { "source": "parent", "field": "path", "type": { "name": "string" } },
                  { "type": { "name": "string" }, "value": "/" },
                  {
                    "operator": "asString",
                    "type": { "name": "string" },
                    "operand": { "source": "child", "field": "id", "type": { "name": "uuid" } }
                  }
                ]
              }
            },
            {
              "alias": "other_tier_than_root",
              "expression": {
                "operator": "notEqual",
                "type": { "name": "boolean" },
                "left": { "source": "child", "field": "tier", "type": { "name": "string" } },
                "right": { "param": "root_tier", "type": { "name": "string" } }
              }
            },
            {
              "alias": "shown_as",
              "expression": {
                "operator": "if",
                "type": { "name": "string" },
                "condition": {
                  "operator": "equal",
                  "type": { "name": "boolean" },
                  "left": {
                    "source": "child",
                    "field": "nickname",
                    "type": { "name": "string", "nullable": true }
                  },
                  "right": { "type": { "name": "string", "nullable": true }, "value": null }
                },
                "then": { "source": "child", "field": "first_name", "type": { "name": "string" } },
                "else": {
                  "operator": "coalesce",
                  "type": { "name": "string" },
                  "values": [
                    {
                      "source": "child",
                      "field": "nickname",
                      "type": { "name": "string", "nullable": true }
                    },
                    { "type": { "name": "string" }, "value": "" }
                  ]
                }
              }
            }
          ]
        },
        "maxDepth": { "param": "max_depth", "type": { "name": "integer" } }
      }
    },
    {
      "name": "sizes",
      "query": {
        "from": { "subquery": "tree" },
        "groupBy": [
          {
            "alias": "root_id",
            "expression": { "source": "tree", "field": "root_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [
          { "alias": "root_id", "expression": { "key": "root_id", "type": { "name": "uuid" } } },
          { "alias": "members", "expression": { "operator": "count", "type": { "name": "integer" } } }
        ]
      }
    }
  ],
  "from": { "subquery": "tree", "alias": "below" },
  "joins": [
    {
      "kind": "inner",
      "subquery": "tree",
      "alias": "above",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "below", "field": "parent_id", "type": { "name": "uuid", "nullable": true } },
        "right": { "source": "above", "field": "id", "type": { "name": "uuid" } }
      }
    },
    {
      "kind": "inner",
      "subquery": "sizes",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "sizes", "field": "root_id", "type": { "name": "uuid" } },
        "right": { "source": "below", "field": "root_id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    { "alias": "id", "expression": { "source": "below", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "shown_as",
      "expression": { "source": "below", "field": "shown_as", "type": { "name": "string" } }
    },
    {
      "alias": "parent_shown_as",
      "expression": { "source": "above", "field": "shown_as", "type": { "name": "string" } }
    },
    {
      "alias": "levels_below_root",
      "expression": { "source": "below", "field": "depth", "type": { "name": "integer" } }
    },
    {
      "alias": "tree_members",
      "expression": { "source": "sizes", "field": "members", "type": { "name": "integer" } }
    },
    { "alias": "path", "expression": { "source": "below", "field": "path", "type": { "name": "string" } } }
  ],
  "orderBy": [ { "expression": { "source": "below", "field": "path", "type": { "name": "string" } } } ]
}
