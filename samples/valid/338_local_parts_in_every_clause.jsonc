// Parts of a datetime in the zone of a column, in join.on, where, select, a window's partition, an
// aggregate's selector and orderBy; the same part read in UTC next to it.
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": {
              "operator": "year",
              "type": { "name": "integer" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            },
            "right": {
              "operator": "year",
              "type": { "name": "integer" },
              "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          }
        ]
      }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": {
          "operator": "hour",
          "type": { "name": "integer" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "right": { "type": { "name": "integer" }, "value": 9 }
      },
      {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "hour",
          "type": { "name": "integer" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "right": { "type": { "name": "integer" }, "value": 18 }
      },
      {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "dayOfWeek",
          "type": { "name": "integer" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "right": { "type": { "name": "integer" }, "value": 6 }
      }
    ]
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "local_year",
      "expression": {
        "operator": "year",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "local_week",
      "expression": {
        "operator": "week",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "local_week_year",
      "expression": {
        "operator": "weekYear",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "utc_hour",
      "expression": {
        "operator": "hour",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    },
    {
      "alias": "local_hour",
      "expression": {
        "operator": "hour",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "orders_in_the_local_month",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            {
              "operator": "year",
              "type": { "name": "integer" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            },
            {
              "operator": "month",
              "type": { "name": "integer" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          ]
        }
      }
    },
    {
      "alias": "latest_local_hour",
      "expression": {
        "operator": "max",
        "type": { "name": "integer" },
        "selector": {
          "operator": "hour",
          "type": { "name": "integer" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        }
      }
    },
    {
      "alias": "minutes_past_the_local_hour",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [
          {
            "operator": "multiply",
            "type": { "name": "integer" },
            "values": [
              {
                "operator": "minute",
                "type": { "name": "integer" },
                "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
                "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
              },
              { "type": { "name": "integer" }, "value": 60 }
            ]
          },
          {
            "operator": "second",
            "type": { "name": "integer" },
            "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
          }
        ]
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "dayOfYear",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "expression": {
        "operator": "hour",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      },
      "direction": "desc"
    },
    { "column": "id" }
  ]
}
