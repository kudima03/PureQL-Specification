// round and truncate with digits side by side: an integer stays an integer and a decimal a decimal, for
// negative and positive digits, sums, quotients, parameters, literals, halfEven and nullable operands;
// without digits round still takes a decimal.
{
  "from": { "entity": "order_items" },
  "select": [
    {
      "alias": "integer_to_tens",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "decimal_to_tens",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "integer_to_two_places",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "type": { "name": "integer" }, "value": 2 }
      }
    },
    {
      "alias": "decimal_to_two_places",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": 2 }
      }
    },
    {
      "alias": "integer_truncated",
      "expression": {
        "operator": "truncate",
        "type": { "name": "integer" },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "type": { "name": "integer" }, "value": -2 }
      }
    },
    {
      "alias": "decimal_truncated",
      "expression": {
        "operator": "truncate",
        "type": { "name": "decimal" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": -2 }
      }
    },
    {
      "alias": "widened_first",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": {
          "operator": "asDecimal",
          "type": { "name": "decimal" },
          "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
        },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "of_an_integer_sum",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": {
          "operator": "add",
          "type": { "name": "integer" },
          "values": [
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            { "source": "order_items", "field": "returned_quantity", "type": { "name": "integer" } }
          ]
        },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "of_a_mixed_sum",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": {
          "operator": "add",
          "type": { "name": "decimal" },
          "values": [
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
          ]
        },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "of_a_quotient",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": {
          "operator": "divide",
          "type": { "name": "decimal" },
          "values": [
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            { "source": "order_items", "field": "returned_quantity", "type": { "name": "integer" } }
          ]
        },
        "digits": { "type": { "name": "integer" }, "value": 0 }
      }
    },
    {
      "alias": "of_an_integer_quotient",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": {
          "operator": "integerDivide",
          "type": { "name": "integer" },
          "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          "right": { "type": { "name": "integer" }, "value": 3 }
        },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "of_a_parameter",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "param": "units", "type": { "name": "integer" } },
        "digits": { "param": "digits", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "of_a_decimal_parameter",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "param": "discount", "type": { "name": "decimal" } },
        "digits": { "param": "digits", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "of_a_literal",
      "expression": {
        "operator": "truncate",
        "type": { "name": "integer" },
        "operand": { "type": { "name": "integer" }, "value": 1299 },
        "digits": { "type": { "name": "integer" }, "value": -2 }
      }
    },
    {
      "alias": "half_even",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "type": { "name": "integer" }, "value": -1 },
        "mode": "halfEven"
      }
    },
    {
      "alias": "nullable_operand",
      "expression": {
        "operator": "round",
        "type": { "name": "integer", "nullable": true },
        "operand": { "param": "units", "type": { "name": "integer", "nullable": true } },
        "digits": { "type": { "name": "integer" }, "value": -1 }
      }
    },
    {
      "alias": "nullable_digits",
      "expression": {
        "operator": "truncate",
        "type": { "name": "integer", "nullable": true },
        "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "digits": { "param": "digits", "type": { "name": "integer", "nullable": true } }
      }
    },
    {
      "alias": "nullable_decimal",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal", "nullable": true },
        "operand": { "param": "rate", "type": { "name": "decimal", "nullable": true } },
        "digits": { "type": { "name": "integer" }, "value": 2 }
      }
    },
    {
      "alias": "rounded_twice",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": {
          "operator": "round",
          "type": { "name": "integer" },
          "operand": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          "digits": { "type": { "name": "integer" }, "value": -1 }
        },
        "digits": { "type": { "name": "integer" }, "value": -2 }
      }
    },
    {
      "alias": "without_digits_of_a_decimal",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
      }
    }
  ]
}
