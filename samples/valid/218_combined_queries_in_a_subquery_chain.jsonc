// Combined queries among the subqueries: a union of three inputs that are each ordered and paged or
// deduplicated on their own, a grouped subquery that reads it, an except over an entity and that subquery,
// and the main query joining one and testing in against the other.
{
  "subqueries": [
    {
      "name": "highlights",
      "query": {
        "union": [
          {
            "from": { "entity": "orders" },
            "select": [
              {
                "alias": "id",
                "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
              },
              {
                "alias": "user_id",
                "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
              },
              {
                "alias": "total",
                "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
              }
            ],
            "orderBy": [
              {
                "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
                "direction": "desc"
              },
              { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
            ],
            "pagination": { "take": 10 }
          },
          {
            "from": { "entity": "orders" },
            "select": [
              {
                "alias": "id",
                "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
              },
              {
                "alias": "user_id",
                "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
              },
              {
                "alias": "total",
                "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
              }
            ],
            "orderBy": [
              {
                "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
                "direction": "desc"
              },
              { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
            ],
            "pagination": { "take": 10 }
          },
          {
            "from": { "entity": "orders" },
            "select": [
              {
                "alias": "id",
                "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
              },
              {
                "alias": "user_id",
                "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
              },
              {
                "alias": "total",
                "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
              }
            ],
            "orderBy": [
              { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
              { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
            ],
            "distinctBy": [ "user_id" ]
          }
        ]
      }
    },
    {
      "name": "highlighted_users",
      "query": {
        "from": { "subquery": "highlights" },
        "groupBy": [
          {
            "alias": "user_id",
            "expression": { "source": "highlights", "field": "user_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [
          { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } },
          { "alias": "orders", "expression": { "operator": "count", "type": { "name": "integer" } } }
        ]
      }
    },
    {
      "name": "quiet_users",
      "query": {
        "except": [
          {
            "from": { "entity": "users" },
            "select": [
              {
                "alias": "user_id",
                "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
              }
            ]
          },
          {
            "from": { "subquery": "highlighted_users" },
            "select": [
              {
                "alias": "user_id",
                "expression": {
                  "source": "highlighted_users",
                  "field": "user_id",
                  "type": { "name": "uuid" }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "from": { "entity": "users" },
  "joins": [
    {
      "kind": "left",
      "subquery": "highlighted_users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "highlighted_users", "field": "user_id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "not",
    "type": { "name": "boolean" },
    "condition": {
      "operator": "in",
      "type": { "name": "boolean" },
      "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
      "list": { "subquery": "quiet_users", "field": "user_id", "type": { "name": "uuid" } }
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "highlighted_orders",
      "expression": {
        "source": "highlighted_users",
        "field": "orders",
        "type": { "name": "integer", "nullable": true }
      }
    }
  ],
  "orderBy": [ { "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } } ]
}
