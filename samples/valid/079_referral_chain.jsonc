// Each user with their referrer and their referrer's referrer, through two left joins of users under aliases.
// Fields of both aliases are nullable after their joins, and in the second on the referrer's own referrer_id is read
// from a source joined with left before it. The depth column counts how far the chain goes.
{
  "from": { "entity": "users", "alias": "u" },
  "joins": [
    {
      "kind": "left",
      "entity": "users",
      "alias": "referrer",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "u", "field": "referrer_id", "type": { "name": "uuid", "nullable": true } },
        "right": { "source": "referrer", "field": "id", "type": { "name": "uuid" } }
      }
    },
    {
      "kind": "left",
      "entity": "users",
      "alias": "grand_referrer",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "referrer", "field": "referrer_id", "type": { "name": "uuid", "nullable": true } },
        "right": { "source": "grand_referrer", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "user",
      "expression": { "source": "u", "field": "name", "type": { "name": "string" } }
    },
    {
      "alias": "referrer",
      "expression": { "source": "referrer", "field": "name", "type": { "name": "string", "nullable": true } }
    },
    {
      "alias": "grand_referrer",
      "expression": {
        "source": "grand_referrer",
        "field": "name",
        "type": { "name": "string", "nullable": true }
      }
    },
    {
      "alias": "chain_depth",
      "expression": {
        "operator": "if",
        "type": { "name": "integer" },
        "condition": {
          "operator": "equal",
          "type": { "name": "boolean" },
          "left": { "source": "referrer", "field": "id", "type": { "name": "uuid", "nullable": true } },
          "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
        },
        "then": { "type": { "name": "integer" }, "value": 0 },
        "else": {
          "operator": "if",
          "type": { "name": "integer" },
          "condition": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": {
              "source": "grand_referrer",
              "field": "id",
              "type": { "name": "uuid", "nullable": true }
            },
            "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
          },
          "then": { "type": { "name": "integer" }, "value": 1 },
          "else": { "type": { "name": "integer" }, "value": 2 }
        }
      }
    }
  ],
  "orderBy": [
    { "expression": { "source": "u", "field": "name", "type": { "name": "string" } } }
  ]
}
