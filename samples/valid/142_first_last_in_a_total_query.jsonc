// first and last in a total query are always nullable, since it returns its row even over no rows. A null
// sorts first in ascending order, so the earliest shipped date needs a predicate; without one the first value
// is null while any order is unshipped.
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
    "right": { "param": "user_id", "type": { "name": "uuid" } }
  },
  "aggregate": [
    {
      "alias": "first_order_id",
      "expression": {
        "operator": "first",
        "type": { "name": "uuid", "nullable": true },
        "selector": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
        "orderBy": [
          { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    },
    {
      "alias": "latest_total",
      "expression": {
        "operator": "last",
        "type": { "name": "decimal", "nullable": true },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "orderBy": [
          { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    },
    {
      "alias": "largest_order_status",
      "expression": {
        "operator": "first",
        "type": { "name": "string", "nullable": true },
        "selector": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "orderBy": [
          {
            "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
            "direction": "desc"
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    },
    {
      "alias": "earliest_shipped",
      "expression": {
        "operator": "first",
        "type": { "name": "date", "nullable": true },
        "selector": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        },
        "orderBy": [
          {
            "expression": {
              "source": "orders",
              "field": "shipped_date",
              "type": { "name": "date", "nullable": true }
            }
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ],
        "predicate": {
          "operator": "notEqual",
          "type": { "name": "boolean" },
          "left": {
            "source": "orders",
            "field": "shipped_date",
            "type": { "name": "date", "nullable": true }
          },
          "right": { "type": { "name": "date", "nullable": true }, "value": null }
        }
      }
    },
    {
      "alias": "null_while_any_is_unshipped",
      "expression": {
        "operator": "first",
        "type": { "name": "date", "nullable": true },
        "selector": {
          "source": "orders",
          "field": "shipped_date",
          "type": { "name": "date", "nullable": true }
        },
        "orderBy": [
          {
            "expression": {
              "source": "orders",
              "field": "shipped_date",
              "type": { "name": "date", "nullable": true }
            }
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    },
    {
      "alias": "days_between_first_and_last",
      "expression": {
        "operator": "dateDiffDays",
        "type": { "name": "integer", "nullable": true },
        "left": {
          "operator": "last",
          "type": { "name": "date", "nullable": true },
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        },
        "right": {
          "operator": "first",
          "type": { "name": "date", "nullable": true },
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    }
  ]
}
