// startOf with a zone in a grouped query, of a key and of an aggregate, and in a total query, inside and
// around aggregates.
{
  "subqueries": [
    {
      "name": "by_hour",
      "query": {
        "from": { "entity": "orders" },
        "groupBy": [
          {
            "alias": "ordered_at",
            "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
          },
          {
            "alias": "status",
            "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
          }
        ],
        "having": {
          "operator": "greaterThanOrEqual",
          "type": { "name": "boolean" },
          "left": { "key": "ordered_at", "type": { "name": "datetime" } },
          "right": {
            "operator": "startOfMonth",
            "type": { "name": "datetime" },
            "operand": { "param": "now", "type": { "name": "datetime" } },
            "zone": { "param": "zone", "type": { "name": "string" } }
          }
        },
        "select": [
          { "alias": "status", "expression": { "key": "status", "type": { "name": "string" } } },
          {
            "alias": "local_hour_start_of_the_key",
            "expression": {
              "operator": "startOfHour",
              "type": { "name": "datetime" },
              "operand": { "key": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "param": "zone", "type": { "name": "string" } }
            }
          },
          {
            "alias": "local_week_of_the_last_shipment",
            "expression": {
              "operator": "startOfWeek",
              "type": { "name": "datetime" },
              "operand": {
                "operator": "max",
                "type": { "name": "datetime" },
                "selector": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } }
              },
              "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
            }
          },
          {
            "alias": "local_days",
            "expression": {
              "operator": "countDistinct",
              "type": { "name": "integer" },
              "selector": {
                "operator": "startOfDay",
                "type": { "name": "datetime" },
                "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
                "zone": { "param": "zone", "type": { "name": "string" } }
              }
            }
          },
          {
            "alias": "latest_local_month",
            "expression": {
              "operator": "max",
              "type": { "name": "datetime" },
              "selector": {
                "operator": "startOfMonth",
                "type": { "name": "datetime" },
                "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
                "zone": { "param": "zone", "type": { "name": "string" } }
              }
            }
          }
        ]
      }
    },
    {
      "name": "totals",
      "query": {
        "from": { "entity": "orders" },
        "where": {
          "operator": "greaterThanOrEqual",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "right": {
            "operator": "startOfQuarter",
            "type": { "name": "datetime" },
            "operand": { "param": "now", "type": { "name": "datetime" } },
            "zone": { "param": "zone", "type": { "name": "string" } }
          }
        },
        "aggregate": [
          {
            "alias": "orders_this_local_quarter",
            "expression": { "operator": "count", "type": { "name": "integer" } }
          },
          {
            "alias": "local_days_with_orders",
            "expression": {
              "operator": "countDistinct",
              "type": { "name": "integer" },
              "selector": {
                "operator": "startOfDay",
                "type": { "name": "datetime" },
                "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
                "zone": { "param": "zone", "type": { "name": "string" } }
              }
            }
          },
          {
            "alias": "local_month_of_the_first_order",
            "expression": {
              "operator": "startOfMonth",
              "type": { "name": "datetime", "nullable": true },
              "operand": {
                "operator": "min",
                "type": { "name": "datetime", "nullable": true },
                "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
              },
              "zone": { "param": "zone", "type": { "name": "string" } }
            }
          },
          {
            "alias": "busiest_local_day",
            "expression": {
              "operator": "mode",
              "type": { "name": "datetime", "nullable": true },
              "selector": {
                "operator": "startOfDay",
                "type": { "name": "datetime" },
                "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
                "zone": { "param": "zone", "type": { "name": "string" } }
              }
            }
          }
        ]
      }
    }
  ],
  "from": { "subquery": "by_hour" },
  "joins": [
    { "kind": "inner", "subquery": "totals", "on": { "type": { "name": "boolean" }, "value": true } }
  ],
  "select": [
    {
      "alias": "status",
      "expression": { "source": "by_hour", "field": "status", "type": { "name": "string" } }
    },
    {
      "alias": "hour_start",
      "expression": {
        "source": "by_hour",
        "field": "local_hour_start_of_the_key",
        "type": { "name": "datetime" }
      }
    },
    {
      "alias": "orders_this_local_quarter",
      "expression": {
        "source": "totals",
        "field": "orders_this_local_quarter",
        "type": { "name": "integer" }
      }
    }
  ]
}
