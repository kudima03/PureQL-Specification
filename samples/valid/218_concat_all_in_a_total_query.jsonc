// concatAll in a total query is non-null, unlike the other aggregates with a selector: over no rows it is the
// empty string, which nullIfEqual and coalesce turn into a placeholder. A separator from a parameter,
// distinct values, an order by another expression, and a predicate.
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
    "right": { "param": "user_id", "type": { "name": "uuid" } }
  },
  "aggregate": [
    {
      "alias": "statuses",
      "expression": {
        "operator": "concatAll",
        "type": { "name": "string" },
        "selector": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "separator": { "type": { "name": "string" }, "value": ", " },
        "orderBy": [
          { "expression": { "source": "orders", "field": "status", "type": { "name": "string" } } }
        ],
        "distinct": true
      }
    },
    {
      "alias": "order_dates",
      "expression": {
        "operator": "concatAll",
        "type": { "name": "string" },
        "selector": {
          "operator": "asString",
          "type": { "name": "string" },
          "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "separator": { "param": "separator", "type": { "name": "string" } },
        "orderBy": [
          { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ]
      }
    },
    {
      "alias": "paid_totals",
      "expression": {
        "operator": "concatAll",
        "type": { "name": "string" },
        "selector": {
          "operator": "asString",
          "type": { "name": "string" },
          "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        },
        "separator": { "type": { "name": "string" }, "value": " + " },
        "orderBy": [
          {
            "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
            "direction": "desc"
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ],
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    },
    {
      "alias": "has_statuses",
      "expression": {
        "operator": "notEqual",
        "type": { "name": "boolean" },
        "left": {
          "operator": "concatAll",
          "type": { "name": "string" },
          "selector": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "separator": { "type": { "name": "string" }, "value": ", " },
          "orderBy": [
            { "expression": { "source": "orders", "field": "status", "type": { "name": "string" } } }
          ],
          "distinct": true
        },
        "right": { "type": { "name": "string" }, "value": "" }
      }
    },
    {
      "alias": "statuses_or_placeholder",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "string" },
        "values": [
          {
            "operator": "nullIfEqual",
            "type": { "name": "string", "nullable": true },
            "left": {
              "operator": "concatAll",
              "type": { "name": "string" },
              "selector": { "source": "orders", "field": "status", "type": { "name": "string" } },
              "separator": { "type": { "name": "string" }, "value": ", " },
              "orderBy": [
                { "expression": { "source": "orders", "field": "status", "type": { "name": "string" } } }
              ],
              "distinct": true
            },
            "right": { "type": { "name": "string" }, "value": "" }
          },
          { "type": { "name": "string" }, "value": "no orders" }
        ]
      }
    },
    {
      "alias": "number_of_characters",
      "expression": {
        "operator": "length",
        "type": { "name": "integer" },
        "operand": {
          "operator": "concatAll",
          "type": { "name": "string" },
          "selector": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "separator": { "type": { "name": "string" }, "value": ", " },
          "orderBy": [
            { "expression": { "source": "orders", "field": "status", "type": { "name": "string" } } }
          ],
          "distinct": true
        }
      }
    }
  ]
}
