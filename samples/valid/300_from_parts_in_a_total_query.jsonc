// dateFromParts, timeFromParts and datetimeFromParts in where and over the aggregates of a total query,
// lifted over those that are nullable there.
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "greaterThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": {
      "operator": "dateFromParts",
      "type": { "name": "date" },
      "year": { "param": "year", "type": { "name": "integer" } },
      "month": { "type": { "name": "integer" }, "value": 1 },
      "day": { "type": { "name": "integer" }, "value": 1 }
    }
  },
  "aggregate": [
    {
      "alias": "year_end",
      "expression": {
        "operator": "dateFromParts",
        "type": { "name": "date", "nullable": true },
        "year": {
          "operator": "max",
          "type": { "name": "integer", "nullable": true },
          "selector": {
            "operator": "year",
            "type": { "name": "integer" },
            "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
          }
        },
        "month": { "type": { "name": "integer" }, "value": 12 },
        "day": { "type": { "name": "integer" }, "value": 31 }
      }
    },
    {
      "alias": "latest_start_hour",
      "expression": {
        "operator": "timeFromParts",
        "type": { "name": "time", "nullable": true },
        "hour": {
          "operator": "max",
          "type": { "name": "integer", "nullable": true },
          "selector": {
            "operator": "hour",
            "type": { "name": "integer" },
            "operand": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
          }
        },
        "minute": { "type": { "name": "integer" }, "value": 0 },
        "second": { "type": { "name": "integer" }, "value": 0 }
      }
    },
    {
      "alias": "first_window",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime", "nullable": true },
        "date": {
          "operator": "min",
          "type": { "name": "date", "nullable": true },
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "time": {
          "operator": "min",
          "type": { "name": "time", "nullable": true },
          "selector": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } }
        }
      }
    },
    {
      "alias": "orders_this_year",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "lessThan",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          "right": {
            "operator": "dateFromParts",
            "type": { "name": "date" },
            "year": {
              "operator": "add",
              "type": { "name": "integer" },
              "values": [
                { "param": "year", "type": { "name": "integer" } },
                { "type": { "name": "integer" }, "value": 1 }
              ]
            },
            "month": { "type": { "name": "integer" }, "value": 1 },
            "day": { "type": { "name": "integer" }, "value": 1 }
          }
        }
      }
    },
    {
      "alias": "fixed_instant",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "type": { "name": "date" }, "value": "2024-01-31" },
        "time": { "type": { "name": "time" }, "value": "18:30:00" }
      }
    }
  ]
}
