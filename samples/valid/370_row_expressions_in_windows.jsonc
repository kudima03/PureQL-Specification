// Computed partition keys, sort keys, range keys, selectors, predicates, and operands and defaults of previous / next: every part of a window is a row expression
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "select": [
    {
      "alias": "by_bucket",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            {
              "operator": "if",
              "type": { "name": "string" },
              "condition": {
                "operator": "greaterThan",
                "type": { "name": "boolean" },
                "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
                "right": { "type": { "name": "integer" }, "value": 100 }
              },
              "then": { "type": { "name": "string" }, "value": "large" },
              "else": { "type": { "name": "string" }, "value": "small" }
            },
            {
              "operator": "foldCase",
              "type": { "name": "string" },
              "operand": { "source": "orders", "field": "status", "type": { "name": "string" } }
            }
          ]
        }
      }
    },
    {
      "alias": "running_by_ship_day",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "multiply",
          "type": { "name": "decimal" },
          "values": [
            { "source": "orders", "field": "total", "type": { "name": "decimal" } },
            { "type": { "name": "decimal" }, "value": "1.2" }
          ]
        },
        "predicate": {
          "operator": "notEqual",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
          "right": { "type": { "name": "date", "nullable": true }, "value": null }
        },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            {
              "expression": {
                "operator": "coalesce",
                "type": { "name": "date" },
                "values": [
                  {
                    "source": "orders",
                    "field": "shipped_date",
                    "type": { "name": "date", "nullable": true }
                  },
                  { "source": "orders", "field": "order_date", "type": { "name": "date" } }
                ]
              },
              "direction": "desc"
            },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ],
          "frame": { "preceding": "all" }
        }
      }
    },
    {
      "alias": "week_by_day_number",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "over": {
          "orderBy": [
            {
              "expression": {
                "operator": "dateDiffDays",
                "type": { "name": "integer" },
                "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
                "right": { "type": { "name": "date" }, "value": "2024-01-01" }
              }
            }
          ],
          "range": { "preceding": 7, "following": 7 }
        }
      }
    },
    {
      "alias": "previous_wait",
      "expression": {
        "operator": "previous",
        "type": { "name": "decimal" },
        "operand": {
          "operator": "datetimeDiffSeconds",
          "type": { "name": "decimal" },
          "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
          "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        },
        "default": {
          "operator": "multiply",
          "type": { "name": "decimal" },
          "values": [
            { "source": "orders", "field": "total", "type": { "name": "decimal" } },
            { "type": { "name": "integer" }, "value": 0 }
          ]
        },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    },
    {
      "alias": "next_ship_day",
      "expression": {
        "operator": "next",
        "type": { "name": "date", "nullable": true },
        "operand": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
        "default": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    },
    {
      "alias": "first_of_local_month",
      "expression": {
        "operator": "rowNumber",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            {
              "operator": "startOfMonth",
              "type": { "name": "datetime" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ]
        }
      }
    },
    {
      "alias": "call_slot",
      "expression": {
        "operator": "first",
        "type": { "name": "datetime" },
        "selector": {
          "operator": "datetimeFromParts",
          "type": { "name": "datetime" },
          "date": {
            "operator": "asDate",
            "type": { "name": "date" },
            "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
          },
          "time": { "source": "users", "field": "preferred_call_time", "type": { "name": "time" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "orderBy": [ { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } } ],
        "over": { "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ] }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "rank",
        "type": { "name": "integer" },
        "over": {
          "orderBy": [
            {
              "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
              "direction": "desc"
            }
          ]
        }
      }
    },
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
