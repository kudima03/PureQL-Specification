// concatAll as a column of a grouped subquery over a join: non-null there, nullable after a left join, where
// contains on it is false for the orders without lines.
{
  "subqueries": [
    {
      "name": "order_skus",
      "query": {
        "from": { "entity": "order_items" },
        "joins": [
          {
            "kind": "inner",
            "entity": "products",
            "on": {
              "operator": "equal",
              "type": { "name": "boolean" },
              "left": { "source": "order_items", "field": "product_id", "type": { "name": "uuid" } },
              "right": { "source": "products", "field": "id", "type": { "name": "uuid" } }
            }
          }
        ],
        "groupBy": [
          {
            "alias": "order_id",
            "expression": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [
          { "alias": "order_id", "expression": { "key": "order_id", "type": { "name": "uuid" } } },
          {
            "alias": "skus",
            "expression": {
              "operator": "concatAll",
              "type": { "name": "string" },
              "selector": { "source": "products", "field": "sku", "type": { "name": "string" } },
              "separator": { "type": { "name": "string" }, "value": ", " },
              "orderBy": [
                { "expression": { "source": "products", "field": "sku", "type": { "name": "string" } } }
              ],
              "distinct": true
            }
          }
        ]
      }
    }
  ],
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "left",
      "subquery": "order_skus",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
        "right": { "source": "order_skus", "field": "order_id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "contains",
    "type": { "name": "boolean" },
    "operand": { "source": "order_skus", "field": "skus", "type": { "name": "string", "nullable": true } },
    "pattern": { "param": "sku", "type": { "name": "string" } }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "skus",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "string" },
        "values": [
          { "source": "order_skus", "field": "skus", "type": { "name": "string", "nullable": true } },
          { "type": { "name": "string" }, "value": "" }
        ]
      }
    }
  ],
  "orderBy": [ { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } } ]
}
