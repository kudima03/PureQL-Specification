{
  "subqueries": [
    {
      "name": "daily_revenue",
      "query": {
        "from": {
          "entity": "orders"
        },
        "where": {
          "operator": "greaterThanOrEqual",
          "type": {
            "name": "boolean"
          },
          "left": {
            "source": "orders",
            "field": "order_date",
            "type": {
              "name": "date"
            }
          },
          "right": {
            "param": "from",
            "type": {
              "name": "date"
            }
          }
        },
        "groupBy": [
          {
            "alias": "order_date",
            "expression": {
              "source": "orders",
              "field": "order_date",
              "type": {
                "name": "date"
              }
            }
          }
        ],
        "select": [
          {
            "alias": "day",
            "expression": {
              "operator": "dateDiffDays",
              "type": {
                "name": "integer"
              },
              "left": {
                "key": "order_date",
                "type": {
                  "name": "date"
                }
              },
              "right": {
                "param": "from",
                "type": {
                  "name": "date"
                }
              }
            }
          },
          {
            "alias": "revenue",
            "expression": {
              "operator": "sum",
              "type": {
                "name": "decimal"
              },
              "selector": {
                "source": "orders",
                "field": "total",
                "type": {
                  "name": "decimal"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "from": {
    "subquery": "daily_revenue"
  },
  "aggregate": [
    {
      "alias": "days",
      "expression": {
        "operator": "count",
        "type": {
          "name": "integer"
        }
      }
    },
    {
      "alias": "growth_per_day",
      "expression": {
        "operator": "regressionSlope",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "y": {
          "source": "daily_revenue",
          "field": "revenue",
          "type": {
            "name": "decimal"
          }
        },
        "x": {
          "source": "daily_revenue",
          "field": "day",
          "type": {
            "name": "integer"
          }
        }
      }
    },
    {
      "alias": "revenue_on_the_first_day",
      "expression": {
        "operator": "regressionIntercept",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "y": {
          "source": "daily_revenue",
          "field": "revenue",
          "type": {
            "name": "decimal"
          }
        },
        "x": {
          "source": "daily_revenue",
          "field": "day",
          "type": {
            "name": "integer"
          }
        }
      }
    },
    {
      "alias": "share_of_variance_explained",
      "expression": {
        "operator": "regressionRSquared",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "y": {
          "source": "daily_revenue",
          "field": "revenue",
          "type": {
            "name": "decimal"
          }
        },
        "x": {
          "source": "daily_revenue",
          "field": "day",
          "type": {
            "name": "integer"
          }
        }
      }
    },
    {
      "alias": "forecast",
      "expression": {
        "operator": "add",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "values": [
          {
            "operator": "regressionIntercept",
            "type": {
              "name": "decimal",
              "nullable": true
            },
            "y": {
              "source": "daily_revenue",
              "field": "revenue",
              "type": {
                "name": "decimal"
              }
            },
            "x": {
              "source": "daily_revenue",
              "field": "day",
              "type": {
                "name": "integer"
              }
            }
          },
          {
            "operator": "multiply",
            "type": {
              "name": "decimal",
              "nullable": true
            },
            "values": [
              {
                "operator": "regressionSlope",
                "type": {
                  "name": "decimal",
                  "nullable": true
                },
                "y": {
                  "source": "daily_revenue",
                  "field": "revenue",
                  "type": {
                    "name": "decimal"
                  }
                },
                "x": {
                  "source": "daily_revenue",
                  "field": "day",
                  "type": {
                    "name": "integer"
                  }
                }
              },
              {
                "param": "forecast_day",
                "type": {
                  "name": "integer"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
