// A rate solved by bisection: each step of a recursive subquery aggregates the cash flows at the middle of an
// interval and keeps the half with the root; where limits the steps by a parameter and having stops at a
// tolerance.
{
  "subqueries": [
    {
      "name": "bounds",
      "recursive": {
        "seed": {
          "from": { "entity": "cash_flows" },
          "groupBy": [
            {
              "alias": "investment_id",
              "expression": { "source": "cash_flows", "field": "investment_id", "type": { "name": "uuid" } }
            }
          ],
          "select": [
            {
              "alias": "investment_id",
              "expression": { "key": "investment_id", "type": { "name": "uuid" } }
            },
            { "alias": "step", "expression": { "type": { "name": "integer" }, "value": 0 } },
            { "alias": "low", "expression": { "type": { "name": "decimal" }, "value": "-0.99" } },
            { "alias": "high", "expression": { "type": { "name": "decimal" }, "value": "10" } }
          ]
        },
        "next": {
          "from": { "subquery": "bounds" },
          "joins": [
            {
              "kind": "inner",
              "entity": "cash_flows",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "cash_flows", "field": "investment_id", "type": { "name": "uuid" } },
                "right": { "source": "bounds", "field": "investment_id", "type": { "name": "uuid" } }
              }
            }
          ],
          "where": {
            "operator": "lessThan",
            "type": { "name": "boolean" },
            "left": { "source": "bounds", "field": "step", "type": { "name": "integer" } },
            "right": { "param": "max_steps", "type": { "name": "integer" } }
          },
          "groupBy": [
            {
              "alias": "investment_id",
              "expression": { "source": "bounds", "field": "investment_id", "type": { "name": "uuid" } }
            },
            {
              "alias": "step",
              "expression": { "source": "bounds", "field": "step", "type": { "name": "integer" } }
            },
            {
              "alias": "low",
              "expression": { "source": "bounds", "field": "low", "type": { "name": "decimal" } }
            },
            {
              "alias": "high",
              "expression": { "source": "bounds", "field": "high", "type": { "name": "decimal" } }
            }
          ],
          "having": {
            "operator": "greaterThan",
            "type": { "name": "boolean" },
            "left": {
              "operator": "subtract",
              "type": { "name": "decimal" },
              "values": [
                { "key": "high", "type": { "name": "decimal" } },
                { "key": "low", "type": { "name": "decimal" } }
              ]
            },
            "right": { "param": "tolerance", "type": { "name": "decimal" } }
          },
          "select": [
            {
              "alias": "investment_id",
              "expression": { "key": "investment_id", "type": { "name": "uuid" } }
            },
            {
              "alias": "step",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  { "key": "step", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            },
            {
              "alias": "low",
              "expression": {
                "operator": "if",
                "type": { "name": "decimal" },
                "condition": {
                  "operator": "greaterThan",
                  "type": { "name": "boolean" },
                  "left": {
                    "operator": "sum",
                    "type": { "name": "decimal" },
                    "selector": {
                      "operator": "divide",
                      "type": { "name": "decimal" },
                      "values": [
                        { "source": "cash_flows", "field": "amount", "type": { "name": "decimal" } },
                        {
                          "operator": "power",
                          "type": { "name": "decimal" },
                          "operand": {
                            "operator": "add",
                            "type": { "name": "decimal" },
                            "values": [
                              { "type": { "name": "integer" }, "value": 1 },
                              {
                                "operator": "divide",
                                "type": { "name": "decimal" },
                                "values": [
                                  {
                                    "operator": "add",
                                    "type": { "name": "decimal" },
                                    "values": [
                                      { "source": "bounds", "field": "low", "type": { "name": "decimal" } },
                                      { "source": "bounds", "field": "high", "type": { "name": "decimal" } }
                                    ]
                                  },
                                  { "type": { "name": "integer" }, "value": 2 }
                                ]
                              }
                            ]
                          },
                          "exponent": {
                            "source": "cash_flows",
                            "field": "period",
                            "type": { "name": "integer" }
                          }
                        }
                      ]
                    }
                  },
                  "right": { "type": { "name": "integer" }, "value": 0 }
                },
                "then": {
                  "operator": "divide",
                  "type": { "name": "decimal" },
                  "values": [
                    {
                      "operator": "add",
                      "type": { "name": "decimal" },
                      "values": [
                        { "key": "low", "type": { "name": "decimal" } },
                        { "key": "high", "type": { "name": "decimal" } }
                      ]
                    },
                    { "type": { "name": "integer" }, "value": 2 }
                  ]
                },
                "else": { "key": "low", "type": { "name": "decimal" } }
              }
            },
            {
              "alias": "high",
              "expression": {
                "operator": "if",
                "type": { "name": "decimal" },
                "condition": {
                  "operator": "greaterThan",
                  "type": { "name": "boolean" },
                  "left": {
                    "operator": "sum",
                    "type": { "name": "decimal" },
                    "selector": {
                      "operator": "divide",
                      "type": { "name": "decimal" },
                      "values": [
                        { "source": "cash_flows", "field": "amount", "type": { "name": "decimal" } },
                        {
                          "operator": "power",
                          "type": { "name": "decimal" },
                          "operand": {
                            "operator": "add",
                            "type": { "name": "decimal" },
                            "values": [
                              { "type": { "name": "integer" }, "value": 1 },
                              {
                                "operator": "divide",
                                "type": { "name": "decimal" },
                                "values": [
                                  {
                                    "operator": "add",
                                    "type": { "name": "decimal" },
                                    "values": [
                                      { "source": "bounds", "field": "low", "type": { "name": "decimal" } },
                                      { "source": "bounds", "field": "high", "type": { "name": "decimal" } }
                                    ]
                                  },
                                  { "type": { "name": "integer" }, "value": 2 }
                                ]
                              }
                            ]
                          },
                          "exponent": {
                            "source": "cash_flows",
                            "field": "period",
                            "type": { "name": "integer" }
                          }
                        }
                      ]
                    }
                  },
                  "right": { "type": { "name": "integer" }, "value": 0 }
                },
                "then": { "key": "high", "type": { "name": "decimal" } },
                "else": {
                  "operator": "divide",
                  "type": { "name": "decimal" },
                  "values": [
                    {
                      "operator": "add",
                      "type": { "name": "decimal" },
                      "values": [
                        { "key": "low", "type": { "name": "decimal" } },
                        { "key": "high", "type": { "name": "decimal" } }
                      ]
                    },
                    { "type": { "name": "integer" }, "value": 2 }
                  ]
                }
              }
            }
          ]
        },
        "maxDepth": { "param": "max_depth", "type": { "name": "integer" } }
      }
    }
  ],
  "from": { "subquery": "bounds" },
  "groupBy": [
    {
      "alias": "investment_id",
      "expression": { "source": "bounds", "field": "investment_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "investment_id", "expression": { "key": "investment_id", "type": { "name": "uuid" } } },
    {
      "alias": "low",
      "expression": {
        "operator": "max",
        "type": { "name": "decimal" },
        "selector": { "source": "bounds", "field": "low", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "high",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "selector": { "source": "bounds", "field": "high", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "steps",
      "expression": {
        "operator": "max",
        "type": { "name": "integer" },
        "selector": { "source": "bounds", "field": "step", "type": { "name": "integer" } }
      }
    }
  ]
}
