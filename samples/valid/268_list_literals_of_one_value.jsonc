// A list literal of one value, for every type: the smallest list a query can write. An integer in a list of
// one decimal, and a null operand.
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "one_integer",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "integer" }, "value": 7 },
        "list": { "type": { "name": "integerList" }, "value": [ 7 ] }
      }
    },
    {
      "alias": "one_decimal",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "decimal" }, "value": "2.5" },
        "list": { "type": { "name": "decimalList" }, "value": [ "2.5" ] }
      }
    },
    {
      "alias": "one_string",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "string" }, "value": "a" },
        "list": { "type": { "name": "stringList" }, "value": [ "a" ] }
      }
    },
    {
      "alias": "one_boolean",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "boolean" }, "value": true },
        "list": { "type": { "name": "booleanList" }, "value": [ true ] }
      }
    },
    {
      "alias": "one_date",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "date" }, "value": "2024-01-31" },
        "list": { "type": { "name": "dateList" }, "value": [ "2024-01-31" ] }
      }
    },
    {
      "alias": "one_time",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "time" }, "value": "08:30:00" },
        "list": { "type": { "name": "timeList" }, "value": [ "08:30:00" ] }
      }
    },
    {
      "alias": "one_datetime",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "datetime" }, "value": "2024-01-31T08:30:00Z" },
        "list": { "type": { "name": "datetimeList" }, "value": [ "2024-01-31T08:30:00Z" ] }
      }
    },
    {
      "alias": "one_uuid",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "uuid" }, "value": "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" },
        "list": { "type": { "name": "uuidList" }, "value": [ "3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" ] }
      }
    },
    {
      "alias": "integer_in_one_decimal",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "integer" }, "value": 7 },
        "list": { "type": { "name": "decimalList" }, "value": [ "7" ] }
      }
    },
    {
      "alias": "null_in_one_string",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "string", "nullable": true }, "value": null },
        "list": { "type": { "name": "stringList" }, "value": [ "" ] }
      }
    },
    {
      "alias": "not_in_one",
      "expression": {
        "operator": "not",
        "type": { "name": "boolean" },
        "condition": {
          "operator": "in",
          "type": { "name": "boolean" },
          "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "list": { "type": { "name": "stringList" }, "value": [ "cancelled" ] }
        }
      }
    }
  ]
}
