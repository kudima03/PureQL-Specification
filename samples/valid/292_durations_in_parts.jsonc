// A duration in seconds split into days, hours, minutes and seconds with integerDivide and modulo of a
// decimal, as a label, a running sum and a sort key.
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "days",
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "left": {
          "operator": "datetimeDiffSeconds",
          "type": { "name": "decimal" },
          "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
          "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        },
        "right": { "type": { "name": "integer" }, "value": 86400 }
      }
    },
    {
      "alias": "hours",
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "left": {
          "operator": "modulo",
          "type": { "name": "decimal" },
          "left": {
            "operator": "datetimeDiffSeconds",
            "type": { "name": "decimal" },
            "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
            "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
          },
          "right": { "type": { "name": "integer" }, "value": 86400 }
        },
        "right": { "type": { "name": "integer" }, "value": 3600 }
      }
    },
    {
      "alias": "minutes",
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "left": {
          "operator": "modulo",
          "type": { "name": "decimal" },
          "left": {
            "operator": "datetimeDiffSeconds",
            "type": { "name": "decimal" },
            "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
            "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
          },
          "right": { "type": { "name": "integer" }, "value": 3600 }
        },
        "right": { "type": { "name": "integer" }, "value": 60 }
      }
    },
    {
      "alias": "seconds",
      "expression": {
        "operator": "modulo",
        "type": { "name": "decimal" },
        "left": {
          "operator": "datetimeDiffSeconds",
          "type": { "name": "decimal" },
          "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
          "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        },
        "right": { "type": { "name": "integer" }, "value": 60 }
      }
    },
    {
      "alias": "label",
      "expression": {
        "operator": "concatWith",
        "type": { "name": "string" },
        "values": [
          {
            "operator": "asString",
            "type": { "name": "string" },
            "operand": {
              "operator": "integerDivide",
              "type": { "name": "integer" },
              "left": {
                "operator": "datetimeDiffSeconds",
                "type": { "name": "decimal" },
                "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
                "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
              },
              "right": { "type": { "name": "integer" }, "value": 3600 }
            }
          },
          {
            "operator": "padStart",
            "type": { "name": "string" },
            "operand": {
              "operator": "asString",
              "type": { "name": "string" },
              "operand": {
                "operator": "integerDivide",
                "type": { "name": "integer" },
                "left": {
                  "operator": "modulo",
                  "type": { "name": "decimal" },
                  "left": {
                    "operator": "datetimeDiffSeconds",
                    "type": { "name": "decimal" },
                    "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
                    "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
                  },
                  "right": { "type": { "name": "integer" }, "value": 3600 }
                },
                "right": { "type": { "name": "integer" }, "value": 60 }
              }
            },
            "length": { "type": { "name": "integer" }, "value": 2 },
            "fill": { "type": { "name": "string" }, "value": "0" }
          }
        ],
        "separator": { "type": { "name": "string" }, "value": ":" }
      }
    },
    {
      "alias": "quarter_hours_running",
      "expression": {
        "operator": "sum",
        "type": { "name": "integer" },
        "selector": {
          "operator": "integerDivide",
          "type": { "name": "integer" },
          "left": {
            "operator": "datetimeDiffSeconds",
            "type": { "name": "decimal" },
            "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
            "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
          },
          "right": { "type": { "name": "integer" }, "value": 900 }
        },
        "over": {
          "partitionBy": [ { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } ],
          "orderBy": [
            { "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } } },
            { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
          ],
          "frame": { "preceding": "all" }
        }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "modulo",
        "type": { "name": "decimal" },
        "left": {
          "operator": "datetimeDiffSeconds",
          "type": { "name": "decimal" },
          "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
          "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        },
        "right": { "type": { "name": "integer" }, "value": 86400 }
      }
    },
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
