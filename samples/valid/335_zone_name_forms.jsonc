// Literal zone names of every form in the list of the schema: areas and cities, three parts, hyphens,
// underscores, mixed case, and the fixed offsets from Etc/GMT+12 to Etc/GMT-14.
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "zone_0",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "type": { "name": "string" }, "value": "Europe/Moscow" }
      }
    },
    {
