// take alone, skip alone and a parameter with a number in subqueries, plain and grouped, and in a main query
// after distinctBy.
{
  "subqueries": [
    {
      "name": "latest",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
          {
            "alias": "total",
            "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        ],
        "orderBy": [
          {
            "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "direction": "desc"
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ],
        "pagination": { "take": 100 }
      }
    },
    {
      "name": "older",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
          {
            "alias": "total",
            "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        ],
        "orderBy": [
          {
            "expression": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "direction": "desc"
          },
          { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
        ],
        "pagination": { "skip": 100 }
      }
    },
    {
      "name": "top_users",
      "query": {
        "from": { "entity": "orders" },
        "groupBy": [
          {
            "alias": "user_id",
            "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [
          { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } },
          { "alias": "orders", "expression": { "operator": "count", "type": { "name": "integer" } } }
        ],
        "orderBy": [
          { "expression": { "operator": "count", "type": { "name": "integer" } }, "direction": "desc" },
          { "expression": { "key": "user_id", "type": { "name": "uuid" } } }
        ],
        "pagination": { "skip": { "param": "skipped_users", "type": { "name": "integer" } }, "take": 10 }
      }
    }
  ],
  "from": { "subquery": "latest" },
  "where": {
    "operator": "not",
    "type": { "name": "boolean" },
    "condition": {
      "operator": "in",
      "type": { "name": "boolean" },
      "operand": { "source": "latest", "field": "id", "type": { "name": "uuid" } },
      "list": { "subquery": "older", "field": "id", "type": { "name": "uuid" } }
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "latest", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "total",
      "expression": { "source": "latest", "field": "total", "type": { "name": "decimal" } }
    }
  ],
  "orderBy": [
    {
      "expression": { "source": "latest", "field": "total", "type": { "name": "decimal" } },
      "direction": "desc"
    },
    { "expression": { "source": "latest", "field": "id", "type": { "name": "uuid" } } }
  ],
  "distinctBy": [ "id" ],
  "pagination": { "skip": 5, "take": { "param": "page_size", "type": { "name": "integer" } } }
}
