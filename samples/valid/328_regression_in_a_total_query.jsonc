// regressionSlope, regressionIntercept and regressionRSquared in a total query; the slope the other way round
// and by hand, the squared correlation next to regressionRSquared, and a predicted value.
{
  "from": { "entity": "order_items" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
    "right": { "type": { "name": "integer" }, "value": 0 }
  },
  "aggregate": [
    {
      "alias": "slope",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "intercept",
      "expression": {
        "operator": "regressionIntercept",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "r_squared",
      "expression": {
        "operator": "regressionRSquared",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "slope_of_large_lines",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "predicate": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
          "right": { "type": { "name": "integer" }, "value": 1 }
        }
      }
    },
    {
      "alias": "the_other_way",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "y": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
        "x": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "slope_by_hand",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          {
            "operator": "covariancePopulation",
            "type": { "name": "decimal", "nullable": true },
            "left": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } },
            "right": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } }
          },
          {
            "operator": "nullIfEqual",
            "type": { "name": "decimal", "nullable": true },
            "left": {
              "operator": "variancePopulation",
              "type": { "name": "decimal", "nullable": true },
              "selector": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
            },
            "right": { "type": { "name": "integer" }, "value": 0 }
          }
        ]
      }
    },
    {
      "alias": "correlation_squared",
      "expression": {
        "operator": "power",
        "type": { "name": "decimal", "nullable": true },
        "operand": {
          "operator": "correlation",
          "type": { "name": "decimal", "nullable": true },
          "left": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
          "right": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
        },
        "exponent": { "type": { "name": "integer" }, "value": 2 }
      }
    },
    {
      "alias": "predicted_price_of_ten",
      "expression": {
        "operator": "add",
        "type": { "name": "decimal", "nullable": true },
        "values": [
          {
            "operator": "regressionIntercept",
            "type": { "name": "decimal", "nullable": true },
            "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
            "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          },
          {
            "operator": "multiply",
            "type": { "name": "decimal", "nullable": true },
            "values": [
              {
                "operator": "regressionSlope",
                "type": { "name": "decimal", "nullable": true },
                "y": { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
                "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
              },
              { "type": { "name": "integer" }, "value": 10 }
            ]
          }
        ]
      }
    },
    {
      "alias": "with_a_nullable_operand",
      "expression": {
        "operator": "regressionSlope",
        "type": { "name": "decimal", "nullable": true },
        "y": {
          "operator": "multiply",
          "type": { "name": "decimal", "nullable": true },
          "values": [
            { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
            { "param": "discount", "type": { "name": "decimal", "nullable": true } }
          ]
        },
        "x": { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ]
}
