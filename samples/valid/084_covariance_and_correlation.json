{
  "from": {
    "entity": "order_items"
  },
  "groupBy": [
    {
      "alias": "product_id",
      "expression": {
        "source": "order_items",
        "field": "product_id",
        "type": {
          "name": "uuid"
        }
      }
    }
  ],
  "select": [
    {
      "alias": "product_id",
      "expression": {
        "key": "product_id",
        "type": {
          "name": "uuid"
        }
      }
    },
    {
      "alias": "lines",
      "expression": {
        "operator": "count",
        "type": {
          "name": "integer"
        }
      }
    },
    {
      "alias": "price_and_quantity_move_together",
      "expression": {
        "operator": "correlation",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "left": {
          "source": "order_items",
          "field": "unit_price",
          "type": {
            "name": "decimal"
          }
        },
        "right": {
          "source": "order_items",
          "field": "quantity",
          "type": {
            "name": "integer"
          }
        }
      }
    },
    {
      "alias": "covariance",
      "expression": {
        "operator": "covariancePopulation",
        "type": {
          "name": "decimal"
        },
        "left": {
          "source": "order_items",
          "field": "unit_price",
          "type": {
            "name": "decimal"
          }
        },
        "right": {
          "source": "order_items",
          "field": "quantity",
          "type": {
            "name": "integer"
          }
        }
      }
    },
    {
      "alias": "sample_covariance",
      "expression": {
        "operator": "covarianceSample",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "left": {
          "source": "order_items",
          "field": "unit_price",
          "type": {
            "name": "decimal"
          }
        },
        "right": {
          "source": "order_items",
          "field": "quantity",
          "type": {
            "name": "integer"
          }
        }
      }
    },
    {
      "alias": "returns_follow_quantity",
      "expression": {
        "operator": "correlation",
        "type": {
          "name": "decimal",
          "nullable": true
        },
        "left": {
          "source": "order_items",
          "field": "quantity",
          "type": {
            "name": "integer"
          }
        },
        "right": {
          "source": "order_items",
          "field": "returned_quantity",
          "type": {
            "name": "integer"
          }
        },
        "predicate": {
          "operator": "greaterThan",
          "type": {
            "name": "boolean"
          },
          "left": {
            "source": "order_items",
            "field": "quantity",
            "type": {
              "name": "integer"
            }
          },
          "right": {
            "type": {
              "name": "integer"
            },
            "value": 1
          }
        }
      }
    },
    {
      "alias": "price_variance",
      "expression": {
        "operator": "covariancePopulation",
        "type": {
          "name": "decimal"
        },
        "left": {
          "source": "order_items",
          "field": "unit_price",
          "type": {
            "name": "decimal"
          }
        },
        "right": {
          "source": "order_items",
          "field": "unit_price",
          "type": {
            "name": "decimal"
          }
        }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "key": "product_id",
        "type": {
          "name": "uuid"
        }
      }
    }
  ]
}
