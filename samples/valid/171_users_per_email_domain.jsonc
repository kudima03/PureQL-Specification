// replace, position and splitPart in a grouped query: a group key cut from an email and a second key cut from
// the first, position in where and in predicates, replace and position inside selectors, and both over group
// keys in select.
{
  "from": { "entity": "users" },
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "position",
      "type": { "name": "integer" },
      "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
      "pattern": { "type": { "name": "string" }, "value": "@" }
    },
    "right": { "type": { "name": "integer" }, "value": 0 }
  },
  "groupBy": [
    {
      "alias": "domain",
      "expression": {
        "operator": "lower",
        "type": { "name": "string" },
        "operand": {
          "operator": "splitPart",
          "type": { "name": "string" },
          "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
          "delimiter": { "type": { "name": "string" }, "value": "@" },
          "index": { "type": { "name": "integer" }, "value": -1 }
        }
      }
    },
    {
      "alias": "top_level",
      "expression": {
        "operator": "splitPart",
        "type": { "name": "string" },
        "operand": {
          "operator": "lower",
          "type": { "name": "string" },
          "operand": {
            "operator": "splitPart",
            "type": { "name": "string" },
            "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
            "delimiter": { "type": { "name": "string" }, "value": "@" },
            "index": { "type": { "name": "integer" }, "value": -1 }
          }
        },
        "delimiter": { "type": { "name": "string" }, "value": "." },
        "index": { "type": { "name": "integer" }, "value": -1 }
      }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "operator": "count", "type": { "name": "integer" } },
    "right": { "param": "minimum_users", "type": { "name": "integer" } }
  },
  "select": [
    { "alias": "domain", "expression": { "key": "domain", "type": { "name": "string" } } },
    { "alias": "top_level", "expression": { "key": "top_level", "type": { "name": "string" } } },
    { "alias": "users", "expression": { "operator": "count", "type": { "name": "integer" } } },
    {
      "alias": "shortest_user_part",
      "expression": {
        "operator": "min",
        "type": { "name": "integer" },
        "selector": {
          "operator": "subtract",
          "type": { "name": "integer" },
          "values": [
            {
              "operator": "position",
              "type": { "name": "integer" },
              "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
              "pattern": { "type": { "name": "string" }, "value": "@" }
            },
            { "type": { "name": "integer" }, "value": 1 }
          ]
        }
      }
    },
    {
      "alias": "with_plus_tag",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": {
            "operator": "position",
            "type": { "name": "integer" },
            "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
            "pattern": { "type": { "name": "string" }, "value": "+" }
          },
          "right": { "type": { "name": "integer" }, "value": 0 }
        }
      }
    },
    {
      "alias": "first_name_without_spaces",
      "expression": {
        "operator": "min",
        "type": { "name": "string" },
        "selector": {
          "operator": "replace",
          "type": { "name": "string" },
          "operand": { "source": "users", "field": "first_name", "type": { "name": "string" } },
          "pattern": { "type": { "name": "string" }, "value": " " },
          "replacement": { "type": { "name": "string" }, "value": "" }
        }
      }
    },
    {
      "alias": "label",
      "expression": {
        "operator": "replace",
        "type": { "name": "string" },
        "operand": { "key": "domain", "type": { "name": "string" } },
        "pattern": { "type": { "name": "string" }, "value": "." },
        "replacement": { "type": { "name": "string" }, "value": " dot " }
      }
    },
    {
      "alias": "dots_in_domain",
      "expression": {
        "operator": "subtract",
        "type": { "name": "integer" },
        "values": [
          {
            "operator": "length",
            "type": { "name": "integer" },
            "operand": { "key": "domain", "type": { "name": "string" } }
          },
          {
            "operator": "length",
            "type": { "name": "integer" },
            "operand": {
              "operator": "replace",
              "type": { "name": "string" },
              "operand": { "key": "domain", "type": { "name": "string" } },
              "pattern": { "type": { "name": "string" }, "value": "." },
              "replacement": { "type": { "name": "string" }, "value": "" }
            }
          }
        ]
      }
    }
  ],
  "orderBy": [
    { "expression": { "operator": "count", "type": { "name": "integer" } }, "direction": "desc" },
    { "expression": { "key": "domain", "type": { "name": "string" } } },
    { "expression": { "key": "top_level", "type": { "name": "string" } } }
  ]
}
