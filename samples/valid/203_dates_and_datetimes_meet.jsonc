// A date compared and combined with a datetime through asDate and asDatetime: in join.on, where and orderBy,
// a date and a time put together into an instant, and a datetime truncated to midnight through its date.
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "greaterThanOrEqual",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
            "right": {
              "operator": "asDate",
              "type": { "name": "date" },
              "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
            }
          }
        ]
      }
    }
  ],
  "where": {
    "operator": "lessThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
    "right": {
      "operator": "asDatetime",
      "type": { "name": "datetime", "nullable": true },
      "operand": { "source": "users", "field": "trial_start", "type": { "name": "date", "nullable": true } }
    }
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "delivery_window_opens",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime" },
        "operand": {
          "operator": "asDatetime",
          "type": { "name": "datetime" },
          "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "seconds": {
          "operator": "timeDiffSeconds",
          "type": { "name": "decimal" },
          "left": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
          "right": { "type": { "name": "time" }, "value": "00:00:00" }
        }
      }
    },
    {
      "alias": "seconds_from_window_to_shipping",
      "expression": {
        "operator": "datetimeDiffSeconds",
        "type": { "name": "decimal" },
        "left": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
        "right": {
          "operator": "datetimeAddSeconds",
          "type": { "name": "datetime" },
          "operand": {
            "operator": "asDatetime",
            "type": { "name": "datetime" },
            "operand": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
          },
          "seconds": {
            "operator": "timeDiffSeconds",
            "type": { "name": "decimal" },
            "left": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
            "right": { "type": { "name": "time" }, "value": "00:00:00" }
          }
        }
      }
    },
    {
      "alias": "days_from_sign_up",
      "expression": {
        "operator": "dateDiffDays",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
        }
      }
    },
    {
      "alias": "ordered_before_noon",
      "expression": {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "asTime",
          "type": { "name": "time" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        },
        "right": { "type": { "name": "time" }, "value": "12:00:00" }
      }
    },
    {
      "alias": "midnight_before_last_login",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime", "nullable": true },
        "operand": {
          "operator": "asDate",
          "type": { "name": "date", "nullable": true },
          "operand": {
            "source": "users",
            "field": "last_login_at",
            "type": { "name": "datetime", "nullable": true }
          }
        }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    },
    {
      "expression": {
        "operator": "asTime",
        "type": { "name": "time" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      },
      "direction": "desc"
    },
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ]
}
