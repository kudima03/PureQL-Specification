// A grouped next that reads the subquery in a join: a user reached along several paths is one row of the next
// level, with the number of paths, instead of one row for each path.
{
  "subqueries": [
    {
      "name": "reached",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "user_id", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            { "alias": "depth", "expression": { "type": { "name": "integer" }, "value": 0 } },
            { "alias": "paths", "expression": { "type": { "name": "integer" }, "value": 1 } }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "reached",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "reached", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "groupBy": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } }
          ],
          "select": [
            { "alias": "id", "expression": { "key": "id", "type": { "name": "uuid" } } },
            {
              "alias": "depth",
              "expression": {
                "operator": "add",
                "type": { "name": "integer" },
                "values": [
                  {
                    "operator": "max",
                    "type": { "name": "integer" },
                    "selector": { "source": "reached", "field": "depth", "type": { "name": "integer" } }
                  },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            },
            {
              "alias": "paths",
              "expression": {
                "operator": "sum",
                "type": { "name": "integer" },
                "selector": { "source": "reached", "field": "paths", "type": { "name": "integer" } }
              }
            }
          ]
        },
        "maxDepth": 20
      }
    }
  ],
  "from": { "subquery": "reached" },
  "groupBy": [
    {
      "alias": "depth",
      "expression": { "source": "reached", "field": "depth", "type": { "name": "integer" } }
    }
  ],
  "select": [
    { "alias": "depth", "expression": { "key": "depth", "type": { "name": "integer" } } },
    { "alias": "users", "expression": { "operator": "count", "type": { "name": "integer" } } },
    {
      "alias": "paths",
      "expression": {
        "operator": "sum",
        "type": { "name": "integer" },
        "selector": { "source": "reached", "field": "paths", "type": { "name": "integer" } }
      }
    }
  ],
  "orderBy": [ { "column": "depth" } ]
}
