// Two recursive subqueries: the second reads the first as an earlier subquery, in its seed and in an in list
// of its next. The main query combines both.
{
  "subqueries": [
    {
      "name": "team",
      "recursive": {
        "seed": {
          "from": { "entity": "users" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "lead", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "referrer_id",
              "expression": {
                "source": "users",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            }
          ]
        },
        "next": {
          "from": { "entity": "users" },
          "joins": [
            {
              "kind": "inner",
              "subquery": "team",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": {
                  "source": "users",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                },
                "right": { "source": "team", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "referrer_id",
              "expression": {
                "source": "users",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            }
          ]
        },
        "maxDepth": 50
      }
    },
    {
      "name": "upline",
      "recursive": {
        "seed": {
          "from": { "subquery": "team" },
          "where": {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "team", "field": "id", "type": { "name": "uuid" } },
            "right": { "param": "lead", "type": { "name": "uuid" } }
          },
          "select": [
            { "alias": "id", "expression": { "source": "team", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "referrer_id",
              "expression": {
                "source": "team",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            },
            { "alias": "level", "expression": { "type": { "name": "integer" }, "value": 0 } }
          ]
        },
        "next": {
          "from": { "subquery": "upline" },
          "joins": [
            {
              "kind": "inner",
              "entity": "users",
              "on": {
                "operator": "equal",
                "type": { "name": "boolean" },
                "left": { "source": "users", "field": "id", "type": { "name": "uuid" } },
                "right": {
                  "source": "upline",
                  "field": "referrer_id",
                  "type": { "name": "uuid", "nullable": true }
                }
              }
            }
          ],
          "where": {
            "operator": "not",
            "type": { "name": "boolean" },
            "condition": {
              "operator": "in",
              "type": { "name": "boolean" },
              "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } },
              "list": { "subquery": "team", "field": "id", "type": { "name": "uuid" } }
            }
          },
          "select": [
            { "alias": "id", "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } } },
            {
              "alias": "referrer_id",
              "expression": {
                "source": "users",
                "field": "referrer_id",
                "type": { "name": "uuid", "nullable": true }
              }
            },
            {
              "alias": "level",
              "expression": {
                "operator": "subtract",
                "type": { "name": "integer" },
                "values": [
                  { "source": "upline", "field": "level", "type": { "name": "integer" } },
                  { "type": { "name": "integer" }, "value": 1 }
                ]
              }
            }
          ]
        },
        "maxDepth": { "param": "levels_up", "type": { "name": "integer" } }
      }
    }
  ],
  "unionAll": [
    {
      "from": { "subquery": "team" },
      "select": [
        { "alias": "id", "expression": { "source": "team", "field": "id", "type": { "name": "uuid" } } },
        { "alias": "side", "expression": { "type": { "name": "string" }, "value": "below" } }
      ]
    },
    {
      "from": { "subquery": "upline" },
      "where": {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": { "source": "upline", "field": "level", "type": { "name": "integer" } },
        "right": { "type": { "name": "integer" }, "value": 0 }
      },
      "select": [
        { "alias": "id", "expression": { "source": "upline", "field": "id", "type": { "name": "uuid" } } },
        { "alias": "side", "expression": { "type": { "name": "string" }, "value": "above" } }
      ]
    }
  ]
}
