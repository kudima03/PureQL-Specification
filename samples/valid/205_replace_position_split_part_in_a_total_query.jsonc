// replace, position and splitPart in a total query: inside predicates and selectors, and over aggregates,
// where min is nullable and replace over it is lifted.
{
  "from": { "entity": "users" },
  "aggregate": [
    {
      "alias": "emails_without_at",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "equal",
          "type": { "name": "boolean" },
          "left": {
            "operator": "position",
            "type": { "name": "integer" },
            "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
            "pattern": { "type": { "name": "string" }, "value": "@" }
          },
          "right": { "type": { "name": "integer" }, "value": 0 }
        }
      }
    },
    {
      "alias": "longest_domain",
      "expression": {
        "operator": "max",
        "type": { "name": "integer", "nullable": true },
        "selector": {
          "operator": "length",
          "type": { "name": "integer" },
          "operand": {
            "operator": "splitPart",
            "type": { "name": "string" },
            "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
            "delimiter": { "type": { "name": "string" }, "value": "@" },
            "index": { "type": { "name": "integer" }, "value": -1 }
          }
        }
      }
    },
    {
      "alias": "first_domain",
      "expression": {
        "operator": "min",
        "type": { "name": "string", "nullable": true },
        "selector": {
          "operator": "splitPart",
          "type": { "name": "string" },
          "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
          "delimiter": { "type": { "name": "string" }, "value": "@" },
          "index": { "type": { "name": "integer" }, "value": -1 }
        }
      }
    },
    {
      "alias": "first_domain_label",
      "expression": {
        "operator": "replace",
        "type": { "name": "string", "nullable": true },
        "operand": {
          "operator": "min",
          "type": { "name": "string", "nullable": true },
          "selector": {
            "operator": "splitPart",
            "type": { "name": "string" },
            "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
            "delimiter": { "type": { "name": "string" }, "value": "@" },
            "index": { "type": { "name": "integer" }, "value": -1 }
          }
        },
        "pattern": { "type": { "name": "string" }, "value": "." },
        "replacement": { "type": { "name": "string" }, "value": " dot " }
      }
    },
    {
      "alias": "digits_in_count",
      "expression": {
        "operator": "length",
        "type": { "name": "integer" },
        "operand": {
          "operator": "replace",
          "type": { "name": "string" },
          "operand": {
            "operator": "asString",
            "type": { "name": "string" },
            "operand": { "operator": "count", "type": { "name": "integer" } }
          },
          "pattern": { "type": { "name": "string" }, "value": "0" },
          "replacement": { "type": { "name": "string" }, "value": "" }
        }
      }
    },
    {
      "alias": "all_have_a_user_part",
      "expression": {
        "operator": "all",
        "type": { "name": "boolean" },
        "predicate": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": {
            "operator": "position",
            "type": { "name": "integer" },
            "operand": { "source": "users", "field": "email", "type": { "name": "string" } },
            "pattern": { "type": { "name": "string" }, "value": "@" }
          },
          "right": { "type": { "name": "integer" }, "value": 1 }
        }
      }
    }
  ]
}
