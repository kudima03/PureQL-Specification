// asDate and asTime with the zone of a column in join.on, where, select, a window's partition, an aggregate's
// selector and orderBy; the same instant read in UTC next to it.
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": {
              "operator": "asDate",
              "type": { "name": "date" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            },
            "right": {
              "operator": "asDate",
              "type": { "name": "date" },
              "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          }
        ]
      }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": {
          "operator": "asTime",
          "type": { "name": "time" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "right": { "type": { "name": "time" }, "value": "09:00:00" }
      },
      {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "asTime",
          "type": { "name": "time" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "right": { "type": { "name": "time" }, "value": "18:00:00" }
      }
    ]
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "local_day",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "local_time",
      "expression": {
        "operator": "asTime",
        "type": { "name": "time" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "utc_day",
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    },
    {
      "alias": "orders_of_the_local_day",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            {
              "operator": "asDate",
              "type": { "name": "date" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          ]
        }
      }
    },
    {
      "alias": "days_to_ship",
      "expression": {
        "operator": "dateDiffDays",
        "type": { "name": "integer" },
        "left": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "shipped_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "right": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        }
      }
    },
    {
      "alias": "first_time_of_the_local_day",
      "expression": {
        "operator": "min",
        "type": { "name": "time" },
        "selector": {
          "operator": "asTime",
          "type": { "name": "time" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "over": {
          "partitionBy": [
            {
              "operator": "asDate",
              "type": { "name": "date" },
              "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          ]
        }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "asDate",
        "type": { "name": "date" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      },
      "direction": "desc"
    },
    {
      "expression": {
        "operator": "asTime",
        "type": { "name": "time" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    { "column": "id" }
  ]
}
