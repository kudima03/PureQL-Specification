// asDatetime of a date and datetimeFromParts with the zone of a column in join.on, where, select, an
// aggregate's predicate and selector, a window's partition and orderBy; UTC midnight next to the local one.
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "inner",
      "entity": "users",
      "on": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
            "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
          },
          {
            "operator": "greaterThanOrEqual",
            "type": { "name": "boolean" },
            "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "right": {
              "operator": "asDatetime",
              "type": { "name": "datetime" },
              "operand": { "source": "users", "field": "birth_date", "type": { "name": "date" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          }
        ]
      }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "right": {
          "operator": "asDatetime",
          "type": { "name": "datetime" },
          "operand": { "param": "from", "type": { "name": "date" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        }
      },
      {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "right": {
          "operator": "asDatetime",
          "type": { "name": "datetime" },
          "operand": { "param": "to", "type": { "name": "date" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        }
      }
    ]
  },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } },
    {
      "alias": "local_midnight",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime" },
        "operand": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "utc_midnight",
      "expression": {
        "operator": "asDatetime",
        "type": { "name": "datetime" },
        "operand": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      }
    },
    {
      "alias": "call_time_on_the_order_day",
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        },
        "time": { "source": "users", "field": "preferred_call_time", "type": { "name": "time" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      }
    },
    {
      "alias": "ordered_before_the_call_time",
      "expression": {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "right": {
          "operator": "datetimeFromParts",
          "type": { "name": "datetime" },
          "date": {
            "operator": "asDate",
            "type": { "name": "date" },
            "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
            "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
          },
          "time": { "source": "users", "field": "preferred_call_time", "type": { "name": "time" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        }
      }
    },
    {
      "alias": "orders_since_local_midnight",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "greaterThanOrEqual",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "right": {
            "operator": "asDatetime",
            "type": { "name": "datetime" },
            "operand": {
              "operator": "asDate",
              "type": { "name": "date" },
              "operand": { "param": "now", "type": { "name": "datetime" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            },
            "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
          }
        }
      }
    },
    {
      "alias": "latest_window",
      "expression": {
        "operator": "max",
        "type": { "name": "datetime" },
        "selector": {
          "operator": "datetimeFromParts",
          "type": { "name": "datetime" },
          "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
          "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
        }
      }
    },
    {
      "alias": "orders_of_the_window",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": {
          "partitionBy": [
            {
              "operator": "datetimeFromParts",
              "type": { "name": "datetime" },
              "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
              "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
              "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
            }
          ]
        }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "datetimeFromParts",
        "type": { "name": "datetime" },
        "date": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "time": { "source": "orders", "field": "delivery_window_start", "type": { "name": "time" } },
        "zone": { "source": "users", "field": "time_zone", "type": { "name": "string" } }
      },
      "direction": "desc"
    },
    { "column": "id" }
  ]
}
