// asString of every type that is not a string: fields, literals, a parameter and computed values, non-null
// and lifted over a nullable operand, and its result used by length, substring, concat and coalesce.
{
  "from": { "entity": "users" },
  "select": [
    {
      "alias": "integer",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } }
      }
    },
    {
      "alias": "integer_literal",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "type": { "name": "integer" }, "value": -42 }
      }
    },
    {
      "alias": "decimal_literal",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "type": { "name": "decimal" }, "value": "19.9" }
      }
    },
    {
      "alias": "decimal_computed",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": {
          "operator": "divide",
          "type": { "name": "decimal" },
          "values": [
            { "type": { "name": "integer" }, "value": 1 },
            { "type": { "name": "integer" }, "value": 8 }
          ]
        }
      }
    },
    {
      "alias": "boolean",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "is_active", "type": { "name": "boolean" } }
      }
    },
    {
      "alias": "boolean_nullable",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": {
          "source": "users",
          "field": "is_verified",
          "type": { "name": "boolean", "nullable": true }
        }
      }
    },
    {
      "alias": "date",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "birth_date", "type": { "name": "date" } }
      }
    },
    {
      "alias": "date_nullable",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "trial_start", "type": { "name": "date", "nullable": true } }
      }
    },
    {
      "alias": "time",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "preferred_call_time", "type": { "name": "time" } }
      }
    },
    {
      "alias": "datetime",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
      }
    },
    {
      "alias": "datetime_nullable",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": {
          "source": "users",
          "field": "last_login_at",
          "type": { "name": "datetime", "nullable": true }
        }
      }
    },
    {
      "alias": "uuid",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    },
    {
      "alias": "uuid_nullable",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": { "source": "users", "field": "referrer_id", "type": { "name": "uuid", "nullable": true } }
      }
    },
    {
      "alias": "parameter",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": { "param": "as_of", "type": { "name": "datetime" } }
      }
    },
    {
      "alias": "date_of_a_datetime",
      "expression": {
        "operator": "asString",
        "type": { "name": "string" },
        "operand": {
          "operator": "asDate",
          "type": { "name": "date" },
          "operand": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
        }
      }
    },
    {
      "alias": "time_of_a_datetime",
      "expression": {
        "operator": "asString",
        "type": { "name": "string", "nullable": true },
        "operand": {
          "operator": "asTime",
          "type": { "name": "time", "nullable": true },
          "operand": {
            "source": "users",
            "field": "last_login_at",
            "type": { "name": "datetime", "nullable": true }
          }
        }
      }
    },
    {
      "alias": "length_of_an_integer",
      "expression": {
        "operator": "length",
        "type": { "name": "integer", "nullable": true },
        "operand": {
          "operator": "asString",
          "type": { "name": "string", "nullable": true },
          "operand": { "source": "users", "field": "age", "type": { "name": "integer", "nullable": true } }
        }
      }
    },
    {
      "alias": "short_id",
      "expression": {
        "operator": "substring",
        "type": { "name": "string" },
        "operand": {
          "operator": "asString",
          "type": { "name": "string" },
          "operand": { "source": "users", "field": "id", "type": { "name": "uuid" } }
        },
        "start": { "type": { "name": "integer" }, "value": 1 },
        "length": { "type": { "name": "integer" }, "value": 8 }
      }
    },
    {
      "alias": "name_and_age",
      "expression": {
        "operator": "concat",
        "type": { "name": "string" },
        "values": [
          { "source": "users", "field": "first_name", "type": { "name": "string" } },
          { "type": { "name": "string" }, "value": " (" },
          {
            "operator": "coalesce",
            "type": { "name": "string" },
            "values": [
              {
                "operator": "asString",
                "type": { "name": "string", "nullable": true },
                "operand": {
                  "source": "users",
                  "field": "age",
                  "type": { "name": "integer", "nullable": true }
                }
              },
              { "type": { "name": "string" }, "value": "?" }
            ]
          },
          { "type": { "name": "string" }, "value": ")" }
        ]
      }
    }
  ]
}
