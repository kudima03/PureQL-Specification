{
  "description": "decimal field as where",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
  }
}
