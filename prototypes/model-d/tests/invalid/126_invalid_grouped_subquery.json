{
  "description": "A grouped subquery with a field in having",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "subqueries": [
      {
        "name": "per_user",
        "query": {
          "from": { "entity": "orders" },
          "groupBy": [
            { "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }
          ],
          "select": [
            {
              "alias": "user_id",
              "type": { "name": "uuid" },
              "expression": { "key": 0, "type": { "name": "uuid" } }
            },
            {
              "alias": "orders",
              "type": { "name": "integer" },
              "expression": { "operator": "count", "over": "group" }
            }
          ],
          "having": {
            "operator": "equal",
            "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
            "right": { "type": { "name": "string" }, "value": "paid" }
          }
        }
      }
    ]
  }
}
