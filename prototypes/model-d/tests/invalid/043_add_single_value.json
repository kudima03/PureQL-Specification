{
  "description": "add with one operand",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "integer" },
        "expression": {
          "operator": "add",
          "values": [{ "source": "orders", "field": "quantity", "type": { "name": "integer" } }]
        }
      }
    ]
  }
}
