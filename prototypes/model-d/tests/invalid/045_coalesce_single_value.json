{
  "description": "coalesce with one operand",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "string", "nullable": true },
        "expression": {
          "operator": "coalesce",
          "values": [{ "source": "orders", "field": "code", "type": { "name": "string", "nullable": true } }]
        }
      }
    ]
  }
}
