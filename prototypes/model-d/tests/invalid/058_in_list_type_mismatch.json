{
  "description": "in(uuid field, stringList)",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "in",
      "value": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
      "list": { "param_name": "ids", "type": { "name": "stringList" } }
    }
  }
}
