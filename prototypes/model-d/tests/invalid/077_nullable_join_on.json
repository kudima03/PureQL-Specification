{
  "description": "Nullable boolean parameter as join.on",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "joins": [
      {
        "type": "inner",
        "entity": "users",
        "on": { "param_name": "join_all", "type": { "name": "boolean", "nullable": true } }
      }
    ]
  }
}
