{
  "description": "from naming both an entity and a subquery",
  "query": {
    "from": { "entity": "orders", "subquery": "recent" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ]
  }
}
