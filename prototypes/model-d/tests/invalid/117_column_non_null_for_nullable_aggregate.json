{
  "description": "Column declared non-null, but min over all rows is nullable",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "min",
          "over": "all",
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      }
    ]
  }
}
