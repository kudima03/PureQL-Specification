{
  "description": "coalesce of nullable booleans only is still nullable, so not a condition",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "coalesce",
      "values": [
        { "source": "orders", "field": "is_verified", "type": { "name": "boolean", "nullable": true } },
        { "param_name": "fallback", "type": { "name": "boolean", "nullable": true } }
      ]
    }
  }
}
