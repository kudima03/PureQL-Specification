{
  "description": "integer literal written as a JSON string",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "greaterThan",
      "left": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
      "right": { "type": { "name": "integer" }, "value": "5" }
    }
  }
}
