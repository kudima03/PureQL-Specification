{
  "description": "join type cross",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "joins": [{ "type": "cross", "entity": "users", "on": { "type": { "name": "boolean" }, "value": true } }]
  }
}
