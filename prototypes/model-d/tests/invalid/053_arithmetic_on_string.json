{
  "description": "add(string field, integer)",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "add",
          "values": [
            { "source": "orders", "field": "name", "type": { "name": "string" } },
            { "type": { "name": "integer" }, "value": 1 }
          ]
        }
      }
    ]
  }
}
