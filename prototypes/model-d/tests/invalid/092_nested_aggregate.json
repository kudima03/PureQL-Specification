{
  "description": "Aggregate inside an aggregate selector (old ambiguity B2)",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [{ "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
    "select": [
      {
        "alias": "c",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "sum",
          "over": "group",
          "selector": {
            "operator": "sum",
            "over": "group",
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        }
      }
    ]
  }
}
