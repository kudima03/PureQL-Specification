{
  "description": "in over a subquery column without a type",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "in",
      "value": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
      "list": { "subquery": "vip_users", "field": "id" }
    }
  }
}
