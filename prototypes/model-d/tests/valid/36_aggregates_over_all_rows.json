{
  "description": "Aggregates over all rows: count / sum non-null, min / max / average nullable",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "orders",
        "type": { "name": "integer" },
        "expression": { "operator": "count", "over": "all" }
      },
      {
        "alias": "revenue",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "sum",
          "over": "all",
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      },
      {
        "alias": "smallest",
        "type": { "name": "decimal", "nullable": true },
        "expression": {
          "operator": "min",
          "over": "all",
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      },
      {
        "alias": "latest",
        "type": { "name": "datetime", "nullable": true },
        "expression": {
          "operator": "max",
          "over": "all",
          "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      },
      {
        "alias": "average",
        "type": { "name": "decimal", "nullable": true },
        "expression": {
          "operator": "average",
          "over": "all",
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      },
      {
        "alias": "any_refund",
        "type": { "name": "boolean" },
        "expression": {
          "operator": "any",
          "over": "all",
          "predicate": {
            "operator": "equal",
            "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
            "right": { "type": { "name": "string" }, "value": "refunded" }
          }
        }
      },
      {
        "alias": "all_paid",
        "type": { "name": "boolean" },
        "expression": {
          "operator": "all",
          "over": "all",
          "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
        }
      }
    ]
  }
}
