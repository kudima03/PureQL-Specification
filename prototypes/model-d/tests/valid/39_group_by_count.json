{
  "description": "Group by one field and count",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [{ "expression": { "source": "orders", "field": "status", "type": { "name": "string" } } }],
    "select": [
      {
        "alias": "status",
        "type": { "name": "string" },
        "expression": { "key": 0, "type": { "name": "string" } }
      },
      {
        "alias": "orders",
        "type": { "name": "integer" },
        "expression": { "operator": "count", "over": "group" }
      }
    ]
  }
}
