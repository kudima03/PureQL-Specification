{
  "description": "orderBy on a computed per-row expression",
  "query": {
    "from": { "entity": "order_items" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "order_items", "field": "id", "type": { "name": "uuid" } }
      },
      {
        "alias": "subtotal",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "multiply",
          "values": [
            { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          ]
        }
      }
    ],
    "orderBy": [
      {
        "expression": {
          "operator": "multiply",
          "values": [
            { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
            { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
          ]
        },
        "direction": "desc"
      }
    ]
  }
}
