{
  "description": "Select one field from one entity",
  "query": {
    "from": { "entity": "users" },
    "select": [
      {
        "alias": "name",
        "type": { "name": "string" },
        "expression": { "source": "users", "field": "name", "type": { "name": "string" } }
      }
    ]
  }
}
