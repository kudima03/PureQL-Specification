{
  "description": "distinct over a single column",
  "query": {
    "from": { "entity": "orders" },
    "distinct": true,
    "select": [
      {
        "alias": "status",
        "type": { "name": "string" },
        "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
      }
    ]
  }
}
