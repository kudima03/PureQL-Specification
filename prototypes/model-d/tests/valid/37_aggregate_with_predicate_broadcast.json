{
  "description": "Filtered aggregates over all rows broadcast next to row columns",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      },
      {
        "alias": "total",
        "type": { "name": "decimal" },
        "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      },
      {
        "alias": "paid_orders",
        "type": { "name": "integer" },
        "expression": {
          "operator": "count",
          "over": "all",
          "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
        }
      },
      {
        "alias": "paid_revenue",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "sum",
          "over": "all",
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
        }
      }
    ]
  }
}
