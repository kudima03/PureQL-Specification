{
  "description": "Right join: the left side becomes nullable",
  "query": {
    "from": { "entity": "users" },
    "joins": [
      {
        "type": "right",
        "entity": "orders",
        "on": {
          "operator": "equal",
          "left": { "source": "users", "field": "id", "type": { "name": "uuid", "nullable": true } },
          "right": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
        }
      }
    ],
    "select": [
      {
        "alias": "order_id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      },
      {
        "alias": "email",
        "type": { "name": "string", "nullable": true },
        "expression": { "source": "users", "field": "email", "type": { "name": "string", "nullable": true } }
      }
    ]
  }
}
