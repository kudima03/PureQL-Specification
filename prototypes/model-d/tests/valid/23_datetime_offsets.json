{
  "description": "datetime literals with a non-UTC offset and with fractional seconds",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "and",
      "conditions": [
        {
          "operator": "greaterThanOrEqual",
          "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "right": { "type": { "name": "datetime" }, "value": "2024-01-01T03:00:00+03:00" }
        },
        {
          "operator": "lessThan",
          "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "right": { "type": { "name": "datetime" }, "value": "2024-02-01T00:00:00.123456+05:30" }
        }
      ]
    }
  }
}
