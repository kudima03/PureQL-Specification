{
  "description": "String concatenation",
  "query": {
    "from": { "entity": "users" },
    "select": [
      {
        "alias": "full_name",
        "type": { "name": "string" },
        "expression": {
          "operator": "concat",
          "values": [
            { "source": "users", "field": "first_name", "type": { "name": "string" } },
            { "type": { "name": "string" }, "value": " " },
            { "source": "users", "field": "last_name", "type": { "name": "string" } }
          ]
        }
      }
    ]
  }
}
