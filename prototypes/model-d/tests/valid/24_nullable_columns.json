{
  "description": "Nullable fields selected into nullable columns",
  "query": {
    "from": { "entity": "users" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      },
      {
        "alias": "middle_name",
        "type": { "name": "string", "nullable": true },
        "expression": {
          "source": "users",
          "field": "middle_name",
          "type": { "name": "string", "nullable": true }
        }
      },
      {
        "alias": "deleted_at",
        "type": { "name": "datetime", "nullable": true },
        "expression": {
          "source": "users",
          "field": "deleted_at",
          "type": { "name": "datetime", "nullable": true }
        }
      }
    ]
  }
}
