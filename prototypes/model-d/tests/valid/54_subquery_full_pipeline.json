{
  "description": "Three subqueries (join + filter, grouped with having, anti-join list) feeding a joined, filtered, ordered, paged main query",
  "query": {
    "subqueries": [
      {
        "name": "paid_lines",
        "query": {
          "from": { "entity": "order_items" },
          "joins": [
            {
              "type": "inner",
              "entity": "orders",
              "on": {
                "operator": "equal",
                "left": { "source": "order_items", "field": "order_id", "type": { "name": "uuid" } },
                "right": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
              }
            }
          ],
          "where": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
          "select": [
            {
              "alias": "user_id",
              "type": { "name": "uuid" },
              "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
            },
            {
              "alias": "line_total",
              "type": { "name": "decimal" },
              "expression": {
                "operator": "multiply",
                "values": [
                  { "source": "order_items", "field": "unit_price", "type": { "name": "decimal" } },
                  { "source": "order_items", "field": "quantity", "type": { "name": "integer" } }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "user_revenue",
        "query": {
          "from": { "subquery": "paid_lines" },
          "groupBy": [
            { "expression": { "source": "paid_lines", "field": "user_id", "type": { "name": "uuid" } } }
          ],
          "having": {
            "operator": "greaterThan",
            "left": {
              "operator": "sum",
              "over": "group",
              "selector": { "source": "paid_lines", "field": "line_total", "type": { "name": "decimal" } }
            },
            "right": { "param_name": "min_revenue", "type": { "name": "decimal" } }
          },
          "select": [
            {
              "alias": "user_id",
              "type": { "name": "uuid" },
              "expression": { "key": 0, "type": { "name": "uuid" } }
            },
            {
              "alias": "revenue",
              "type": { "name": "decimal" },
              "expression": {
                "operator": "sum",
                "over": "group",
                "selector": { "source": "paid_lines", "field": "line_total", "type": { "name": "decimal" } }
              }
            },
            {
              "alias": "lines",
              "type": { "name": "integer" },
              "expression": { "operator": "count", "over": "group" }
            }
          ]
        }
      },
      {
        "name": "churned",
        "query": {
          "from": { "entity": "users" },
          "where": {
            "operator": "lessThan",
            "left": {
              "source": "users",
              "field": "last_login_at",
              "type": { "name": "datetime", "nullable": true }
            },
            "right": { "param_name": "cutoff", "type": { "name": "datetime" } }
          },
          "select": [
            {
              "alias": "id",
              "type": { "name": "uuid" },
              "expression": { "source": "users", "field": "id", "type": { "name": "uuid" } }
            }
          ]
        }
      }
    ],
    "from": { "entity": "users", "alias": "u" },
    "joins": [
      {
        "type": "inner",
        "subquery": "user_revenue",
        "on": {
          "operator": "equal",
          "left": { "source": "u", "field": "id", "type": { "name": "uuid" } },
          "right": { "source": "user_revenue", "field": "user_id", "type": { "name": "uuid" } }
        }
      }
    ],
    "where": {
      "operator": "not",
      "condition": {
        "operator": "in",
        "value": { "source": "u", "field": "id", "type": { "name": "uuid" } },
        "list": { "subquery": "churned", "field": "id", "type": { "name": "uuid" } }
      }
    },
    "select": [
      {
        "alias": "email",
        "type": { "name": "string" },
        "expression": { "source": "u", "field": "email", "type": { "name": "string" } }
      },
      {
        "alias": "revenue",
        "type": { "name": "decimal" },
        "expression": { "source": "user_revenue", "field": "revenue", "type": { "name": "decimal" } }
      },
      {
        "alias": "average_line",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "divide",
          "values": [
            { "source": "user_revenue", "field": "revenue", "type": { "name": "decimal" } },
            { "source": "user_revenue", "field": "lines", "type": { "name": "integer" } }
          ]
        }
      }
    ],
    "orderBy": [
      {
        "expression": { "source": "user_revenue", "field": "revenue", "type": { "name": "decimal" } },
        "direction": "desc"
      },
      { "expression": { "source": "u", "field": "email", "type": { "name": "string" } } }
    ],
    "pagination": { "skip": 0, "take": 50 }
  }
}
