{
  "description": "and.conditions given a row predicate instead of an array (old hole A1)",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [
      {
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    ],
    "select": [
      {
        "alias": "user_id",
        "type": { "name": "uuid" },
        "expression": { "key": 0, "type": { "name": "uuid" } }
      },
      {
        "alias": "orders",
        "type": { "name": "integer" },
        "expression": { "operator": "count", "over": "group" }
      }
    ],
    "having": {
      "operator": "and",
      "conditions": {
        "operator": "equal",
        "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "right": { "type": { "name": "string" }, "value": "paid" }
      }
    }
  }
}
