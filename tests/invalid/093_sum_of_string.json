{
  "description": "sum over a string selector",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [
      {
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    ],
    "select": [
      {
        "alias": "c",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "sum",
          "over": "group",
          "selector": { "source": "orders", "field": "status", "type": { "name": "string" } }
        }
      }
    ]
  }
}
