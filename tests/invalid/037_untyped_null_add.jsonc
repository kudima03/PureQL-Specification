// Regression: add over untyped nulls (type would come from nowhere)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "add",
        "type": { "name": "decimal" },
        "values": [
          { "type": { "name": "null" }, "value": null },
          { "type": { "name": "null" }, "value": null }
        ]
      }
    }
  ]
}
