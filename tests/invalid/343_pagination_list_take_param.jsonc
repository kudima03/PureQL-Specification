// pagination take as an integerList parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [{ "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }],
  "pagination": { "skip": 0, "take": { "param": "sizes", "type": { "name": "integerList" } } }
}
