// any without a predicate
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": { "operator": "any", "type": { "name": "boolean" }, "over": "group" }
    }
  ]
}
