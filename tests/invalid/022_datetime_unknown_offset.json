{
  "description": "datetime literal with -00:00 (RFC 3339 'offset unknown')",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "greaterThan",
      "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
      "right": { "type": { "name": "datetime" }, "value": "2024-01-01T00:00:00-00:00" }
    }
  }
}
