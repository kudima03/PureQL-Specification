// equal(field, field) in having (old hole A2)
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } },
    {
      "alias": "orders",
      "type": { "name": "integer" },
      "expression": { "operator": "count", "over": "group" }
    }
  ],
  "having": {
    "operator": "equal",
    "left": { "source": "orders", "field": "a", "type": { "name": "decimal" } },
    "right": { "source": "orders", "field": "b", "type": { "name": "decimal" } }
  }
}
