// equal(field, field) in having (old hole A2)
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "user_id", "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ],
  "having": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "a", "type": { "name": "decimal" } },
    "right": { "source": "orders", "field": "b", "type": { "name": "decimal" } }
  }
}
