// min over a group with a predicate declared non-null: no row of the group may match, so it is nullable
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "over": "group",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    }
  ]
}
