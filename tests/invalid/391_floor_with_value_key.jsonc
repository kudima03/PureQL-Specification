// floor written with value instead of operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer" },
        "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
