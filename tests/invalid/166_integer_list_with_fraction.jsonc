// integerList literal with a fractional element
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "value": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
    "list": { "type": { "name": "integerList" }, "value": [1, 2.5] }
  }
}
