// Bare field in having (group context has no fields)
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "user_id", "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ],
  "having": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
    "right": { "type": { "name": "string" }, "value": "paid" }
  }
}
