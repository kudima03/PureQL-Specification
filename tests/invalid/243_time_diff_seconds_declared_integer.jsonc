// timeDiffSeconds is decimal, declared integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "timeDiffSeconds",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "window_end", "type": { "name": "time" } },
        "right": { "source": "orders", "field": "window_start", "type": { "name": "time" } }
      }
    }
  ]
}
