// lessThan between a boolean and an integer: both operands must be of one family
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "lessThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
    "right": { "type": { "name": "integer" }, "value": 1 }
  }
}
