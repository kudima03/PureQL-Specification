// if with a nullable branch is nullable, so not a condition
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "if",
    "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
    "then": { "source": "orders", "field": "is_verified", "type": { "name": "boolean", "nullable": true } },
    "else": { "type": { "name": "boolean" }, "value": true }
  }
}
