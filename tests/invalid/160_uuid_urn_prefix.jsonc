// uuid literal with a urn:uuid: prefix
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
    "right": { "type": { "name": "uuid" }, "value": "urn:uuid:3f2a6c1e-8b4d-4e2a-9c1f-1a2b3c4d5e6f" }
  }
}
