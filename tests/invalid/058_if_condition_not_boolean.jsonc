// if.condition is a string
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "string" },
      "expression": {
        "operator": "if",
        "condition": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "then": { "type": { "name": "string" }, "value": "a" },
        "else": { "type": { "name": "string" }, "value": "b" }
      }
    }
  ]
}
