// ceiling with digits (only round takes digits)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "ceiling",
        "type": { "name": "integer" },
        "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
