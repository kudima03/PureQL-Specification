{
  "description": "Non-key field in grouped select",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [{ "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
    "select": [
      {
        "alias": "user_id",
        "type": { "name": "uuid" },
        "expression": { "key": 0, "type": { "name": "uuid" } }
      },
      {
        "alias": "status",
        "type": { "name": "string" },
        "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
      }
    ]
  }
}
