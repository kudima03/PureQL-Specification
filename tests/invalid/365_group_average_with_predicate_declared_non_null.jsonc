// average over a group with a predicate is nullable; the node declares it non-null although the column is nullable
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal", "nullable": true },
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    }
  ]
}
