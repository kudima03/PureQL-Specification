// min over a uuid selector
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "min",
        "type": { "name": "uuid" },
        "selector": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
