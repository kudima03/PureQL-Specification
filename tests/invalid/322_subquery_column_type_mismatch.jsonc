// A subquery column declared uuid whose expression is a string
{
  "subqueries": [
    {
      "name": "recent",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "id",
            "type": { "name": "uuid" },
            "expression": { "source": "orders", "field": "status", "type": { "name": "string" } }
          }
        ]
      }
    }
  ],
  "from": { "subquery": "recent" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "recent", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
