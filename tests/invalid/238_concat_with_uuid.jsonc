// concat(string, uuid): no implicit conversion to string
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "concat",
        "type": { "name": "string" },
        "values": [
          { "type": { "name": "string" }, "value": "order-" },
          { "source": "orders", "field": "id", "type": { "name": "uuid" } }
        ]
      }
    }
  ]
}
