// in whose operand is itself a list parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "operand": { "param": "a", "type": { "name": "stringList" } },
    "list": { "param": "b", "type": { "name": "stringList" } }
  }
}
