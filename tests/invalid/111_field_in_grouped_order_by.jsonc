// Field as grouped orderBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "user_id", "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ],
  "orderBy": [{ "expression": { "source": "orders", "field": "total", "type": { "name": "decimal" } } }]
}
