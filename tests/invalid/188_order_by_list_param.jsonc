// orderBy over a list parameter (a list is not a column)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [{ "expression": { "param": "statuses", "type": { "name": "stringList" } } }]
}
