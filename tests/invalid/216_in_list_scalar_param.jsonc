// in over a scalar string parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "value": { "source": "orders", "field": "status", "type": { "name": "string" } },
    "list": { "param_name": "status", "type": { "name": "string" } }
  }
}
