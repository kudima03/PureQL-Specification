// any is boolean, declared integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "any",
        "type": { "name": "integer" },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    }
  ]
}
