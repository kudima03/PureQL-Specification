// Group key reference in where
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "user_id", "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "key": "user_id", "type": { "name": "uuid" } },
    "right": { "key": "user_id", "type": { "name": "uuid" } }
  }
}
