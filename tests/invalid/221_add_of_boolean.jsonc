// add(boolean, integer)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [
          { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
