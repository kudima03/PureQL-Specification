// having with an aggregate inside an aggregate predicate
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "expression": { "key": 0, "type": { "name": "uuid" } } }
  ],
  "having": {
    "operator": "any",
    "type": { "name": "boolean" },
    "over": "group",
    "predicate": {
      "operator": "greaterThan",
      "type": { "name": "boolean" },
      "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
      "right": {
        "operator": "average",
        "type": { "name": "decimal", "nullable": true },
        "over": "all",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  }
}
