{
  "description": "if with then: decimal and else: string",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "decimal" },
        "expression": {
          "operator": "if",
          "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
          "then": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "else": { "type": { "name": "string" }, "value": "n/a" }
        }
      }
    ]
  }
}
