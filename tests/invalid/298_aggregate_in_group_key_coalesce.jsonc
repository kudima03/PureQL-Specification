// Aggregate hidden in a coalesce inside a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": {
        "operator": "coalesce",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "discount", "type": { "name": "decimal", "nullable": true } },
          {
            "operator": "sum",
            "type": { "name": "decimal" },
            "over": "all",
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        ]
      }
    }
  ],
  "select": [
    {
      "alias": "discount",
      "expression": { "key": 0, "type": { "name": "decimal" } }
    }
  ]
}
