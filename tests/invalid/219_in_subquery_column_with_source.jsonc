// in over a subquery column written as a field (source instead of subquery)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "value": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
    "list": { "source": "vip_users", "field": "id", "type": { "name": "uuid" } }
  }
}
