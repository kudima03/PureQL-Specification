// in over an inline query (subqueries must be declared and named)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "value": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
    "list": {
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "id",
            "type": { "name": "uuid" },
            "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
          }
        ],
        "distinct": true
      }
    }
  }
}
