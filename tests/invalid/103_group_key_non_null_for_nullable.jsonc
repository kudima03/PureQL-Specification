// groupBy key declared non-null, expression is a nullable field
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "string" },
      "expression": {
        "source": "orders",
        "field": "coupon_code",
        "type": { "name": "string", "nullable": true }
      }
    }
  ],
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } },
    {
      "alias": "orders",
      "type": { "name": "integer" },
      "expression": { "operator": "count", "over": "group" }
    }
  ]
}
