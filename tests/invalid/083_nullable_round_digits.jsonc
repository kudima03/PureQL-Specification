// round.digits must be a non-null integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer", "nullable": true }, "value": null }
      }
    }
  ]
}
