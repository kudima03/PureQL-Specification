// Nullable boolean inside not
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "not",
    "type": { "name": "boolean" },
    "condition": {
      "source": "orders",
      "field": "is_verified",
      "type": { "name": "boolean", "nullable": true }
    }
  }
}
