// dateAddDays with decimal days
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "date" },
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
