// round with decimal digits
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "round",
        "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "decimal" }, "value": 2.5 }
      }
    }
  ]
}
