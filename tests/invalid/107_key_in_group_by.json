{
  "description": "Group key reference inside groupBy itself",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [{ "expression": { "key": 0, "type": { "name": "uuid" } } }],
    "select": [
      {
        "alias": "user_id",
        "type": { "name": "uuid" },
        "expression": { "key": 0, "type": { "name": "uuid" } }
      },
      {
        "alias": "orders",
        "type": { "name": "integer" },
        "expression": { "operator": "count", "over": "group" }
      }
    ]
  }
}
