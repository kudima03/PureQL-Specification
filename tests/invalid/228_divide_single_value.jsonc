// divide with one operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal" },
        "values": [{ "source": "orders", "field": "total", "type": { "name": "decimal" } }]
      }
    }
  ]
}
