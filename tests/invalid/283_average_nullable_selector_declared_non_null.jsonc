// average over a group of a nullable selector, declared non-null
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": 0, "type": { "name": "uuid" } }
    },
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": {
          "source": "orders",
          "field": "discount",
          "type": { "name": "decimal", "nullable": true }
        }
      }
    }
  ]
}
