// lessThanOrEqual on uuid
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "lessThanOrEqual",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
    "right": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
  }
}
