// groupBy key declared string, expression is a date
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "string" },
      "expression": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
    }
  ],
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } },
    {
      "alias": "orders",
      "type": { "name": "integer" },
      "expression": { "operator": "count", "over": "group" }
    }
  ]
}
