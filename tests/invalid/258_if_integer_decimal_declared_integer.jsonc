// if with integer and decimal branches is decimal, declared integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "if",
        "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "then": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
        "else": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
