// uuid literal in upper case: a uuid is written in lower case
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
    "right": { "type": { "name": "uuid" }, "value": "3F2A6C1E-8B4D-4E2A-9C1F-1A2B3C4D5E6F" }
  }
}
