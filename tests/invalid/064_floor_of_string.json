{
  "description": "floor over a string",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "integer" },
        "expression": {
          "operator": "floor",
          "value": { "source": "orders", "field": "name", "type": { "name": "string" } }
        }
      }
    ]
  }
}
