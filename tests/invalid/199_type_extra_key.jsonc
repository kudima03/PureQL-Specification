// Type with an unknown length key
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "status", "type": { "name": "string", "length": 20 } },
    "right": { "type": { "name": "string" }, "value": "paid" }
  }
}
