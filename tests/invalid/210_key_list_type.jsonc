// Group key reference typed as a list
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": 0, "type": { "name": "uuidList" } }
    }
  ]
}
