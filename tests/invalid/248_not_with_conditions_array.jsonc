// not written with a conditions array
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "not",
    "type": { "name": "boolean" },
    "conditions": [{ "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }]
  }
}
