// Group key reference inside join.on
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0, "type": { "name": "uuid" } } }
  ],
  "joins": [
    {
      "type": "inner",
      "entity": "users",
      "on": {
        "operator": "equal",
        "left": { "key": 0, "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
