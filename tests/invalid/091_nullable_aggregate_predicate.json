{
  "description": "Nullable boolean as an aggregate predicate",
  "query": {
    "from": { "entity": "orders" },
    "groupBy": [{ "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
    "select": [
      {
        "alias": "c",
        "type": { "name": "boolean" },
        "expression": {
          "operator": "any",
          "over": "group",
          "predicate": {
            "source": "orders",
            "field": "is_verified",
            "type": { "name": "boolean", "nullable": true }
          }
        }
      }
    ]
  }
}
