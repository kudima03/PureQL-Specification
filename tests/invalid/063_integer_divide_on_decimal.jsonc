// integerDivide over a decimal operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "integerDivide",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "right": { "type": { "name": "integer" }, "value": 2 }
      }
    }
  ]
}
