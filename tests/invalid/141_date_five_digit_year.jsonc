// date literal with a five-digit year
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "greaterThan",
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": { "type": { "name": "date" }, "value": "12024-01-01" }
  }
}
