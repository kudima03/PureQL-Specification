// groupBy key whose divide is declared integer: divide is always decimal
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "key_0",
      "expression": {
        "operator": "divide",
        "type": { "name": "integer" },
        "values": [
          { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "integer" }, "value": 2 }
        ]
      }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "key_0", "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ]
}
