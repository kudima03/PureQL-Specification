// and.conditions given a single condition instead of an array
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
  }
}
