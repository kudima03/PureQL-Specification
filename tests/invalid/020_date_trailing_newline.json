{
  "description": "date literal with a trailing newline (Python's $ would accept it)",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "greaterThan",
      "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
      "right": { "type": { "name": "date" }, "value": "2024-01-01\n" }
    }
  }
}
