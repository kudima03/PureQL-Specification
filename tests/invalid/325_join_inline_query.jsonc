// join on an inline query (subqueries must be declared and named)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "joins": [
    {
      "type": "inner",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "id",
            "type": { "name": "uuid" },
            "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
          }
        ]
      },
      "alias": "r",
      "on": { "type": { "name": "boolean" }, "value": true }
    }
  ]
}
