// joins given a single join object instead of an array
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "joins": {
    "type": "inner",
    "entity": "users",
    "on": {
      "operator": "equal",
      "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
      "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
    }
  }
}
