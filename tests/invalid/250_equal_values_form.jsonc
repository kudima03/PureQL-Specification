// equal written with values instead of left / right
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "values": [
      { "source": "orders", "field": "status", "type": { "name": "string" } },
      { "type": { "name": "string" }, "value": "paid" }
    ]
  }
}
