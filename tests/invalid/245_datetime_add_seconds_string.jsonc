// datetimeAddSeconds with a string amount
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "datetimeAddSeconds",
        "type": { "name": "datetime" },
        "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "right": { "type": { "name": "string" }, "value": "60" }
      }
    }
  ]
}
