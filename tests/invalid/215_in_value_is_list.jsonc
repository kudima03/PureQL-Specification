// in whose value is itself a list parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "type": { "name": "boolean" },
    "value": { "param_name": "a", "type": { "name": "stringList" } },
    "list": { "param_name": "b", "type": { "name": "stringList" } }
  }
}
