// average of an integer is decimal, declared integer
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "user_id", "type": { "name": "uuid" } }
    },
    {
      "alias": "c",
      "expression": {
        "operator": "average",
        "type": { "name": "integer" },
        "selector": { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ]
}
