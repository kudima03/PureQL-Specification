// Group key reference without a type
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [{ "alias": "user_id", "type": { "name": "uuid" }, "expression": { "key": 0 } }]
}
