// min over all rows inside a grouped query declared non-null: over all rows it is nullable, the default over the group is not
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "smallest",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "over": "all",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
