{
  "description": "not over an integer",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "not",
      "condition": { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
    }
  }
}
