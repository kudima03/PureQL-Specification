// A subquery with an aggregate in where
{
  "subqueries": [
    {
      "name": "recent",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "id",
            "type": { "name": "uuid" },
            "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
          }
        ],
        "where": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "operator": "count", "type": { "name": "integer" }, "over": "all" },
          "right": { "type": { "name": "integer" }, "value": 1 }
        }
      }
    }
  ],
  "from": { "subquery": "recent" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "recent", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
