// concat with a nullable operand, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "string" },
      "expression": {
        "operator": "concat",
        "type": { "name": "string", "nullable": true },
        "values": [
          { "source": "orders", "field": "name", "type": { "name": "string" } },
          { "source": "orders", "field": "coupon_code", "type": { "name": "string", "nullable": true } }
        ]
      }
    }
  ]
}
