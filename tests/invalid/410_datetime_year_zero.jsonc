// datetime literal in year 0000 (datetimes start at 0001-01-01T00:00:00Z)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
    "right": { "type": { "name": "datetime" }, "value": "0000-12-31T23:59:59Z" }
  }
}
