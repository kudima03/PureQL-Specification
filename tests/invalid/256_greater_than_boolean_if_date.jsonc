// greaterThan between a boolean if and a date
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": {
      "operator": "if",
      "type": { "name": "boolean" },
      "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
      "then": { "type": { "name": "boolean" }, "value": true },
      "else": { "type": { "name": "boolean" }, "value": false }
    },
    "right": { "type": { "name": "date" }, "value": "2024-01-01" }
  }
}
