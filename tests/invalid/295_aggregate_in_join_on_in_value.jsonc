// Aggregate as the value of an in inside join.on
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "joins": [
    {
      "type": "inner",
      "entity": "users",
      "on": {
        "operator": "in",
        "value": { "operator": "count", "over": "all" },
        "list": { "param_name": "sizes", "type": { "name": "integerList" } }
      }
    }
  ]
}
