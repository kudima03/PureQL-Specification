// sum over a date selector
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "over": "all",
        "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
