// Aggregate hidden in an if.condition inside a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": {
        "operator": "if",
        "type": { "name": "string" },
        "condition": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "right": {
            "operator": "average",
            "type": { "name": "decimal", "nullable": true },
            "over": "all",
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        },
        "then": { "type": { "name": "string" }, "value": "big" },
        "else": { "type": { "name": "string" }, "value": "small" }
      }
    }
  ],
  "select": [
    {
      "alias": "bucket",
      "expression": { "key": 0, "type": { "name": "string" } }
    }
  ]
}
