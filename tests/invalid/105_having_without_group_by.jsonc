// having without groupBy
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "operator": "count", "type": { "name": "integer" } },
    "right": { "type": { "name": "integer" }, "value": 1 }
  }
}
