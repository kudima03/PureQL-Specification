// integer? field in a non-null decimal column (widening keeps the null)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "source": "orders",
        "field": "bonus_points",
        "type": { "name": "integer", "nullable": true }
      }
    }
  ]
}
