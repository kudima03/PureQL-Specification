// coalesce of nullable booleans only, inside and.conditions
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      {
        "operator": "coalesce",
        "type": { "name": "boolean", "nullable": true },
        "values": [
          { "source": "orders", "field": "is_verified", "type": { "name": "boolean", "nullable": true } },
          { "type": { "name": "boolean", "nullable": true }, "value": null }
        ]
      }
    ]
  }
}
