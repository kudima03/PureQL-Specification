// Aggregate with arg instead of over / selector
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "sum",
        "arg": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
