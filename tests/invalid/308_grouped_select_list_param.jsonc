// List parameter as a grouped select column
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": 0, "type": { "name": "uuid" } }
    },
    {
      "alias": "c",
      "expression": { "param_name": "statuses", "type": { "name": "stringList" } }
    }
  ]
}
