// round of a nullable decimal, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "round",
        "type": { "name": "integer", "nullable": true },
        "value": { "source": "orders", "field": "discount", "type": { "name": "decimal", "nullable": true } }
      }
    }
  ]
}
