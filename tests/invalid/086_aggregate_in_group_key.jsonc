// Aggregate as a groupBy key
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "operator": "count", "type": { "name": "integer" }, "over": "all" }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": 0, "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" }, "over": "group" }
    }
  ]
}
