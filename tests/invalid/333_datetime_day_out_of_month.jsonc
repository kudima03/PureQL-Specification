// datetime literal on 2024-02-30
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "greaterThan",
    "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
    "right": { "type": { "name": "datetime" }, "value": "2024-02-30T00:00:00Z" }
  }
}
