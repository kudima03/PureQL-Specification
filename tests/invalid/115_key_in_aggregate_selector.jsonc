// Group key inside an aggregate selector (row context)
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "sum",
        "type": { "name": "integer" },
        "selector": { "key": "user_id", "type": { "name": "integer" } }
      }
    }
  ]
}
