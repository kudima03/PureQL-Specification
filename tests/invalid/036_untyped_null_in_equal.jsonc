// Untyped null literal (removed type null) as an equal operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "coupon_id", "type": { "name": "uuid", "nullable": true } },
    "right": { "type": { "name": "null" }, "value": null }
  }
}
