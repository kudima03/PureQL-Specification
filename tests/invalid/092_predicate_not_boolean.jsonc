// Aggregate predicate is a decimal
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "count",
        "over": "group",
        "predicate": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
