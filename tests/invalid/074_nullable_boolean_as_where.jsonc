// Nullable boolean field used directly as where
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": { "source": "orders", "field": "is_verified", "type": { "name": "boolean", "nullable": true } }
}
