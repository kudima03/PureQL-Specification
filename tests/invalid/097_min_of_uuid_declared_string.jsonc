// min keeps the selector type: of a uuid selector it is uuid, declared string
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } },
    {
      "alias": "m",
      "expression": {
        "operator": "min",
        "type": { "name": "string" },
        "selector": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ]
}
