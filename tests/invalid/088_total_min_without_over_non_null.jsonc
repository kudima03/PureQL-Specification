// min without over in a total query declared non-null: a total query returns its row even over no rows, so min is nullable
{
  "from": { "entity": "orders" },
  "aggregate": [
    {
      "alias": "smallest",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
