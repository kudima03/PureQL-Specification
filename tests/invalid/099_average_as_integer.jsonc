// average (always decimal) used where integer days are required
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "type": { "name": "date" },
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "left": {
          "operator": "max",
          "type": { "name": "date" },
          "over": "group",
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "right": {
          "operator": "average",
          "type": { "name": "decimal" },
          "over": "group",
          "selector": { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
        }
      }
    }
  ]
}
