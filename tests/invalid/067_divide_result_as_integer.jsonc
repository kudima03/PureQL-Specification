// divide (always decimal) used where integer days are required
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "date" },
      "expression": {
        "operator": "dateAddDays",
        "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
        "right": {
          "operator": "divide",
          "values": [
            { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
            { "type": { "name": "integer" }, "value": 2 }
          ]
        }
      }
    }
  ]
}
