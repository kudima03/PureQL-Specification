// dateAddDays over a nullable date, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "date" },
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date", "nullable": true },
        "left": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
