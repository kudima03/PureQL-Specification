// An operator whose type is a bare string instead of a type object
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "add",
        "type": "integer",
        "values": [
          { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
