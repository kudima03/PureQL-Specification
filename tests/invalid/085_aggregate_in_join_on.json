{
  "description": "Aggregate inside join.on (old ambiguity B1)",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "joins": [
      {
        "type": "inner",
        "entity": "users",
        "on": {
          "operator": "greaterThan",
          "left": { "source": "users", "field": "score", "type": { "name": "integer" } },
          "right": { "operator": "count", "over": "all" }
        }
      }
    ]
  }
}
