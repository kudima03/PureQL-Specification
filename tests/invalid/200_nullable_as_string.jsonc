// nullable written as the string "true"
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "coupon_code", "type": { "name": "string", "nullable": "true" } },
    "right": { "type": { "name": "string" }, "value": "SALE" }
  }
}
