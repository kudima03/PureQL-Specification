// equal over coalesce(integer?, string): coalesce operands of different families
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": {
      "operator": "coalesce",
      "values": [
        { "type": { "name": "integer", "nullable": true }, "value": null },
        { "source": "orders", "field": "name", "type": { "name": "string" } }
      ]
    },
    "right": { "type": { "name": "integer" }, "value": 1 }
  }
}
