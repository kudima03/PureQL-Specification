// orderBy on an aggregate over group in a query without groupBy
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [{ "expression": { "operator": "count", "type": { "name": "integer" }, "over": "group" } }]
}
