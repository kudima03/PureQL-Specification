// add with one operand
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [{ "source": "orders", "field": "quantity", "type": { "name": "integer" } }]
      }
    }
  ]
}
