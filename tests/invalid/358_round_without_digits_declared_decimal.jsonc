// round without digits is integer; declaring it decimal is wider than its type
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
