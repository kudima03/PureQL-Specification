{
  "description": "dateDiffDays(date, datetime)",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "c",
        "type": { "name": "integer" },
        "expression": {
          "operator": "dateDiffDays",
          "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
          "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      }
    ]
  }
}
