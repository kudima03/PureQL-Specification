// Subquery whose query is an array
{
  "subqueries": [
    {
      "name": "recent",
      "query": [
        {
          "from": { "entity": "orders" },
          "select": [
            {
              "alias": "id",
              "type": { "name": "uuid" },
              "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
            }
          ]
        }
      ]
    }
  ],
  "from": { "subquery": "recent" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "recent", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
