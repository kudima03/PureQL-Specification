// min keeps the selector type: of an integer selector it is integer, not decimal
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
      }
    }
  ]
}
