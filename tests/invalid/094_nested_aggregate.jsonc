// Aggregate inside an aggregate selector (old ambiguity B2)
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "sum",
        "over": "group",
        "selector": {
          "operator": "sum",
          "over": "group",
          "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      }
    }
  ]
}
