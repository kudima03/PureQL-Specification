// Group key referenced by index instead of by alias
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [{ "alias": "user_id", "expression": { "key": 0, "type": { "name": "uuid" } } }]
}
