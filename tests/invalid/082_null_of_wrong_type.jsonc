// equal(date field, null decimal?)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": { "type": { "name": "decimal", "nullable": true }, "value": null }
  }
}
