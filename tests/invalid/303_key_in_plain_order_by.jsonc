// Group key reference as an orderBy key of a query without groupBy
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [{ "expression": { "key": 0, "type": { "name": "uuid" } } }]
}
