// if with an unknown elseIf key
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "string" },
      "expression": {
        "operator": "if",
        "type": { "name": "string" },
        "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "then": { "type": { "name": "string" }, "value": "a" },
        "else": { "type": { "name": "string" }, "value": "b" },
        "elseIf": []
      }
    }
  ]
}
