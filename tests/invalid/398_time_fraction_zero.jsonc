// time literal with a zero fraction: 18:30:00.0 is written 18:30:00
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "equal",
    "type": { "name": "boolean" },
    "left": { "source": "orders", "field": "window_start", "type": { "name": "time" } },
    "right": { "type": { "name": "time" }, "value": "18:30:00.0" }
  }
}
