// in(average of a date, decimalList): average of a date is a date
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "value": {
          "operator": "average",
          "type": { "name": "date", "nullable": true },
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "list": { "param_name": "amounts", "type": { "name": "decimalList" } }
      }
    }
  ]
}
