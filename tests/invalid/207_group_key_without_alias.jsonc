// groupBy key without an alias: keys are referenced by alias
{
  "from": { "entity": "orders" },
  "groupBy": [{ "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
  "select": [{ "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } }]
}
