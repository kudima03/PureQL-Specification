// Aggregate hidden in round.digits inside where
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "greaterThan",
    "left": {
      "operator": "round",
      "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
      "digits": { "operator": "count", "over": "all" }
    },
    "right": { "type": { "name": "integer" }, "value": 1 }
  }
}
