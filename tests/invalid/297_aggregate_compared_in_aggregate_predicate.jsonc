// count filtered by comparing a field with an average over all rows (aggregate in a row context)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "right": {
            "operator": "average",
            "type": { "name": "decimal", "nullable": true },
            "over": "all",
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        }
      }
    }
  ]
}
