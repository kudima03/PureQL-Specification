// equal(date field, datetime field)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "order_date", "type": { "name": "date" } },
    "right": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
  }
}
