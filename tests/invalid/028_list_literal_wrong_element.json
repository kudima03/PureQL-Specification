{
  "description": "stringList literal containing a number",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "in",
      "value": { "source": "orders", "field": "status", "type": { "name": "string" } },
      "list": { "type": { "name": "stringList" }, "value": ["paid", 5] }
    }
  }
}
