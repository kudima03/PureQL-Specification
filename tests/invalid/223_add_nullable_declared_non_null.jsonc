// add with a nullable operand is nullable, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [
          { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
          { "source": "orders", "field": "bonus_points", "type": { "name": "integer", "nullable": true } }
        ]
      }
    }
  ]
}
