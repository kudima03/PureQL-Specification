// add.values given an object
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": {
          "a": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
          "b": { "type": { "name": "integer" }, "value": 1 }
        }
      }
    }
  ]
}
