// Column declared non-null string, expression is a nullable field
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "string" },
      "expression": {
        "source": "orders",
        "field": "coupon_code",
        "type": { "name": "string", "nullable": true }
      }
    }
  ]
}
