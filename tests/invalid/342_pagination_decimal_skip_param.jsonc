// pagination skip as a decimal parameter
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [{ "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }],
  "pagination": { "skip": { "param_name": "offset", "type": { "name": "decimal" } }, "take": 20 }
}
