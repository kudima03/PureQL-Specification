// dateAddDays applied to a datetime
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateAddDays",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
