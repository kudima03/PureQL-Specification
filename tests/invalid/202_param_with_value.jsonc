// Parameter carrying a default value
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": { "param_name": "only_paid", "type": { "name": "boolean" }, "value": true }
}
