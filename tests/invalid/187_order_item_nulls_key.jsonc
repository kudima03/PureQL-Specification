// orderBy item with an unknown nulls key (null ordering is fixed)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [
    { "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }, "nulls": "last" }
  ]
}
