// A subquery declaring its own subqueries (only the main query may)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "subqueries": [
    {
      "name": "a",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "id",
            "type": { "name": "uuid" },
            "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
          }
        ],
        "subqueries": [
          {
            "name": "b",
            "query": {
              "from": { "entity": "orders" },
              "select": [
                {
                  "alias": "id",
                  "type": { "name": "uuid" },
                  "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
