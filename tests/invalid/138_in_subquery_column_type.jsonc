// in(uuid field, string column of a subquery)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "in",
    "value": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
    "list": { "subquery": "vip_users", "field": "id", "type": { "name": "string" } }
  }
}
