{
  "description": "Nullable boolean inside not",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "not",
      "condition": {
        "source": "orders",
        "field": "is_verified",
        "type": { "name": "boolean", "nullable": true }
      }
    }
  }
}
