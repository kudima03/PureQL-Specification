// floor over a string
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "floor",
        "type": { "name": "integer" },
        "value": { "source": "orders", "field": "name", "type": { "name": "string" } }
      }
    }
  ]
}
