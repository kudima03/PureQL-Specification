// Column declared non-null, but min over all rows is nullable
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "min",
        "type": { "name": "decimal", "nullable": true },
        "over": "all",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ]
}
