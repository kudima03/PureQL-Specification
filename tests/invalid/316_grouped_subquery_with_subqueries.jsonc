// A grouped subquery declaring its own subqueries (only the main query may)
{
  "subqueries": [
    {
      "name": "recent",
      "query": {
        "from": { "entity": "orders" },
        "groupBy": [
          {
            "alias": "user_id",
            "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [
          {
            "alias": "user_id",
            "expression": { "key": "user_id", "type": { "name": "uuid" } }
          }
        ],
        "subqueries": [
          {
            "name": "inner",
            "query": {
              "from": { "entity": "orders" },
              "select": [
                {
                  "alias": "id",
                  "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "from": { "subquery": "recent" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "recent", "field": "id", "type": { "name": "uuid" } }
    }
  ]
}
