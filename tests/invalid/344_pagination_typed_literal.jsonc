// pagination take as a typed literal instead of a number
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "orderBy": [{ "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }],
  "pagination": { "skip": 0, "take": { "type": { "name": "integer" }, "value": 20 } }
}
