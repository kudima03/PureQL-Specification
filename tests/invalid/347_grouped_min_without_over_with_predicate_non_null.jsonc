// min without over in a grouped query, filtered by a predicate, declared non-null: no row of a group may match
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "smallest_paid",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "min",
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    }
  ]
}
