// round with digits is decimal, declared integer
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "round",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
