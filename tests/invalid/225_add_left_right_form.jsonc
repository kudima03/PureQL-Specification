// add written with left / right instead of values
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "left": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
