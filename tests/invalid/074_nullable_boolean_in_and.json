{
  "description": "Nullable boolean inside and.conditions",
  "query": {
    "from": { "entity": "orders" },
    "select": [
      {
        "alias": "id",
        "type": { "name": "uuid" },
        "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
      }
    ],
    "where": {
      "operator": "and",
      "conditions": [
        {
          "operator": "equal",
          "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "right": { "type": { "name": "string" }, "value": "paid" }
        },
        { "source": "orders", "field": "is_verified", "type": { "name": "boolean", "nullable": true } }
      ]
    }
  }
}
