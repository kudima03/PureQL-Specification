// Grouped orderBy on a count whose predicate uses an aggregate
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    { "alias": "user_id", "expression": { "key": "user_id", "type": { "name": "uuid" } } }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "right": {
            "operator": "average",
            "type": { "name": "decimal", "nullable": true },
            "over": "all",
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        }
      }
    }
  ]
}
