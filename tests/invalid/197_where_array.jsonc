// where is an array of conditions (use and)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": [{ "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }]
}
