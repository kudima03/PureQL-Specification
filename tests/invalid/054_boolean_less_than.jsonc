// Range comparison on boolean
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "lessThan",
    "left": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
    "right": { "type": { "name": "boolean" }, "value": true }
  }
}
