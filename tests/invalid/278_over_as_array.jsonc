// over given an array
{
  "from": { "entity": "orders" },
  "groupBy": [{ "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } } }],
  "select": [
    {
      "alias": "c",
      "expression": { "operator": "count", "type": { "name": "integer" }, "over": ["all"] }
    }
  ]
}
