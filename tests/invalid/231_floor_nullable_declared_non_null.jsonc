// floor of a nullable decimal, declared non-null
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "discount", "type": { "name": "decimal", "nullable": true } }
      }
    }
  ]
}
