// all without a predicate
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": "user_id", "type": { "name": "uuid" } }
    },
    {
      "alias": "c",
      "expression": { "operator": "all", "type": { "name": "boolean" } }
    }
  ]
}
