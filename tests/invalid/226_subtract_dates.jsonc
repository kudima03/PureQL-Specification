// subtract over two dates (use dateDiffDays)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "integer" },
      "expression": {
        "operator": "subtract",
        "values": [
          { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
          { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        ]
      }
    }
  ]
}
