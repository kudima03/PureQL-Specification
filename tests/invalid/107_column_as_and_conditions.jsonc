// and.conditions given a row predicate instead of an array (old hole A1)
{
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": 0, "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    }
  ],
  "having": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": {
      "operator": "equal",
      "type": { "name": "boolean" },
      "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
      "right": { "type": { "name": "string" }, "value": "paid" }
    }
  }
}
