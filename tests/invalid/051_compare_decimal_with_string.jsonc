// greaterThan(decimal field, string literal)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "greaterThan",
    "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
    "right": { "type": { "name": "string" }, "value": "100" }
  }
}
