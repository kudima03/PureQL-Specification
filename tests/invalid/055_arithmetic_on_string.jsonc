// add(string field, integer)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "add",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "name", "type": { "name": "string" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
