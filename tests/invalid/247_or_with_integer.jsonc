// or with an integer among its conditions
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "or",
    "conditions": [
      { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
      { "type": { "name": "integer" }, "value": 1 }
    ]
  }
}
