// List parameter used as an equal operand instead of via `in` (old hole A4)
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
    "right": { "param_name": "statuses", "type": { "name": "stringList" } }
  }
}
