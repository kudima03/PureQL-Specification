// add of two integers is integer; declaring it decimal is wider than its type, even in a decimal column
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "type": { "name": "decimal" },
      "expression": {
        "operator": "add",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
          { "type": { "name": "integer" }, "value": 1 }
        ]
      }
    }
  ]
}
