// or with a single condition, which would be the condition itself
{
  "from": { "entity": "orders" },
  "select": [
    { "alias": "id", "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } } }
  ],
  "where": {
    "operator": "or",
    "type": { "name": "boolean" },
    "conditions": [{ "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }]
  }
}
