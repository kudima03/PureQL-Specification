// dateDiffDays is integer, declared date
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "c",
      "expression": {
        "operator": "dateDiffDays",
        "type": { "name": "date" },
        "left": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
        "right": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    }
  ]
}
