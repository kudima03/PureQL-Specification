// Users whose first order came within 7 days of signing up.
// A grouped subquery finds each user's first order (min over a group of a non-null selector is non-null), the main
// query joins it and compares datetimeDiffSeconds with a week written as multiply(7, 86400).
{
  "subqueries": [
    {
      "name": "first_orders",
      "query": {
        "from": { "entity": "orders" },
        "groupBy": [
          {
            "alias": "user_id",
            "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
          }
        ],
        "select": [
          {
            "alias": "user_id",
            "expression": { "key": "user_id", "type": { "name": "uuid" } }
          },
          {
            "alias": "first_order_at",
            "expression": {
              "operator": "min",
              "type": { "name": "datetime" },
              "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
            }
          }
        ]
      }
    }
  ],
  "from": { "entity": "users" },
  "joins": [
    {
      "kind": "inner",
      "subquery": "first_orders",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "first_orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "lessThanOrEqual",
    "type": { "name": "boolean" },
    "left": {
      "operator": "datetimeDiffSeconds",
      "type": { "name": "decimal" },
      "left": { "source": "first_orders", "field": "first_order_at", "type": { "name": "datetime" } },
      "right": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
    },
    "right": {
      "operator": "multiply",
      "type": { "name": "integer" },
      "values": [
        { "type": { "name": "integer" }, "value": 7 },
        { "type": { "name": "integer" }, "value": 86400 }
      ]
    }
  },
  "select": [
    {
      "alias": "email",
      "expression": { "source": "users", "field": "email", "type": { "name": "string" } }
    },
    {
      "alias": "first_order_at",
      "expression": { "source": "first_orders", "field": "first_order_at", "type": { "name": "datetime" } }
    },
    {
      "alias": "hours_to_first_order",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": {
          "operator": "divide",
          "type": { "name": "decimal" },
          "values": [
            {
              "operator": "datetimeDiffSeconds",
              "type": { "name": "decimal" },
              "left": { "source": "first_orders", "field": "first_order_at", "type": { "name": "datetime" } },
              "right": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
            },
            { "type": { "name": "integer" }, "value": 3600 }
          ]
        },
        "digits": { "type": { "name": "integer" }, "value": 1 }
      }
    }
  ]
}
