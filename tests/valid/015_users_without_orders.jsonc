// Users who never placed an order: an anti-join through a left join.
// In its own on, orders.user_id keeps its stored non-null type; after the left join every orders field is nullable,
// so orders.id is declared uuid? in where and compared with a typed null.
{
  "from": { "entity": "users" },
  "joins": [
    {
      "type": "left",
      "entity": "orders",
      "on": {
        "operator": "equal",
        "left": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "right": { "source": "users", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "where": {
    "operator": "equal",
    "left": { "source": "orders", "field": "id", "type": { "name": "uuid", "nullable": true } },
    "right": { "type": { "name": "uuid", "nullable": true }, "value": null }
  },
  "select": [
    {
      "alias": "email",
      "type": { "name": "string" },
      "expression": { "source": "users", "field": "email", "type": { "name": "string" } }
    },
    {
      "alias": "signed_up_at",
      "type": { "name": "datetime" },
      "expression": { "source": "users", "field": "created_at", "type": { "name": "datetime" } }
    }
  ],
  "orderBy": [
    {
      "expression": { "source": "users", "field": "created_at", "type": { "name": "datetime" } },
      "direction": "asc"
    }
  ]
}
