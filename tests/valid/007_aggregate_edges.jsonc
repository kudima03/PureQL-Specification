// Aggregates over all rows at their edges: count with and without a predicate, sum of a nullable
// selector is non-null, sum of a literal, average of a datetime (nullable), all over all rows, a predicate on count,
// an if whose condition and branch mix an aggregate with a field (broadcast).
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "count_all",
      "expression": { "operator": "count", "type": { "name": "integer" }, "over": "all" }
    },
    {
      "alias": "count_paid",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "over": "all",
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    },
    {
      "alias": "points",
      "expression": {
        "operator": "sum",
        "type": { "name": "integer" },
        "over": "all",
        "selector": {
          "source": "orders",
          "field": "bonus_points",
          "type": { "name": "integer", "nullable": true }
        }
      }
    },
    {
      "alias": "rows",
      "expression": {
        "operator": "sum",
        "type": { "name": "integer" },
        "over": "all",
        "selector": { "type": { "name": "integer" }, "value": 1 }
      }
    },
    {
      "alias": "mean_time",
      "expression": {
        "operator": "average",
        "type": { "name": "datetime", "nullable": true },
        "over": "all",
        "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
      }
    },
    {
      "alias": "all_paid",
      "expression": {
        "operator": "all",
        "type": { "name": "boolean" },
        "over": "all",
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    },
    {
      "alias": "total_if_any",
      "expression": {
        "operator": "if",
        "type": { "name": "decimal" },
        "condition": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "operator": "count", "type": { "name": "integer" }, "over": "all" },
          "right": { "type": { "name": "integer" }, "value": 0 }
        },
        "then": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "else": { "type": { "name": "integer" }, "value": 0 }
      }
    }
  ]
}
