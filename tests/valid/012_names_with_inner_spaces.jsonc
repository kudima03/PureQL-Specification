// Names may contain inner spaces and non-ASCII letters: an entity, alias, parameter, field and column alias.
{
  "from": { "entity": "order items", "alias": "позиции" },
  "where": { "param": "min qty", "type": { "name": "boolean" } },
  "select": [
    {
      "alias": "line total",
      "expression": { "source": "позиции", "field": "unit price", "type": { "name": "decimal" } }
    }
  ]
}
