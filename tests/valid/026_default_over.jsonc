// over can be left out: an aggregate runs over the group in a grouped query and over all rows otherwise.
// In the subquery (plain) count and min run over all rows, so min is nullable. In the main (grouped) query count, sum,
// min and average run over each group, so min and average are non-null; over is written only for the total over
// all rows that the share divides by.
{
  "subqueries": [
    {
      "name": "overview",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "orders",
            "expression": { "operator": "count", "type": { "name": "integer" } }
          },
          {
            "alias": "smallest",
            "expression": {
              "operator": "min",
              "type": { "name": "decimal", "nullable": true },
              "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
            }
          }
        ]
      }
    }
  ],
  "from": { "entity": "orders" },
  "groupBy": [
    {
      "alias": "user_id",
      "expression": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
    }
  ],
  "having": {
    "operator": "greaterThan",
    "type": { "name": "boolean" },
    "left": { "operator": "count", "type": { "name": "integer" } },
    "right": { "type": { "name": "integer" }, "value": 1 }
  },
  "select": [
    {
      "alias": "user_id",
      "expression": { "key": 0, "type": { "name": "uuid" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    },
    {
      "alias": "smallest",
      "expression": {
        "operator": "min",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "average",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    },
    {
      "alias": "share_of_revenue",
      "expression": {
        "operator": "divide",
        "type": { "name": "decimal" },
        "values": [
          {
            "operator": "sum",
            "type": { "name": "decimal" },
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          },
          {
            "operator": "sum",
            "type": { "name": "decimal" },
            "over": "all",
            "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
          }
        ]
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      },
      "direction": "desc"
    }
  ]
}
