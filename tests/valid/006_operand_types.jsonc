// Operands of equal / in / comparisons and orderBy keys that are operators (if, coalesce, aggregates) over typed nulls,
// integer next to decimal, fixed-type operators (round, floor, dateDiffDays, count) and aggregates over all rows: the
// family is read from the type each operator declares.
{
  "subqueries": [
    {
      "name": "codes",
      "query": {
        "from": { "entity": "orders" },
        "select": [
          {
            "alias": "code",
            "expression": {
              "source": "orders",
              "field": "coupon_code",
              "type": { "name": "string", "nullable": true }
            }
          }
        ]
      }
    }
  ],
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "a",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "coalesce",
          "type": { "name": "decimal" },
          "values": [
            {
              "operator": "if",
              "type": { "name": "integer", "nullable": true },
              "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
              "then": {
                "operator": "coalesce",
                "type": { "name": "integer", "nullable": true },
                "values": [
                  { "type": { "name": "integer", "nullable": true }, "value": null },
                  { "type": { "name": "integer", "nullable": true }, "value": null }
                ]
              },
              "else": { "type": { "name": "integer", "nullable": true }, "value": null }
            },
            { "type": { "name": "decimal" }, "value": 2.5 }
          ]
        },
        "right": { "type": { "name": "integer" }, "value": 1 }
      }
    },
    {
      "alias": "b",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "if",
          "type": { "name": "decimal", "nullable": true },
          "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
          "then": { "type": { "name": "integer", "nullable": true }, "value": null },
          "else": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        },
        "right": { "type": { "name": "decimal" }, "value": 1 }
      }
    },
    {
      "alias": "c",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "round",
          "type": { "name": "integer" },
          "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        },
        "right": {
          "operator": "floor",
          "type": { "name": "integer" },
          "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        }
      }
    },
    {
      "alias": "d",
      "expression": {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "dateDiffDays",
          "type": { "name": "integer", "nullable": true },
          "left": {
            "source": "orders",
            "field": "shipped_date",
            "type": { "name": "date", "nullable": true }
          },
          "right": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "right": { "type": { "name": "decimal" }, "value": 1.5 }
      }
    },
    {
      "alias": "e",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "operator": "count", "type": { "name": "integer" } },
        "right": { "type": { "name": "decimal" }, "value": 1.5 }
      }
    },
    {
      "alias": "f",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": {
          "operator": "min",
          "type": { "name": "date" },
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "right": { "type": { "name": "date" }, "value": "2024-01-01" }
      }
    },
    {
      "alias": "g",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "value": {
          "operator": "average",
          "type": { "name": "date" },
          "selector": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
        },
        "list": { "param_name": "dates", "type": { "name": "dateList" } }
      }
    },
    {
      "alias": "h",
      "expression": {
        "operator": "in",
        "type": { "name": "boolean" },
        "value": {
          "operator": "concat",
          "type": { "name": "string" },
          "values": [
            { "type": { "name": "string" }, "value": "#" },
            { "source": "orders", "field": "name", "type": { "name": "string" } }
          ]
        },
        "list": { "subquery": "codes", "field": "code", "type": { "name": "string", "nullable": true } }
      }
    },
    {
      "alias": "i",
      "expression": {
        "operator": "notEqual",
        "type": { "name": "boolean" },
        "left": {
          "operator": "average",
          "type": { "name": "time" },
          "selector": { "source": "orders", "field": "window_start", "type": { "name": "time" } }
        },
        "right": {
          "operator": "timeAddSeconds",
          "type": { "name": "time" },
          "left": { "source": "orders", "field": "window_start", "type": { "name": "time" } },
          "right": {
            "operator": "divide",
            "type": { "name": "decimal" },
            "values": [
              { "type": { "name": "integer" }, "value": 1 },
              { "type": { "name": "integer" }, "value": 2 }
            ]
          }
        }
      }
    },
    {
      "alias": "j",
      "expression": {
        "operator": "lessThan",
        "type": { "name": "boolean" },
        "left": {
          "operator": "datetimeAddSeconds",
          "type": { "name": "datetime" },
          "left": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
          "right": { "type": { "name": "integer" }, "value": 60 }
        },
        "right": {
          "operator": "max",
          "type": { "name": "datetime" },
          "selector": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } }
        }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "if",
        "type": { "name": "string", "nullable": true },
        "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "then": { "type": { "name": "string", "nullable": true }, "value": null },
        "else": { "source": "orders", "field": "name", "type": { "name": "string" } }
      }
    },
    {
      "expression": {
        "operator": "coalesce",
        "type": { "name": "uuid" },
        "values": [
          { "type": { "name": "uuid", "nullable": true }, "value": null },
          { "source": "orders", "field": "id", "type": { "name": "uuid" } }
        ]
      }
    },
    {
      "expression": {
        "operator": "if",
        "type": { "name": "decimal" },
        "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "then": {
          "operator": "round",
          "type": { "name": "decimal" },
          "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "digits": { "type": { "name": "integer" }, "value": 1 }
        },
        "else": { "type": { "name": "integer" }, "value": 0 }
      },
      "direction": "desc"
    }
  ]
}
