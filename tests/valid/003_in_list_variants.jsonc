// in over every kind of list: an empty literal, booleanList, integer operand against decimalList and decimal operand
// against integerList (both through integer -> decimal), a typed null operand, and a nullable subquery column.
{
  "subqueries": [
    {
      "name": "referrers",
      "query": {
        "from": { "entity": "users" },
        "select": [
          {
            "alias": "referrer_id",
            "expression": {
              "source": "users",
              "field": "referrer_id",
              "type": { "name": "uuid", "nullable": true }
            }
          }
        ]
      }
    }
  ],
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      {
        "operator": "not",
        "type": { "name": "boolean" },
        "condition": {
          "operator": "in",
          "type": { "name": "boolean" },
          "operand": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "list": { "type": { "name": "stringList" }, "value": [] }
        }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "list": { "type": { "name": "booleanList" }, "value": [true] }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
        "list": { "type": { "name": "decimalList" }, "value": ["1.5", "2"] }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "list": { "param": "totals", "type": { "name": "integerList" } }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "type": { "name": "string", "nullable": true }, "value": null },
        "list": { "param": "statuses", "type": { "name": "stringList" } }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "list": {
          "subquery": "referrers",
          "field": "referrer_id",
          "type": { "name": "uuid", "nullable": true }
        }
      },
      {
        "operator": "in",
        "type": { "name": "boolean" },
        "operand": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "list": {
          "type": { "name": "datetimeList" },
          "value": ["2024-01-01T00:00:00Z", "2024-01-01T03:00:00+03:00"]
        }
      }
    ]
  }
}
