// in over every kind of list: an empty literal, booleanList, integer value against decimalList and decimal value
// against integerList (both through integer -> decimal), a typed null value, and a nullable subquery column.
{
  "from": { "entity": "orders" },
  "select": [
    {
      "alias": "id",
      "type": { "name": "uuid" },
      "expression": { "source": "orders", "field": "id", "type": { "name": "uuid" } }
    }
  ],
  "where": {
    "operator": "and",
    "conditions": [
      {
        "operator": "not",
        "condition": {
          "operator": "in",
          "value": { "source": "orders", "field": "status", "type": { "name": "string" } },
          "list": { "type": { "name": "stringList" }, "value": [] }
        }
      },
      {
        "operator": "in",
        "value": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "list": { "type": { "name": "booleanList" }, "value": [true] }
      },
      {
        "operator": "in",
        "value": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
        "list": { "type": { "name": "decimalList" }, "value": [1.5, 2] }
      },
      {
        "operator": "in",
        "value": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "list": { "param_name": "totals", "type": { "name": "integerList" } }
      },
      {
        "operator": "in",
        "value": { "type": { "name": "string", "nullable": true }, "value": null },
        "list": { "param_name": "statuses", "type": { "name": "stringList" } }
      },
      {
        "operator": "in",
        "value": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } },
        "list": {
          "subquery": "referrers",
          "field": "referrer_id",
          "type": { "name": "uuid", "nullable": true }
        }
      },
      {
        "operator": "in",
        "value": { "source": "orders", "field": "ordered_at", "type": { "name": "datetime" } },
        "list": {
          "type": { "name": "datetimeList" },
          "value": ["2024-01-01T00:00:00Z", "2024-01-01T03:00:00+03:00"]
        }
      }
    ]
  }
}
