// Operator typing at its edges: floor of an integer, round with negative and computed digits, dateDiffDays of a nullable
// date, an integer number of seconds, three-operand add, equal as a column,
// comparisons between typed nulls and across integer / decimal, if over uuid, coalesce with the non-null operand last,
// coalesce(integer?, decimal) as decimal, a nullable integer field and a boolean expression as columns.
{
  "from": { "entity": "orders" },
  "where": {
    "operator": "and",
    "type": { "name": "boolean" },
    "conditions": [
      { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
      {
        "operator": "coalesce",
        "type": { "name": "boolean" },
        "values": [
          { "source": "orders", "field": "is_verified", "type": { "name": "boolean", "nullable": true } },
          { "type": { "name": "boolean" }, "value": false }
        ]
      },
      {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "type": { "name": "string", "nullable": true }, "value": null },
        "right": { "type": { "name": "string", "nullable": true }, "value": null }
      },
      {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "type": { "name": "integer", "nullable": true }, "value": null },
        "right": { "type": { "name": "decimal", "nullable": true }, "value": null }
      },
      {
        "operator": "not",
        "type": { "name": "boolean" },
        "condition": {
          "operator": "greaterThan",
          "type": { "name": "boolean" },
          "left": { "type": { "name": "date", "nullable": true }, "value": null },
          "right": { "type": { "name": "date", "nullable": true }, "value": null }
        }
      },
      {
        "operator": "greaterThanOrEqual",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "right": { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
      },
      {
        "operator": "notEqual",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "quantity", "type": { "name": "integer" } },
        "right": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    ]
  },
  "select": [
    {
      "alias": "floor_of_integer",
      "expression": {
        "operator": "floor",
        "type": { "name": "integer" },
        "operand": { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
      }
    },
    {
      "alias": "hundreds",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": { "type": { "name": "integer" }, "value": -2 }
      }
    },
    {
      "alias": "computed_digits",
      "expression": {
        "operator": "round",
        "type": { "name": "decimal" },
        "operand": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
        "digits": {
          "operator": "add",
          "type": { "name": "integer" },
          "values": [
            { "param": "precision", "type": { "name": "integer" } },
            { "type": { "name": "integer" }, "value": 1 }
          ]
        }
      }
    },
    {
      "alias": "days_to_ship",
      "expression": {
        "operator": "dateDiffDays",
        "type": { "name": "integer", "nullable": true },
        "left": { "source": "orders", "field": "shipped_date", "type": { "name": "date", "nullable": true } },
        "right": { "source": "orders", "field": "order_date", "type": { "name": "date" } }
      }
    },
    {
      "alias": "one_minute_later",
      "expression": {
        "operator": "timeAddSeconds",
        "type": { "name": "time" },
        "left": { "source": "orders", "field": "window_start", "type": { "name": "time" } },
        "right": { "type": { "name": "integer" }, "value": 60 }
      }
    },
    {
      "alias": "sum3",
      "expression": {
        "operator": "add",
        "type": { "name": "integer" },
        "values": [
          { "type": { "name": "integer" }, "value": 1 },
          { "type": { "name": "integer" }, "value": 2 },
          { "source": "orders", "field": "quantity", "type": { "name": "integer" } }
        ]
      }
    },
    {
      "alias": "same_status",
      "expression": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "status", "type": { "name": "string" } },
        "right": { "type": { "name": "string" }, "value": "paid" }
      }
    },
    {
      "alias": "either_id",
      "expression": {
        "operator": "if",
        "type": { "name": "uuid" },
        "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
        "then": { "source": "orders", "field": "id", "type": { "name": "uuid" } },
        "else": { "source": "orders", "field": "user_id", "type": { "name": "uuid" } }
      }
    },
    {
      "alias": "code",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "string" },
        "values": [
          { "type": { "name": "string", "nullable": true }, "value": null },
          { "source": "orders", "field": "coupon_code", "type": { "name": "string", "nullable": true } },
          { "type": { "name": "string" }, "value": "none" }
        ]
      }
    },
    {
      "alias": "points_or_total",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "decimal" },
        "values": [
          { "source": "orders", "field": "bonus_points", "type": { "name": "integer", "nullable": true } },
          { "source": "orders", "field": "total", "type": { "name": "decimal" } }
        ]
      }
    },
    {
      "alias": "bonus_points_value",
      "expression": {
        "source": "orders",
        "field": "bonus_points",
        "type": { "name": "integer", "nullable": true }
      }
    },
    {
      "alias": "paid_and_verified",
      "expression": {
        "operator": "and",
        "type": { "name": "boolean" },
        "conditions": [
          { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
          {
            "operator": "equal",
            "type": { "name": "boolean" },
            "left": {
              "source": "orders",
              "field": "is_verified",
              "type": { "name": "boolean", "nullable": true }
            },
            "right": { "type": { "name": "boolean" }, "value": true }
          }
        ]
      }
    }
  ]
}
