// Revenue and paid rate per coupon, with orders without a coupon in their own "no coupon" group.
// The coupon code is nullable after the left join; coalesce in the group key makes the key non-null. Conditional
// aggregates: count with a predicate, and sum over if to add up only paid totals.
{
  "from": { "entity": "orders" },
  "joins": [
    {
      "kind": "left",
      "entity": "coupons",
      "on": {
        "operator": "equal",
        "type": { "name": "boolean" },
        "left": { "source": "orders", "field": "coupon_id", "type": { "name": "uuid", "nullable": true } },
        "right": { "source": "coupons", "field": "id", "type": { "name": "uuid" } }
      }
    }
  ],
  "groupBy": [
    {
      "alias": "coupon",
      "expression": {
        "operator": "coalesce",
        "type": { "name": "string" },
        "values": [
          { "source": "coupons", "field": "code", "type": { "name": "string", "nullable": true } },
          { "type": { "name": "string" }, "value": "no coupon" }
        ]
      }
    }
  ],
  "select": [
    {
      "alias": "coupon",
      "expression": { "key": 0, "type": { "name": "string" } }
    },
    {
      "alias": "orders",
      "expression": { "operator": "count", "type": { "name": "integer" } }
    },
    {
      "alias": "paid_orders",
      "expression": {
        "operator": "count",
        "type": { "name": "integer" },
        "predicate": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } }
      }
    },
    {
      "alias": "paid_revenue",
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": {
          "operator": "if",
          "type": { "name": "decimal" },
          "condition": { "source": "orders", "field": "is_paid", "type": { "name": "boolean" } },
          "then": { "source": "orders", "field": "total", "type": { "name": "decimal" } },
          "else": { "type": { "name": "integer" }, "value": 0 }
        }
      }
    },
    {
      "alias": "average_order",
      "expression": {
        "operator": "average",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      }
    }
  ],
  "orderBy": [
    {
      "expression": {
        "operator": "sum",
        "type": { "name": "decimal" },
        "selector": { "source": "orders", "field": "total", "type": { "name": "decimal" } }
      },
      "direction": "desc"
    }
  ]
}
